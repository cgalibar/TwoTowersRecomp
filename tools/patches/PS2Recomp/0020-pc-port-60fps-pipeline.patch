+            std::lock_guard<std::mutex> lock(m_mutex);
+        }
+        m_cv.notify_all();
+        if (m_thread.joinable())
+            m_thread.join();
+    }
+
+    void Vu1Runner::wait()
+    {
+        for (uint32_t spin = 0; m_state.load(std::memory_order_acquire) != 0u; ++spin)
+        {
+            relax();
+            if ((spin & 4095u) == 4095u)
+                std::this_thread::yield();
+        }
+    }
+
+    void Vu1Runner::post(Job job, void *owner, uint32_t kind, uint32_t a, uint32_t b, uint32_t c)
+    {
+        wait();
+        m_job = job;
+        m_owner = owner;
+        m_kind = kind;
+        m_a = a;
+        m_b = b;
+        m_c = c;
+        m_state.store(1u, std::memory_order_seq_cst);
+        if (m_sleeping.load(std::memory_order_seq_cst))
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_cv.notify_one();
+        }
+    }
+
+    void Vu1Runner::run()
+    {
+        // Part of the VIF1 unit: its GS packets go through the GIF worker and it never waits for VIF1.
+        t_onVif1Worker = true;
+        pinPipelineThread();
+        for (;;)
+        {
+            // Spin for a while (about a millisecond) before sleeping: programs come in quick succession.
+            for (uint32_t spin = 0; spin < 20000u && m_state.load(std::memory_order_acquire) == 0u &&
