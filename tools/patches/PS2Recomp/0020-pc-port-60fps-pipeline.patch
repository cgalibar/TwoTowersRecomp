+bool GSCpuBackend::PlanPresentation(const GSPresentationRequest &request, PresentationPlan &plan)
+{
+    static_assert(kPresentedWidth == kHostFrameWidth && kPresentedHeight == kHostFrameHeight);
+    plan = {};
+    const GSPmodeState pmode = decodePmode(request.pmode);
+    const GSSmode2State smode2 = decodeSMode2(request.smode2);
+    plan.fieldMode = smode2.interlaced && !smode2.frameMode;
+    plan.oddField = (request.vsyncTick & 1ull) != 0ull;
+    const GSFrameReg displayFrame1 = decodeDisplayFrame(request.dispfb1);
+    const GSFrameReg displayFrame2 = decodeDisplayFrame(request.dispfb2);
+    const GSDisplayReadOrigin origin1 = decodeDisplayReadOrigin(request.dispfb1);
+    const GSDisplayReadOrigin origin2 = decodeDisplayReadOrigin(request.dispfb2);
+    uint32_t width1 = 0u, height1 = 0u, width2 = 0u, height2 = 0u;
+    decodeDisplaySize(request.display1, width1, height1);
+    decodeDisplaySize(request.display2, width2, height2);
+    const bool valid1 = pmode.enableCrt1 && hasDisplaySetup(request.display1, displayFrame1);
+    const bool valid2 = pmode.enableCrt2 && hasDisplaySetup(request.display2, displayFrame2);
+    if (!valid1 && !valid2)
+        return true;
+
+    auto supported = [](uint32_t psm)
+    { return psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S; };
+    // copySource of PresentFromLocalMemory: false where CopyFrameToHostRgba fails; needsPixels where it would
+    // look for another buffer when this one is all black.
+    bool needsPixels = false;
+    auto source = [&](const GSFrameReg &displayFrame, const GSDisplayReadOrigin &origin, uint32_t width, uint32_t height,
+                      bool allowPreferred, bool preserveAlpha, PresentationSource &out, uint32_t &selectedFbp,
+                      bool &usedPreferred) -> bool
+    {
+        usedPreferred = false;
+        if (allowPreferred && request.hasPreferredSource && request.preferredDestFbp == displayFrame.fbp &&
+            (request.preferredSource.fbw != 0u || request.preferredSource.fbp != displayFrame.fbp) &&
+            supported(request.preferredSource.psm))
+        {
+            const GSFrameReg &frame = request.preferredSource;
+            out = {frame.psm, frame.fbp, frame.fbw ? frame.fbw : kHostFrameWidth / 64u, 0u, 0u, width, height, preserveAlpha};
+            selectedFbp = frame.fbp;
+            usedPreferred = true;
+            return true;
+        }
+        if (!supported(displayFrame.psm))
+            return false;
+        out = {displayFrame.psm, GSInternal::framePageBaseToBlock(displayFrame.fbp),
+               displayFrame.fbw ? displayFrame.fbw : kHostFrameWidth / 64u, origin.x, origin.y, width, height, preserveAlpha};
+        selectedFbp = displayFrame.fbp;
+        if (displayFrame.fbp == 0u)
+            needsPixels = true;
+        return true;
+    };
+
+    if (valid1 && valid2)
+    {
+        uint32_t selected1 = 0u, selected2 = 0u;
+        bool preferred1 = false, preferred2 = false;
+        if (source(displayFrame1, origin1, width1, height1, false, true, plan.crt1, selected1, preferred1) &&
+            source(displayFrame2, origin2, width2, height2, false, true, plan.crt2, selected2, preferred2))
+        {
+            if (needsPixels)
+                return false;
+            plan.empty = false;
+            plan.dual = true;
+            plan.width = std::max(width1, width2);
+            plan.height = std::max(height1, height2);
+            plan.mmod = pmode.mmod;
+            plan.amod = pmode.amod;
+            plan.slbg = pmode.slbg;
+            plan.alp = pmode.alp;
+            plan.bgcolor = static_cast<uint32_t>(request.bgcolor & 0xFFFFFFu);
+            plan.displayFbp = displayFrame1.fbp;
+            plan.sourceFbp = selected1;
+            return true;
+        }
+        needsPixels = false;
+    }
+
+    const GSFrameReg &displayFrame = valid1 ? displayFrame1 : displayFrame2;
+    const GSDisplayReadOrigin &origin = valid1 ? origin1 : origin2;
+    const uint32_t width = valid1 ? width1 : width2;
+    const uint32_t height = valid1 ? height1 : height2;
+    uint32_t selected = 0u;
+    bool usedPreferred = false;
+    if (!source(displayFrame, origin, width, height, true, false, plan.crt1, selected, usedPreferred))
+    {
+        plan = {};
+        return true;
+    }
+    if (needsPixels)
+        return false;
+    plan.empty = false;
+    plan.width = width;
+    plan.height = height;
+    plan.displayFbp = displayFrame.fbp;
+    plan.sourceFbp = selected;
+    plan.usedPreferred = usedPreferred;
+    return true;
+}
