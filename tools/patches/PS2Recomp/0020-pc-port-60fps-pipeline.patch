+// ---- presentation (GSCpuBackend::PresentFromLocalMemory, following a PresentationPlan) -----------------------
+// One thread per pixel of the 640x512 host frame. Params: 0 width, 1 height, 2 flags (1 dual, 2 MMOD, 4 AMOD,
+// 8 SLBG, 16 field mode, 32 odd field), 3 ALP, 4 BGCOLOR; then two sources of 8 words at 5 and 13: swizzle
+// tables, base, row stride, kind (1 = 32-bit, 2 = 24-bit, 3 = 16-bit) | preserve alpha << 8, origin x,
+// origin y, width, height.
+static const char *const kGpuPresentGlsl = R"GLSL(
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(std430, binding = 2) readonly buffer Params { uint params[]; };
+layout(std430, binding = 3) writeonly buffer Frame { uint frame[]; };
+const uint FRAME_WIDTH = 640u, FRAME_HEIGHT = 512u;
+
+// CopyFrameToHostRgba, one pixel.
+uint readSource(uint s, uint x, uint y)
+{
+    uint kind = params[s + 3u] & 0xFFu;
+    bool preserveAlpha = (params[s + 3u] & 0x100u) != 0u;
+    uint pixel = swAddress(params[s], params[s + 1u], params[s + 2u], params[s + 4u] + x, params[s + 5u] + y);
+    if (kind == 3u)
+    {
+        uint byteAddress = (pixel * 2u) & 0x3FFFFEu;
+        uint c = (vram[byteAddress >> 2u] >> ((byteAddress & 2u) * 8u)) & 0xFFFFu;
+        uint r = c & 31u, g = (c >> 5u) & 31u, b = (c >> 10u) & 31u;
+        uint a = preserveAlpha ? ((c & 0x8000u) != 0u ? 0x80u : 0u) : 255u;
+        return ((r << 3u) | (r >> 2u)) | (((g << 3u) | (g >> 2u)) << 8u) | (((b << 3u) | (b >> 2u)) << 16u) | (a << 24u);
+    }
+    uint c = vram[pixel & 0xFFFFFu];
+    uint a = (preserveAlpha && kind == 1u) ? (c >> 24u) : 255u;
+    return (c & 0x00FFFFFFu) | (a << 24u);
+}
+
+// blendPresentationChannel: dst + (src - dst) * factor / 255, the division truncated toward zero.
+uint blendChannel(uint src, uint dst, int factor)
+{
+    int t = (int(src) - int(dst)) * factor;
+    int q = t >= 0 ? t / 255 : -((-t) / 255);
+    return uint(clamp(int(dst) + q, 0, 255));
+}
+
+void main()
+{
+    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
+    if (x >= FRAME_WIDTH || y >= FRAME_HEIGHT)
+        return;
+    uint width = params[0], height = params[1], flags = params[2];
+    uint color = 0u;
+    if (x < width && y < height)
+    {
+        uint row = y;
+        if ((flags & 16u) != 0u)
+        {
+            row = ((y >> 1u) << 1u) + ((flags & 32u) != 0u ? 1u : 0u);
+            if (row >= height)
+                row = height - 1u;
+        }
+        if ((flags & 1u) == 0u)
+            color = (x < params[11u] && row < params[12u]) ? readSource(5u, x, row) : 0u;
+        else
+        {
+            uint dst = (params[4] & 0x00FFFFFFu) | ((params[3] & 0xFFu) << 24u);
+            if ((flags & 8u) == 0u && x < params[19u] && row < params[20u])
+                dst = readSource(13u, x, row);
+            if (x < params[11u] && row < params[12u])
+            {
+                uint src = readSource(5u, x, row);
+                int factor = (flags & 2u) != 0u ? int(params[3] & 0xFFu) : min(255, int(src >> 24u) * 2);
+                uint r = blendChannel(src & 0xFFu, dst & 0xFFu, factor);
+                uint g = blendChannel((src >> 8u) & 0xFFu, (dst >> 8u) & 0xFFu, factor);
+                uint b = blendChannel((src >> 16u) & 0xFFu, (dst >> 16u) & 0xFFu, factor);
+                dst = r | (g << 8u) | (b << 16u);
+            }
+            color = dst;
+        }
+        color = (color & 0x00FFFFFFu) | 0xFF000000u;
+    }
+    frame[y * FRAME_WIDTH + x] = color;
+}
+)GLSL";
