+    uint32_t params[32] = {};
+    params[0] = plan.width;
+    params[1] = plan.height;
+    params[2] = (plan.dual ? 1u : 0u) | (plan.mmod ? 2u : 0u) | (plan.amod ? 4u : 0u) | (plan.slbg ? 8u : 0u) |
