+    {
+        const GSSwizzle::Format &format = *GSSwizzle::Get(s.psm);
+        params[at] = m_layoutOffset[static_cast<size_t>(layoutIndex(s.psm))];
+        params[at + 1u] = GSSwizzle::Base(format, s.basePtr);
+        params[at + 2u] = GSSwizzle::RowStride(format, s.fbw);
+        const uint32_t kind = s.psm == GS_PSM_CT32 ? 1u : (s.psm == GS_PSM_CT24 ? 2u : 3u);
+        params[at + 3u] = kind | (s.preserveAlpha ? 0x100u : 0u);
+        params[at + 4u] = s.originX;
+        params[at + 5u] = s.originY;
+        params[at + 6u] = s.width;
+        params[at + 7u] = s.height;
+    };
+    source(5u, plan.crt1);
+    if (plan.dual)
+        source(13u, plan.crt2);
+    m_gpu->Upload(m_presentParams, 0, sizeof(params), params);
+    m_gpu->Barrier();
+    m_gpu->UseProgram(m_presentProgram);
+    m_gpu->BindStorage(0, m_vram);
+    m_gpu->BindStorage(1, m_swizzle);
+    m_gpu->BindStorage(2, m_presentParams);
+    m_gpu->BindStorage(3, m_presentFrame);
+    m_gpu->Dispatch(GSCpuBackend::kPresentedWidth / 16u, GSCpuBackend::kPresentedHeight / 16u);
+}
