+    Vu1Runner::Vu1Runner()
+    {
+        m_thread = std::thread([this]()
+                               { run(); });
+    }
+
+    Vu1Runner::~Vu1Runner()
+    {
+        wait();
+        m_stop.store(true, std::memory_order_seq_cst);
