+void *GSGpuContext::CreatePersistentBuffer(size_t bytes, uint32_t &buffer)
+{
+    buffer = 0;
+    static const auto storage = reinterpret_cast<BufferStorageFn>(glfwGetProcAddress("glBufferStorage"));
+    static const auto map = reinterpret_cast<MapBufferRangeFn>(glfwGetProcAddress("glMapBufferRange"));
+    if (!storage || !map)
+        return nullptr;
+    GLuint id = 0;
+    m_gl->GenBuffers(1, &id);
+    m_gl->BindBuffer(GL_SHADER_STORAGE_BUFFER, id);
+    const GLbitfield flags = GL_MAP_WRITE_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT;
+    storage(GL_SHADER_STORAGE_BUFFER, static_cast<GLsizeiptr>(bytes), nullptr, flags);
+    void *pointer = map(GL_SHADER_STORAGE_BUFFER, 0, static_cast<GLsizeiptr>(bytes), flags);
+    if (!pointer)
+    {
+        m_gl->DeleteBuffers(1, &id);
+        return nullptr;
+    }
+    buffer = id;
+    return pointer;
+}
