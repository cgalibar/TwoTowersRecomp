+
+void GSAsyncBackend::prepareRun()
+{
+    ps2x::pinPipelineThread();
+    uint64_t position = 0;
+    GSPrimitiveBatch batch{};
+    for (;;)
+    {
+        uint64_t queued = m_queued.load(std::memory_order_acquire);
+        for (uint32_t spin = 0u; queued == position && spin < kSpinIterations; ++spin)
+        {
+            cpuRelax();
+            queued = m_queued.load(std::memory_order_acquire);
+        }
+        if (queued == position)
+        {
+            m_prepareSleeping.store(true, std::memory_order_seq_cst);
+            if (m_queued.load(std::memory_order_seq_cst) == position)
+                m_queued.wait(position, std::memory_order_acquire);
+            m_prepareSleeping.store(false, std::memory_order_relaxed);
+            continue;
+        }
+        for (; position != queued; ++position)
+        {
+            const size_t slot = static_cast<size_t>(position % kCapacity);
+            const Command &command = m_ring[slot];
+            if (command.type == CommandType::SetState)
+                std::memcpy(&batch.state, &m_extra[slot].state, sizeof(GSDrawState));
+            else if (command.type == CommandType::Submit)
+            {
+                batch.vertexCount = command.vertexCount;
+                batch.vertices = command.vertices;
+                m_inner->PrepareSubmit(batch, m_prepared + slot * m_preparedStride);
+            }
+            else if (command.type == CommandType::Stop)
+            {
+                publishPrepared(position + 1u);
+                return;
+            }
+            if (((position + 1u) & 31u) == 0u)
+                publishPrepared(position + 1u);
+        }
+        publishPrepared(position);
+    }
+}
