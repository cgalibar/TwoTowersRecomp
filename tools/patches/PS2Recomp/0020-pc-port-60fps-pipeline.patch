+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_sleeping.store(true, std::memory_order_seq_cst);
+                m_cv.wait(lock, [this]()
+                          { return m_state.load(std::memory_order_seq_cst) != 0u || m_stop.load(std::memory_order_seq_cst); });
+                m_sleeping.store(false, std::memory_order_seq_cst);
+            }
+            if (m_state.load(std::memory_order_acquire) == 0u)
+            {
+                if (m_stop.load(std::memory_order_seq_cst))
+                    return;
+                continue;
+            }
+            try
+            {
+                m_job(m_owner, m_kind, m_a, m_b, m_c);
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, "[vu1-runner] %s\n", e.what());
+            }
+            m_state.store(0u, std::memory_order_release);
+        }
+    }
+
+    // PS2X_PIPE_STATS=1: once a second, how often VIF1 found the GIF queue full.
+    void pipeStatsFullGif()
+    {
+        static const bool on = std::getenv("PS2X_PIPE_STATS") != nullptr;
+        if (!on)
+            return;
+        static std::atomic<uint64_t> fulls{0};
+        static auto last = std::chrono::steady_clock::now();
+        ++fulls;
+        const auto now = std::chrono::steady_clock::now();
+        if (now - last >= std::chrono::seconds(1))
+        {
+            std::fprintf(stderr, "[pipe] GIF queue full %llu times\n", static_cast<unsigned long long>(fulls.exchange(0)));
+            last = now;
+        }
+    }
+
+    void pinPipelineThread()
+    {
+#if defined(_WIN32)
+        static const unsigned long long mask = []
+        {
+            const char *env = std::getenv("PS2X_PIPELINE_CPUS");
+            return env ? std::strtoull(env, nullptr, 16) : 0ull;
+        }();
+        if (mask != 0ull)
+            SetThreadAffinityMask(GetCurrentThread(), static_cast<DWORD_PTR>(mask));
+#endif
+    }
+
+    void setActiveGifWorker(GifWorker *worker)
+    {
+        g_activeGifWorker.store(worker, std::memory_order_release);
+    }
+
+    GifWorker *activeGifWorker()
+    {
+        return g_activeGifWorker.load(std::memory_order_acquire);
     }
 }
