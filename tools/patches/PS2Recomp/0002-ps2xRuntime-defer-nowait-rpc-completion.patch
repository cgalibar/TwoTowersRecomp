     m_semaphores.clear();
     m_eventFlags.clear();
     m_alarms.clear();
+    m_deferredInvocations.clear();
+    m_nextDeferredInvocationId = 1;
     m_intcHandlers.clear();
     m_dmacHandlers.clear();
     m_nextThreadId = kFirstThreadId;
@@ -1106,6 +1108,20 @@ void EeScheduler::queueInvocation(GuestInvocation invocation)
     m_checkpointPending.store(true, std::memory_order_release);
 }
 
+void EeScheduler::queueInvocationAfter(uint64_t delayCycles, GuestInvocation invocation)
+{
+    assertExecutor();
+    uint32_t id = m_nextDeferredInvocationId++;
+    if (id == 0u)
+    {
+        id = m_nextDeferredInvocationId++;
+    }
+    m_deferredInvocations.emplace(id, std::move(invocation));
+    scheduleEvent(m_eeCycle + delayCycles,
+                  std::chrono::steady_clock::now() + eeCyclesToHostDuration(delayCycles),
+                  EeEvent{EeEventType::DeferredInvocation, id, 0});
+}
+
 [[noreturn]] void EeScheduler::invokeCurrent(GuestInvocation invocation)
 {
     assertExecutor();
@@ -1931,6 +1947,18 @@ void EeScheduler::processEvent(const EeEvent &event)
         queueInvocation(std::move(invocation));
         break;
     }
+    case EeEventType::DeferredInvocation:
+    {
+        auto it = m_deferredInvocations.find(event.id);
+        if (it == m_deferredInvocations.end())
+        {
+            break;
+        }
+        GuestInvocation invocation = std::move(it->second);
+        m_deferredInvocations.erase(it);
+        queueInvocation(std::move(invocation));
+        break;
+    }
     }
 }
 
