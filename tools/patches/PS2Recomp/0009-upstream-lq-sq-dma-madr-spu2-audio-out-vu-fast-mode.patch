@@ -28,6 +28,147 @@
 #include <unordered_map>
 #include <sstream>
 
+namespace
+{
+    // SPU2 output to the host. The thread that runs the IOP pushes the mix into a ring and raylib's audio
+    // thread pulls it. When the game runs slower than real time the ring runs dry: the callback then plays
+    // silence and waits for kStartFrames again, so slow stretches sound choppy instead of crackling. The
+    // ring is capped at kMaxBufferedFrames so latency never builds up. PS2X_AUDIO=0 turns it off.
+    class SpuAudioOutput
+    {
+    public:
+        static SpuAudioOutput &instance()
+        {
+            static SpuAudioOutput output;
+            return output;
+        }
+
+        void push(const std::vector<int16_t> &interleaved)
+        {
+            if (m_dump && !interleaved.empty())
+                std::fwrite(interleaved.data(), sizeof(int16_t), interleaved.size() & ~size_t{1}, m_dump);
+            if (!m_enabled || interleaved.size() < 2u)
+                return;
+            if (!m_streamReady && !start())
+                return;
+
+            std::lock_guard<std::mutex> lock(m_mutex);
+            const size_t frames = interleaved.size() / 2u;
+            for (size_t i = 0; i < frames; ++i)
+            {
+                if (m_count == kRingFrames)
+                {
+                    m_read = (m_read + 1u) % kRingFrames;
+                    --m_count;
+                }
+                m_ring[m_write * 2u] = interleaved[i * 2u];
+                m_ring[m_write * 2u + 1u] = interleaved[i * 2u + 1u];
+                m_write = (m_write + 1u) % kRingFrames;
+                ++m_count;
+            }
+            if (m_count > kMaxBufferedFrames)
+            {
+                const size_t drop = m_count - kMaxBufferedFrames;
+                m_read = (m_read + drop) % kRingFrames;
+                m_count -= drop;
+            }
+        }
+
+        void stop()
+        {
+            if (!m_streamReady)
+                return;
+            StopAudioStream(m_stream);
+            UnloadAudioStream(m_stream);
+            m_streamReady = false;
+        }
+
+    private:
+        static constexpr uint32_t kSampleRate = 48000u;
+        static constexpr size_t kRingFrames = kSampleRate / 2u;          // 500 ms of storage
+        static constexpr size_t kMaxBufferedFrames = kSampleRate / 5u;   // 200 ms of latency at most
+        static constexpr size_t kStartFrames = kSampleRate / 25u;        // 40 ms before (re)starting
+
+        SpuAudioOutput()
+        {
+            const char *env = std::getenv("PS2X_AUDIO");
+            m_enabled = !(env && env[0] == '0');
+            m_ring.resize(kRingFrames * 2u);
+            // PS2X_AUDIO_DUMP=<file>: raw interleaved stereo s16le at 48 kHz, everything the SPU2 produced.
+            if (const char *dump = std::getenv("PS2X_AUDIO_DUMP"); dump && dump[0] != 0)
+                m_dump = std::fopen(dump, "wb");
+        }
+
+        ~SpuAudioOutput()
+        {
+            if (m_dump)
+                std::fclose(m_dump);
+        }
+
+        bool start()
+        {
+            if (!IsAudioDeviceReady())
+            {
+                m_enabled = false;
+                return false;
+            }
+            SetAudioStreamBufferSizeDefault(1024);
+            m_stream = LoadAudioStream(kSampleRate, 16, 2);
+            if (!IsAudioStreamValid(m_stream))
+            {
+                std::cerr << "[audio] could not open a 48 kHz stereo stream; SPU2 output disabled" << std::endl;
+                m_enabled = false;
+                return false;
+            }
+            SetAudioStreamCallback(m_stream, &SpuAudioOutput::callback);
+            PlayAudioStream(m_stream);
+            m_streamReady = true;
+            std::cout << "[audio] SPU2 output: 48 kHz stereo" << std::endl;
+            return true;
+        }
+
+        static void callback(void *buffer, unsigned int frames)
+        {
+            instance().fill(static_cast<int16_t *>(buffer), frames);
+        }
+
+        void fill(int16_t *out, unsigned int frames)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (m_priming && m_count < kStartFrames)
+            {
+                std::memset(out, 0, static_cast<size_t>(frames) * 2u * sizeof(int16_t));
+                return;
+            }
+            m_priming = false;
+            for (unsigned int i = 0; i < frames; ++i)
+            {
+                if (m_count == 0u)
+                {
+                    std::memset(out + i * 2u, 0, static_cast<size_t>(frames - i) * 2u * sizeof(int16_t));
+                    m_priming = true;
+                    return;
+                }
+                out[i * 2u] = m_ring[m_read * 2u];
+                out[i * 2u + 1u] = m_ring[m_read * 2u + 1u];
+                m_read = (m_read + 1u) % kRingFrames;
+                --m_count;
+            }
+        }
+
+        std::mutex m_mutex;
+        std::vector<int16_t> m_ring;
+        size_t m_read = 0u;
+        size_t m_write = 0u;
+        size_t m_count = 0u;
+        bool m_priming = true;
+        bool m_enabled = true;
+        bool m_streamReady = false;
+        AudioStream m_stream{};
+        FILE *m_dump = nullptr;
+    };
+}
