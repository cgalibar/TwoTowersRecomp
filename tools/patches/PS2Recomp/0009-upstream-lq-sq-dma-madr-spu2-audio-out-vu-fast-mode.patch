+namespace
+{
+    // PS2X_VU_STATS=1: once per second of host time, microprogram runs, VU cycles and instruction pairs
+    // executed by each unit.
+    struct VuRunStats
+    {
+        bool enabled = false;
+        std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+        uint64_t runs[2]{};
+        uint64_t cycles[2]{};
+        uint64_t pairs[2]{};
+        std::mutex mutex;
+    };
+
+    VuRunStats &vuRunStats()
+    {
+        static VuRunStats stats;
+        static const bool initialized = []
+        {
+            const char *env = std::getenv("PS2X_VU_STATS");
+            stats.enabled = env && env[0] == '1';
+            return true;
+        }();
+        (void)initialized;
+        return stats;
+    }
+
+    void recordVuRun(int unit, uint64_t cycles, uint64_t pairs)
+    {
+        VuRunStats &stats = vuRunStats();
+        if (!stats.enabled)
+            return;
+        std::lock_guard<std::mutex> lock(stats.mutex);
+        stats.runs[unit] += 1u;
+        stats.cycles[unit] += cycles;
+        stats.pairs[unit] += pairs;
+        const auto now = std::chrono::steady_clock::now();
+        const double seconds = std::chrono::duration<double>(now - stats.last).count();
+        if (seconds < 1.0)
+            return;
+        std::fprintf(stderr, "[vu-stats] %.1fs VU0 runs=%llu cycles=%llu pairs=%llu | VU1 runs=%llu cycles=%llu pairs=%llu\n",
+                     seconds,
+                     static_cast<unsigned long long>(stats.runs[0]), static_cast<unsigned long long>(stats.cycles[0]),
+                     static_cast<unsigned long long>(stats.pairs[0]),
+                     static_cast<unsigned long long>(stats.runs[1]), static_cast<unsigned long long>(stats.cycles[1]),
+                     static_cast<unsigned long long>(stats.pairs[1]));
+        stats.last = now;
+        stats.runs[0] = stats.runs[1] = 0u;
+        stats.cycles[0] = stats.cycles[1] = 0u;
