diff --git a/ps2xRuntime/src/lib/vu/ps2_x64_emitter.h b/ps2xRuntime/src/lib/vu/ps2_x64_emitter.h
new file mode 100644
index 0000000..939b9d1
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_x64_emitter.h
@@ -0,0 +1,359 @@
+#ifndef PS2_X64_EMITTER_H
+#define PS2_X64_EMITTER_H
+
+// Minimal x86-64 machine code emitter for the VU block compiler (ps2_vu_fast.cpp): only the instructions it
+// uses, with explicit register numbers (rax=0, rcx=1, rdx=2, rbx=3, rsp=4, rbp=5, rsi=6, rdi=7, r8..r15 = 8..15).
+
+#include <cstdint>
+#include <cstring>
+#include <initializer_list>
+#include <vector>
+
+namespace ps2x::x64
+{
+    enum Reg : uint8_t
+    {
+        RAX = 0,
+        RCX = 1,
+        RDX = 2,
+        RBX = 3,
+        RSP = 4,
+        RBP = 5,
+        RSI = 6,
+        RDI = 7,
+        R8 = 8,
+        R9 = 9,
+        R10 = 10,
+        R11 = 11,
+        R12 = 12,
+        R13 = 13,
+        R14 = 14,
+        R15 = 15,
+    };
+
+    class Emitter
+    {
+    public:
+        std::vector<uint8_t> code;
+
+        size_t size() const { return code.size(); }
+
+        void byte(uint8_t b) { code.push_back(b); }
+        void u32(uint32_t v)
+        {
+            for (int i = 0; i < 4; ++i)
+                code.push_back(static_cast<uint8_t>(v >> (i * 8)));
+        }
+        void u64(uint64_t v)
+        {
+            for (int i = 0; i < 8; ++i)
+                code.push_back(static_cast<uint8_t>(v >> (i * 8)));
+        }
+
+        // REX prefix: w = 64-bit operand, r = ModRM.reg extension, b = ModRM.rm/base extension.
+        void rex(bool w, uint8_t reg, uint8_t rm, bool force = false)
+        {
+            const uint8_t value = static_cast<uint8_t>(0x40u | (w ? 8u : 0u) | ((reg & 8u) ? 4u : 0u) | ((rm & 8u) ? 1u : 0u));
+            if (value != 0x40u || force)
+                byte(value);
+        }
+
+        // ModRM + SIB + disp32 for [base + disp32] (base is never RIP here).
+        void mem(uint8_t reg, uint8_t base, int32_t disp)
+        {
+            const uint8_t r = reg & 7u, b = base & 7u;
+            byte(static_cast<uint8_t>(0x80u | (r << 3) | b)); // mod=10: disp32
+            if (b == RSP)
+                byte(0x24); // SIB: base=rsp/r12, no index
+            u32(static_cast<uint32_t>(disp));
+        }
+
+        void push(uint8_t reg)
+        {
+            rex(false, 0, reg);
+            byte(static_cast<uint8_t>(0x50u + (reg & 7u)));
+        }
+        void pop(uint8_t reg)
+        {
+            rex(false, 0, reg);
+            byte(static_cast<uint8_t>(0x58u + (reg & 7u)));
+        }
+        void ret() { byte(0xC3); }
+
+        void subRsp(int8_t imm)
+        {
+            byte(0x48);
+            byte(0x83);
+            byte(0xEC);
+            byte(static_cast<uint8_t>(imm));
+        }
+        void addRsp(int8_t imm)
+        {
+            byte(0x48);
+            byte(0x83);
+            byte(0xC4);
+            byte(static_cast<uint8_t>(imm));
+        }
+
+        // mov dst, src (64-bit)
+        void movRR(uint8_t dst, uint8_t src)
+        {
+            rex(true, src, dst);
+            byte(0x89);
+            byte(static_cast<uint8_t>(0xC0u | ((src & 7u) << 3) | (dst & 7u)));
+        }
+        // mov reg, imm64
+        void movImm64(uint8_t reg, uint64_t imm)
+        {
+            rex(true, 0, reg);
+            byte(static_cast<uint8_t>(0xB8u + (reg & 7u)));
+            u64(imm);
+        }
+        // mov r32, imm32 (zero-extends)
+        void movImm32(uint8_t reg, uint32_t imm)
+        {
+            rex(false, 0, reg);
+            byte(static_cast<uint8_t>(0xB8u + (reg & 7u)));
+            u32(imm);
+        }
+        // call reg
+        void callR(uint8_t reg)
+        {
+            rex(false, 0, reg);
+            byte(0xFF);
+            byte(static_cast<uint8_t>(0xD0u | (reg & 7u)));
+        }
+
+        // mov r32, dword [base + disp]
+        void load32(uint8_t reg, uint8_t base, int32_t disp)
+        {
+            rex(false, reg, base);
+            byte(0x8B);
+            mem(reg, base, disp);
+        }
+        // mov dword [base + disp], r32
+        void store32(uint8_t base, int32_t disp, uint8_t reg)
+        {
+            rex(false, reg, base);
+            byte(0x89);
+            mem(reg, base, disp);
+        }
+        // sub r32, dword [base + disp]
+        void sub32M(uint8_t reg, uint8_t base, int32_t disp)
+        {
+            rex(false, reg, base);
+            byte(0x2B);
+            mem(reg, base, disp);
+        }
+        // mov dword [base + disp], imm32
+        void store32Imm(uint8_t base, int32_t disp, uint32_t imm)
+        {
+            rex(false, 0, base);
+            byte(0xC7);
+            mem(0, base, disp);
+            u32(imm);
+        }
+        // mov byte [base + disp], imm8
+        void store8Imm(uint8_t base, int32_t disp, uint8_t imm)
+        {
+            rex(false, 0, base);
+            byte(0xC6);
+            mem(0, base, disp);
+            byte(imm);
+        }
+        // cmp byte [base + disp], imm8
+        void cmp8Imm(uint8_t base, int32_t disp, uint8_t imm)
+        {
+            rex(false, 0, base);
+            byte(0x80);
+            mem(7, base, disp);
+            byte(imm);
+        }
+        // add qword [base + disp], imm32 (sign-extended)
+        void add64MImm(uint8_t base, int32_t disp, int32_t imm)
+        {
+            rex(true, 0, base);
+            byte(0x81);
+            mem(0, base, disp);
+            u32(static_cast<uint32_t>(imm));
+        }
+        // and r32, imm32
+        void and32Imm(uint8_t reg, uint32_t imm)
+        {
+            rex(false, 0, reg);
+            byte(0x81);
+            byte(static_cast<uint8_t>(0xE0u | (reg & 7u)));
+            u32(imm);
+        }
+        // lea dst32, [src + imm32]
+        void lea32(uint8_t dst, uint8_t src, int32_t disp)
+        {
+            rex(false, dst, src);
+            byte(0x8D);
+            mem(dst, src, disp);
+        }
+        // test r32, r32
+        void test32(uint8_t a, uint8_t b)
+        {
+            rex(false, b, a);
+            byte(0x85);
+            byte(static_cast<uint8_t>(0xC0u | ((b & 7u) << 3) | (a & 7u)));
+        }
+
+        // Jumps with a rel32 target patched later. Returns the offset of the rel32 field.
+        size_t jccRel32(uint8_t cc) // 0x84 je, 0x85 jne
+        {
+            byte(0x0F);
+            byte(cc);
+            const size_t at = size();
+            u32(0);
+            return at;
+        }
+        size_t jmpRel32()
+        {
+            byte(0xE9);
+            const size_t at = size();
+            u32(0);
+            return at;
+        }
+        void patchRel32(size_t at, size_t target)
+        {
+            const int32_t rel = static_cast<int32_t>(static_cast<int64_t>(target) - static_cast<int64_t>(at + 4u));
+            std::memcpy(code.data() + at, &rel, 4);
+        }
+
+        // --- SSE ---------------------------------------------------------------------------------------
+        // movd xmm, r32
+        void movdXR(uint8_t xmm, uint8_t reg)
+        {
+            byte(0x66);
+            rex(false, xmm, reg);
+            byte(0x0F);
+            byte(0x6E);
+            byte(static_cast<uint8_t>(0xC0u | ((xmm & 7u) << 3) | (reg & 7u)));
+        }
+        // pshufd xmm, xmm, imm8
+        void pshufd(uint8_t dst, uint8_t src, uint8_t imm)
+        {
+            byte(0x66);
+            rex(false, dst, src);
+            byte(0x0F);
+            byte(0x70);
+            byte(static_cast<uint8_t>(0xC0u | ((dst & 7u) << 3) | (src & 7u)));
+            byte(imm);
+        }
+        // movdqu xmm, [base + disp]
+        void loadX(uint8_t xmm, uint8_t base, int32_t disp)
+        {
+            byte(0xF3);
+            rex(false, xmm, base);
+            byte(0x0F);
+            byte(0x6F);
+            mem(xmm, base, disp);
+        }
+        // movdqu [base + disp], xmm
+        void storeX(uint8_t base, int32_t disp, uint8_t xmm)
+        {
+            byte(0xF3);
+            rex(false, xmm, base);
+            byte(0x0F);
+            byte(0x7F);
+            mem(xmm, base, disp);
+        }
+        // pcmpgtd xmm, xmm (signed dword >)
+        void pcmpgtd(uint8_t dst, uint8_t src)
+        {
+            byte(0x66);
+            rex(false, dst, src);
+            byte(0x0F);
+            byte(0x66);
+            byte(static_cast<uint8_t>(0xC0u | ((dst & 7u) << 3) | (src & 7u)));
+        }
+        // movmskps r32, xmm
+        void movmskps(uint8_t reg, uint8_t xmm)
+        {
+            rex(false, reg, xmm);
+            byte(0x0F);
+            byte(0x50);
+            byte(static_cast<uint8_t>(0xC0u | ((reg & 7u) << 3) | (xmm & 7u)));
+        }
+        // test r32, imm32
+        void test32Imm(uint8_t reg, uint32_t imm)
+        {
+            rex(false, 0, reg);
+            byte(0xF7);
+            byte(static_cast<uint8_t>(0xC0u | (reg & 7u)));
+            u32(imm);
+        }
+        // cmp dword [base + disp], r32
+        void cmp32MR(uint8_t base, int32_t disp, uint8_t reg)
+        {
+            rex(false, reg, base);
+            byte(0x39);
+            mem(reg, base, disp);
+        }
+        // mov byte [base + disp], r8 (low byte of rax/rcx/rdx/rbx only)
+        void store8(uint8_t base, int32_t disp, uint8_t reg)
+        {
+            rex(false, reg, base);
+            byte(0x88);
+            mem(reg, base, disp);
+        }
+
+        // Generic SSE forms: [prefix] [REX] 0F op... with a register or [base + disp32] operand.
+        void sseRR(uint8_t prefix, std::initializer_list<uint8_t> ops, uint8_t dst, uint8_t src)
+        {
+            if (prefix)
+                byte(prefix);
+            rex(false, dst, src);
+            byte(0x0F);
+            for (uint8_t op : ops)
+                byte(op);
+            byte(static_cast<uint8_t>(0xC0u | ((dst & 7u) << 3) | (src & 7u)));
+        }
+        void sseRM(uint8_t prefix, std::initializer_list<uint8_t> ops, uint8_t reg, uint8_t base, int32_t disp)
+        {
+            if (prefix)
+                byte(prefix);
+            rex(false, reg, base);
+            byte(0x0F);
+            for (uint8_t op : ops)
+                byte(op);
+            mem(reg, base, disp);
+        }
+        void movupsLoad(uint8_t x, uint8_t base, int32_t disp) { sseRM(0, {0x10}, x, base, disp); }
+        void movupsStore(uint8_t base, int32_t disp, uint8_t x) { sseRM(0, {0x11}, x, base, disp); }
+        void movaps(uint8_t dst, uint8_t src) { sseRR(0, {0x28}, dst, src); }
+        void movdLoad(uint8_t x, uint8_t base, int32_t disp) { sseRM(0x66, {0x6E}, x, base, disp); }
+        void pandM(uint8_t x, uint8_t base, int32_t disp) { sseRM(0x66, {0xDB}, x, base, disp); }
+        void pand(uint8_t dst, uint8_t src) { sseRR(0x66, {0xDB}, dst, src); }
+        void por(uint8_t dst, uint8_t src) { sseRR(0x66, {0xEB}, dst, src); }
+        void pminudM(uint8_t x, uint8_t base, int32_t disp) { sseRM(0x66, {0x38, 0x3B}, x, base, disp); }
+        void pcmpgtdM(uint8_t x, uint8_t base, int32_t disp) { sseRM(0x66, {0x66}, x, base, disp); }
+        void addps(uint8_t dst, uint8_t src) { sseRR(0, {0x58}, dst, src); }
+        void mulps(uint8_t dst, uint8_t src) { sseRR(0, {0x59}, dst, src); }
+        void subps(uint8_t dst, uint8_t src) { sseRR(0, {0x5C}, dst, src); }
+        void minps(uint8_t dst, uint8_t src) { sseRR(0, {0x5D}, dst, src); }
+        void maxps(uint8_t dst, uint8_t src) { sseRR(0, {0x5F}, dst, src); }
+        // blendps xmm, xmm, imm8 (SSE4.1): element i from src where bit i is set.
+        void blendps(uint8_t dst, uint8_t src, uint8_t imm)
+        {
+            sseRR(0x66, {0x3A, 0x0C}, dst, src);
+            byte(imm);
+        }
+
+        // pblendw xmm, xmm, imm8 (SSE4.1)
+        void pblendw(uint8_t dst, uint8_t src, uint8_t imm)
+        {
+            byte(0x66);
+            rex(false, dst, src);
+            byte(0x0F);
+            byte(0x3A);
+            byte(0x0E);
+            byte(static_cast<uint8_t>(0xC0u | ((dst & 7u) << 3) | (src & 7u)));
+            byte(imm);
+        }
+    };
+}
+
+#endif
