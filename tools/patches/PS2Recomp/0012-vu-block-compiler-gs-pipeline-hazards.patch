+uint64_t VuFastEngine::readyFor(const Pair &p) const
+{
+    // The lanes read are masked in and the latest one wins (same rules as calculatePairReadyCycle).
+    uint64_t ready = cycle;
+    const uint32_t now32 = static_cast<uint32_t>(cycle - m_readyBase);
+    __m128i laneMax = _mm_setzero_si128();
+    for (uint32_t n = 0; n < p.readCount; ++n)
+    {
+        const __m128i laneReady = _mm_load_si128(reinterpret_cast<const __m128i *>(m_vfReady[p.readReg[n]]));
+        laneMax = _mm_max_epu32(laneMax, _mm_and_si128(laneReady, _mm_castps_si128(destMask(p.readLanes[n]))));
+    }
+    if (p.accRead)
+    {
+        const __m128i laneReady = _mm_load_si128(reinterpret_cast<const __m128i *>(m_accReady));
+        laneMax = _mm_max_epu32(laneMax, _mm_and_si128(laneReady, _mm_castps_si128(destMask(p.accRead))));
+    }
+    laneMax = _mm_max_epu32(laneMax, _mm_shuffle_epi32(laneMax, _MM_SHUFFLE(1, 0, 3, 2)));
+    laneMax = _mm_max_epu32(laneMax, _mm_shuffle_epi32(laneMax, _MM_SHUFFLE(2, 3, 0, 1)));
+    uint32_t ready32 = static_cast<uint32_t>(_mm_cvtsi128_si32(laneMax));
+    for (uint32_t bits = p.viRead; bits != 0u; bits &= bits - 1u)
+        ready32 = std::max(ready32, m_viReady[static_cast<uint32_t>(std::countr_zero(bits))]);
+    if (ready32 > now32)
+        ready = m_readyBase + ready32;
+    if (p.flags & (kFdiv | kEfu | kWaitQ | kWaitP))
+    {
+        if ((p.flags & (kFdiv | kWaitQ)) && fdiv.valid)
+            ready = std::max(ready, fdiv.ready);
+        if (p.flags & kEfu)
+            ready = std::max(ready, efuResourceReady);
+        if (p.flags & kWaitP)
+            for (const Scalar &entry : efu)
+                if (entry.valid)
+                    ready = std::max(ready, entry.ready);
+    }
+    return ready;
+}
+
+uint32_t VuFastEngine::jitStall(VuFastEngine *engine, const Pair *pair)
+{
+    VuFastEngine &e = *engine;
+    const uint64_t ready = e.readyFor(*pair);
+    if (ready > e.cycle)
+    {
+        if (ready >= e.m_budgetEnd)
+        {
+            e.cycle = e.m_budgetEnd;
+            return 1u;
+        }
+        e.cycle = ready;
+    }
+    if (pair->flags & kCommit)
+        e.commit(e.cycle);
+    return 0u;
+}
+
+bool VuFastEngine::jitable(const Pair &p) const
+{
+    return (p.flags & (kReserved | kEBit | kDBit | kTBit)) == 0u && p.shadowReg == 0u;
+}
