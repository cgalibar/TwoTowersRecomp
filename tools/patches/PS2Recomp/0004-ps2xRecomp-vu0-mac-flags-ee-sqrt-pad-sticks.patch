+        // FMAC instructions set the MAC flags (sign/zero of each written field) and STATUS, which games
+        // read with CFC2 vi17/vi16 (e.g. a frustum test on the signs of a VSUB). VF0 is read-only.
+        std::string withMacFlags(std::string code, uint8_t destMask)
+        {
+            const size_t close = code.rfind('}');
+            if (close == std::string::npos || code.find("__m128 res") == std::string::npos)
+            {
+                return code;
+            }
+            const uint32_t lanes = ((destMask >> 3) & 1u) | (((destMask >> 2) & 1u) << 1) |
+                                   (((destMask >> 1) & 1u) << 2) | ((destMask & 1u) << 3);
+            code.insert(close, fmt::format("PS2_VU0_SET_MAC(ctx, res, {}u); ", lanes));
+            static constexpr std::string_view kVf0Write = "ctx->vu0_vf[0] = ";
+            for (size_t pos = code.find(kVf0Write); pos != std::string::npos; pos = code.find(kVf0Write, pos))
+            {
+                code.replace(pos, kVf0Write.size(), "(void)");
+            }
+            return code;
+        }
+    }
