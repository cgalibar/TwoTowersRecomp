--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -377,6 +377,29 @@ inline __m128 ps2_vmul(__m128 a, __m128 b)
 #define PS2_VMULQ(a, q) _mm_mul_ps((__m128)(a), _mm_set1_ps(q))
 #define PS2_VBLEND(a, b, mask) PS2_BLENDV_PS((__m128)(a), (__m128)(b), (__m128)(mask))
 
+// MAC flags of a VU0 macro-mode FMAC result. `lanes` are the written fields, bit 0 = x ... bit 3 = w.
+// The MAC register keeps the zero flags in bits 0-3 and the sign flags in bits 4-7, with w in the low
+// bit of each group and x in the high one.
+inline uint32_t ps2_vu0_mac_flags(__m128 res, uint32_t lanes)
+{
+    static constexpr uint8_t kReverse[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+    const uint32_t sign = static_cast<uint32_t>(_mm_movemask_ps(res)) & lanes;
+    const __m128i exponent = _mm_and_si128(_mm_castps_si128(res), _mm_set1_epi32(0x7F800000));
+    const uint32_t zero =
+        static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(exponent, _mm_setzero_si128())))) & lanes;
+    return (static_cast<uint32_t>(kReverse[sign]) << 4) | kReverse[zero];
+}
+
+// FMAC instructions update MAC and the Z/S bits of STATUS (plus their sticky copies, bits 6-7).
+#define PS2_VU0_SET_MAC(ctx, res, lanes)                                                                  \
+    do                                                                                                    \
+    {                                                                                                     \
+        const uint32_t ps2Mac = ps2_vu0_mac_flags((res), (lanes));                                        \
+        const uint16_t ps2Status = static_cast<uint16_t>(((ps2Mac & 0x0Fu) ? 1u : 0u) | ((ps2Mac & 0xF0u) ? 2u : 0u)); \
+        (ctx)->vu0_mac_flags = ps2Mac;                                                                    \
+        (ctx)->vu0_status = static_cast<uint16_t>(((ctx)->vu0_status & ~0x3u) | ps2Status | (ps2Status << 6)); \
+    } while (0)
+
