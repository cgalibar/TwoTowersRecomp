+void EeScheduler::setVBlankRate(uint32_t hz) noexcept
+{
+    if (hz == 0u)
+    {
+        return;
+    }
+    const uint64_t period = (1000000u + hz / 2u) / hz;
+    if (m_vblankPeriodMicroseconds.exchange(period, std::memory_order_relaxed) != period)
+    {
+        std::cout << "[ee] VBlank rate " << hz << " Hz" << std::endl;
+    }
+}
