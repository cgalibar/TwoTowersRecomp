+namespace
+{
+    // Sampler::texelKind of a texture format (0: read through GSMem).
+    unsigned texelKindOf(const GSDrawState &state)
+    {
+        if (!state.prim.tme || !GSSwizzle::Get(state.context.tex0.psm))
+            return 0u;
+        switch (state.context.tex0.psm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_Z32: return 1u;
+        case GS_PSM_CT24:
+        case GS_PSM_Z24: return 2u;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S: return 3u;
+        case GS_PSM_T8: return 4u;
+        case GS_PSM_T4: return 5u;
+        case GS_PSM_T8H: return 6u;
+        case GS_PSM_T4HL: return 7u;
+        case GS_PSM_T4HH: return 8u;
+        default: return 0u;
+        }
+    }
+}
+
+void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
+{
+    switch (texelKindOf(batch.state))
+    {
+    case 1u: DrawSpriteK<1u>(batch); return;
+    case 2u: DrawSpriteK<2u>(batch); return;
+    case 3u: DrawSpriteK<3u>(batch); return;
+    case 4u: DrawSpriteK<4u>(batch); return;
+    case 5u: DrawSpriteK<5u>(batch); return;
+    case 6u: DrawSpriteK<6u>(batch); return;
+    case 7u: DrawSpriteK<7u>(batch); return;
+    case 8u: DrawSpriteK<8u>(batch); return;
+    default: DrawSpriteK<0u>(batch); return;
+    }
+}
+
+void GSCpuBackend::DrawTriangle(const GSPrimitiveBatch &batch)
+{
+    switch (texelKindOf(batch.state))
+    {
+    case 1u: DrawTriangleK<1u>(batch); return;
+    case 2u: DrawTriangleK<2u>(batch); return;
+    case 3u: DrawTriangleK<3u>(batch); return;
+    case 4u: DrawTriangleK<4u>(batch); return;
+    case 5u: DrawTriangleK<5u>(batch); return;
+    case 6u: DrawTriangleK<6u>(batch); return;
+    case 7u: DrawTriangleK<7u>(batch); return;
+    case 8u: DrawTriangleK<8u>(batch); return;
+    default: DrawTriangleK<0u>(batch); return;
+    }
+}
