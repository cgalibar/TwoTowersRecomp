+    // readTexel for one texel kind, known at compile time (DrawSpriteK / DrawTriangleK).
+    template <unsigned K>
+    uint32_t readTexelK(GSMem::TexturePageCache &cache, uint32_t u, uint32_t v) const
+    {
+        if constexpr (K == 0u)
+            return read(cache, vram, tbp, tbw, u, v);
+        else
+        {
+            const uint32_t pixel = GSSwizzle::AddressFast(*format, texBase, texRowStride, u, v);
+            if constexpr (K == 1u || K == 2u)
+            {
+                uint32_t value = 0u;
+                std::memcpy(&value, cache.Resolve(vram, (pixel << 2u) & 0x3FFFFCu), 4u);
+                return K == 2u ? (value & 0x00FFFFFFu) : value;
+            }
+            else if constexpr (K == 3u)
+            {
+                uint16_t value = 0u;
+                std::memcpy(&value, cache.Resolve(vram, (pixel << 1u) & 0x3FFFFEu), 2u);
+                return value;
+            }
+            else if constexpr (K == 4u)
+                return *cache.Resolve(vram, pixel & 0x3FFFFFu);
+            else if constexpr (K == 5u)
+                return (*cache.Resolve(vram, (pixel >> 1u) & 0x3FFFFFu) >> ((pixel & 1u) * 4u)) & 0x0Fu;
+            else if constexpr (K == 6u)
+                return *cache.Resolve(vram, ((pixel << 2u) + 3u) & 0x3FFFFFu);
+            else if constexpr (K == 7u)
+                return *cache.Resolve(vram, ((pixel << 2u) + 3u) & 0x3FFFFFu) & 0x0Fu;
+            else
+                return (*cache.Resolve(vram, ((pixel << 2u) + 3u) & 0x3FFFFFu) >> 4u) & 0x0Fu;
+        }
+    }
+
+    template <unsigned K>
+    uint32_t pointK(GSMem::TexturePageCache &cache, int u, int v) const
+    {
+        u = wrapTextureCoordinate(u, texW, wrapU, minU, maxU);
+        v = wrapTextureCoordinate(v, texH, wrapV, minV, maxV);
+        const uint32_t raw = readTexelK<K>(cache, static_cast<uint32_t>(u), static_cast<uint32_t>(v));
+        if (palette)
+            return palette[raw & 0xFFu];
+        switch (kind)
+        {
+        case 1:
+            return applyTexa(texa, psm, raw);
+        case 2:
+            return applyTexa(texa, psm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+        case 3:
+            return clutLookup(static_cast<uint8_t>(raw));
+        default:
+            return 0xFFFF00FFu;
+        }
+    }
+
+    // sample() with pointK.
+    template <unsigned K>
+    uint32_t sampleK(GSMem::TexturePageCache &cache, float s, float t, float q, uint16_t u, uint16_t v) const
+    {
+        float texUf, texVf;
+        if (fst)
+        {
+            texUf = static_cast<float>(u) / 16.0f;
+            texVf = static_cast<float>(v) / 16.0f;
+        }
+        else
+        {
+            const float invQ = 1.0f / fabsQ(q);
+            texUf = s * invQ * fTexW;
+            texVf = t * invQ * fTexH;
+        }
+        if (!linear)
+            return pointK<K>(cache, static_cast<int>(texUf), static_cast<int>(texVf));
+
+        const float sampleU = texUf - 0.5f;
+        const float sampleV = texVf - 0.5f;
+        const int u0 = static_cast<int>(std::floor(sampleU));
+        const int v0 = static_cast<int>(std::floor(sampleV));
+        const float fx = sampleU - static_cast<float>(u0);
+        const float fy = sampleV - static_cast<float>(v0);
+        const uint32_t wx = static_cast<uint32_t>(fx * 256.0f + 0.5f);
+        const uint32_t wy = static_cast<uint32_t>(fy * 256.0f + 0.5f);
+        const uint32_t c00 = pointK<K>(cache, u0, v0);
+        const uint32_t c10 = wx != 0u ? pointK<K>(cache, u0 + 1, v0) : 0u;
+        const uint32_t c01 = wy != 0u ? pointK<K>(cache, u0, v0 + 1) : 0u;
+        const uint32_t c11 = (wx != 0u && wy != 0u) ? pointK<K>(cache, u0 + 1, v0 + 1) : 0u;
+        if (wx == 0u && wy == 0u)
+            return c00;
+        constexpr uint32_t kMask = 0x00FF00FFu;
+        const auto lerp2 = [](uint32_t a, uint32_t b, uint32_t w) -> uint32_t
+        {
+            return (((a * (256u - w)) + (b * w) + 0x00800080u) >> 8) & kMask;
+        };
+        const uint32_t topRb = lerp2(c00 & kMask, c10 & kMask, wx);
+        const uint32_t topGa = lerp2((c00 >> 8) & kMask, (c10 >> 8) & kMask, wx);
+        const uint32_t bottomRb = lerp2(c01 & kMask, c11 & kMask, wx);
+        const uint32_t bottomGa = lerp2((c01 >> 8) & kMask, (c11 >> 8) & kMask, wx);
+        return lerp2(topRb, bottomRb, wy) | (lerp2(topGa, bottomGa, wy) << 8);
+    }
