+void GSCpuBackend::BuildSampler(const GSDrawState &state, Sampler &smp) const
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    smp.read = GSMem::GetTextureReader(tex.psm);
+    smp.vram = m_vram;
+    smp.clut = m_clut.data();
+    smp.texa = state.texa;
+    smp.tbp = tex.tbp0;
+    smp.tbw = tex.tbw;
+    smp.texW = state.textureWidth;
+    smp.texH = state.textureHeight;
+    smp.fTexW = static_cast<float>(state.textureWidth);
+    smp.fTexH = static_cast<float>(state.textureHeight);
+    const uint64_t clamp = ctx.clamp;
+    smp.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    smp.wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    smp.minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    smp.maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    smp.minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    smp.maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    smp.psm = tex.psm;
+    smp.cpsm = tex.cpsm;
+    smp.csm = tex.csm;
+    smp.csa = tex.csa;
+    smp.linear = state.linearFilter;
+    smp.fst = state.prim.fst;
+    switch (tex.psm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+        smp.kind = 1;
+        break;
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        smp.kind = 2;
+        break;
+    case GS_PSM_T8:
+    case GS_PSM_T8H:
+    case GS_PSM_T4:
+    case GS_PSM_T4HL:
+    case GS_PSM_T4HH:
+        smp.kind = 3;
+        break;
+    default:
+        smp.kind = 0;
+        break;
+    }
+}
