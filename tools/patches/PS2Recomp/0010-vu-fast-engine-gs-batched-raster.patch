+    void hAbs(VuFastEngine &e, const Pair &p)
+    {
+        VU1State &s = e.s;
+        const __m128 v = _mm_and_ps(clampOp(ld(s.vf[p.u.fs])), _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF)));
+        st(s.vf[p.u.ft], blendDest(ld(s.vf[p.u.ft]), v, p.u.dest));
+    }
+
+    void hClip(VuFastEngine &e, const Pair &p)
+    {
+        VU1State &s = e.s;
+        uint32_t wBits = 0u;
+        std::memcpy(&wBits, &s.vf[p.u.ft][3], sizeof(wBits));
+        const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+        uint32_t flags = 0u;
+        for (uint32_t c = 0; c < 3u; ++c)
+        {
+            uint32_t bits = 0u;
+            std::memcpy(&bits, &s.vf[p.u.fs][c], sizeof(bits));
+            if (static_cast<int32_t>(bits) > limit)
+                flags |= 1u << (c * 2u);
+            if (static_cast<int32_t>(bits ^ 0x80000000u) > limit)
+                flags |= 2u << (c * 2u);
+        }
+        e.workingClip() = ((e.workingClip() << 6) | (flags & 0x3Fu)) & 0xFFFFFFu;
+        e.pushFlags(0u, 0u, 8u, e.workingClip());
+    }
+
+    template <bool Sub>
+    void hOuter(VuFastEngine &e, const Pair &p)
+    {
+        VU1State &s = e.s;
+        const __m128 a = clampOp(ld(s.vf[p.u.fs]));
+        const __m128 b = clampOp(ld(s.vf[p.u.ft]));
+        const __m128 ayzx = _mm_shuffle_ps(a, a, _MM_SHUFFLE(3, 0, 2, 1));
+        const __m128 bzxy = _mm_shuffle_ps(b, b, _MM_SHUFFLE(3, 1, 0, 2));
+        __m128 r = _mm_mul_ps(ayzx, bzxy);
+        if constexpr (Sub)
+            r = _mm_sub_ps(clampOp(ld(s.acc)), r);
+        r = _mm_blend_ps(r, _mm_setzero_ps(), 0x8); // w = 0
+        finishFmac(e, r, p.u.dest, Sub ? s.vf[p.u.fd] : s.acc);
+    }
+
+    void hReservedUpper(VuFastEngine &e, const Pair &p) { e.reserved(true, p.upperInstr); }
+
+    VuFastEngine::Handler selectUpper(uint32_t instr, bool &readsQ)
+    {
+        readsQ = false;
+        const uint8_t op = static_cast<uint8_t>(instr & 0x3Fu);
+        if (op <= 0x2Fu)
+        {
+            switch (op)
+            {
+            case 0x00: case 0x01: case 0x02: case 0x03: return &hFmac<kAdd, sBc, false>;
+            case 0x04: case 0x05: case 0x06: case 0x07: return &hFmac<kSub, sBc, false>;
+            case 0x08: case 0x09: case 0x0A: case 0x0B: return &hFmac<kMadd, sBc, false>;
+            case 0x0C: case 0x0D: case 0x0E: case 0x0F: return &hFmac<kMsub, sBc, false>;
+            case 0x10: case 0x11: case 0x12: case 0x13: return &hFmac<kMax, sBc, false>;
+            case 0x14: case 0x15: case 0x16: case 0x17: return &hFmac<kMin, sBc, false>;
+            case 0x18: case 0x19: case 0x1A: case 0x1B: return &hFmac<kMul, sBc, false>;
+            case 0x1C: readsQ = true; return &hFmac<kMul, sQ, false>;
+            case 0x1D: return &hFmac<kMax, sI, false>;
+            case 0x1E: return &hFmac<kMul, sI, false>;
+            case 0x1F: return &hFmac<kMin, sI, false>;
+            case 0x20: readsQ = true; return &hFmac<kAdd, sQ, false>;
+            case 0x21: readsQ = true; return &hFmac<kMadd, sQ, false>;
+            case 0x22: return &hFmac<kAdd, sI, false>;
+            case 0x23: return &hFmac<kMadd, sI, false>;
+            case 0x24: readsQ = true; return &hFmac<kSub, sQ, false>;
+            case 0x25: readsQ = true; return &hFmac<kMsub, sQ, false>;
+            case 0x26: return &hFmac<kSub, sI, false>;
+            case 0x27: return &hFmac<kMsub, sI, false>;
+            case 0x28: return &hFmac<kAdd, sFull, false>;
+            case 0x29: return &hFmac<kMadd, sFull, false>;
+            case 0x2A: return &hFmac<kMul, sFull, false>;
+            case 0x2B: return &hFmac<kMax, sFull, false>;
+            case 0x2C: return &hFmac<kSub, sFull, false>;
+            case 0x2D: return &hFmac<kMsub, sFull, false>;
+            case 0x2E: return &hOuter<true>;
+            case 0x2F: return &hFmac<kMin, sFull, false>;
+            default: return &hReservedUpper;
+            }
+        }
+        if (op < 0x3Cu)
+            return &hReservedUpper;
+
+        const uint8_t special = static_cast<uint8_t>((instr & 0x3u) | ((instr >> 4) & 0x7Cu));
+        switch (special)
+        {
+        case 0x00: case 0x01: case 0x02: case 0x03: return &hFmac<kAdd, sBc, true>;
+        case 0x04: case 0x05: case 0x06: case 0x07: return &hFmac<kSub, sBc, true>;
+        case 0x08: case 0x09: case 0x0A: case 0x0B: return &hFmac<kMadd, sBc, true>;
+        case 0x0C: case 0x0D: case 0x0E: case 0x0F: return &hFmac<kMsub, sBc, true>;
+        case 0x10: return &hItof<0>;
+        case 0x11: return &hItof<4>;
+        case 0x12: return &hItof<12>;
+        case 0x13: return &hItof<15>;
+        case 0x14: return &hFtoi<0>;
+        case 0x15: return &hFtoi<4>;
+        case 0x16: return &hFtoi<12>;
+        case 0x17: return &hFtoi<15>;
+        case 0x18: case 0x19: case 0x1A: case 0x1B: return &hFmac<kMul, sBc, true>;
+        case 0x1C: readsQ = true; return &hFmac<kMul, sQ, true>;
+        case 0x1D: return &hAbs;
+        case 0x1E: return &hFmac<kMul, sI, true>;
+        case 0x1F: return &hClip;
+        case 0x20: readsQ = true; return &hFmac<kAdd, sQ, true>;
+        case 0x21: readsQ = true; return &hFmac<kMadd, sQ, true>;
+        case 0x22: return &hFmac<kAdd, sI, true>;
+        case 0x23: return &hFmac<kMadd, sI, true>;
+        case 0x24: readsQ = true; return &hFmac<kSub, sQ, true>;
+        case 0x25: readsQ = true; return &hFmac<kMsub, sQ, true>;
+        case 0x26: return &hFmac<kSub, sI, true>;
+        case 0x27: return &hFmac<kMsub, sI, true>;
+        case 0x28: return &hFmac<kAdd, sFull, true>;
+        case 0x29: return &hFmac<kMadd, sFull, true>;
+        case 0x2A: return &hFmac<kMul, sFull, true>;
+        case 0x2C: return &hFmac<kSub, sFull, true>;
+        case 0x2D: return &hFmac<kMsub, sFull, true>;
+        case 0x2E: return &hOuter<false>;
+        case 0x2F: case 0x30: return &hNop;
+        default: return &hReservedUpper;
+        }
+    }
+
+    // ---- lower instructions ---------------------------------------------------------------------------
+
+    float vuEatan(float value)
+    {
+        constexpr float coefficients[] = {0.999999344348907f, -0.333298563957214f, 0.199465364217758f,
+                                          -0.13085337519646f, 0.096420042216778f, -0.055909886956215f,
+                                          0.021861229091883f, -0.004054057877511f};
+        constexpr float quarterPi = 0.785398185253143f;
+        const float squared = value * value;
+        float polynomial = coefficients[7];
+        for (int index = 6; index >= 0; --index)
+            polynomial = coefficients[index] + squared * polynomial;
+        return quarterPi + value * polynomial;
+    }
+
+    float vuEsin(float value)
+    {
+        constexpr float coefficients[] = {1.0f, -0.166666567325592f, 0.008333025500178f, -0.000198074136279f,
+                                          0.000002601886990f};
+        const float squared = value * value;
+        float polynomial = coefficients[4];
+        for (int index = 3; index >= 0; --index)
+            polynomial = coefficients[index] + squared * polynomial;
+        return value * polynomial;
+    }
+
+    float vuEexp(float value)
+    {
+        constexpr float coefficients[] = {0.249998688697815f, 0.031257584691048f, 0.002591371303424f,
+                                          0.000171562001924f, 0.000005430199963f, 0.000000690600018f};
+        float polynomial = coefficients[5];
+        for (int index = 4; index >= 0; --index)
+            polynomial = coefficients[index] + value * polynomial;
+        polynomial = 1.0f + value * polynomial;
+        polynomial *= polynomial;
+        polynomial *= polynomial;
+        return polynomial != 0.0f ? 1.0f / polynomial : std::numeric_limits<float>::max();
+    }
+
+    inline uint32_t dataAddress(const VuFastEngine &e, int32_t qword)
+    {
+        return (static_cast<uint32_t>(qword) * 16u) & (e.dataSize - 1u);
+    }
+
+    inline void setVi(VU1State &s, uint8_t reg, int32_t value)
+    {
+        if (reg != 0u)
+            s.vi[reg] = value;
+    }
+
+    inline void storeLanes(VuFastEngine &e, uint32_t address, __m128 value, uint8_t dest)
+    {
+        if (address + 16u > e.dataSize)
+            return;
+        float *target = reinterpret_cast<float *>(e.data + address);
+        st(target, blendDest(ld(target), value, dest));
+    }
+
+    inline void loadLanes(VuFastEngine &e, uint32_t address, uint8_t reg, uint8_t dest)
+    {
+        if (address + 16u > e.dataSize)
+            return;
+        float *target = e.s.vf[reg];
+        st(target, blendDest(ld(target), ld(reinterpret_cast<const float *>(e.data + address)), dest));
+    }
+
+    inline int destComponent(uint8_t dest)
+    {
+        if (dest & 0x8u)
+            return 0;
+        if (dest & 0x4u)
+            return 1;
+        if (dest & 0x2u)
+            return 2;
+        return 3;
+    }
+
+    inline void branchTo(VuFastEngine &e, uint32_t target)
+    {
+        e.s.branchPending = true;
+        e.s.branchTarget = target;
+        e.s.branchDelay = 1;
+    }
+
+    inline uint32_t relativeTarget(const VuFastEngine &e, uint32_t instr)
+    {
+        return (e.s.pc + 8u + static_cast<uint32_t>(static_cast<int32_t>(IMM11(instr)) * 8)) & e.pcMask;
+    }
+
+    inline uint16_t imm12(uint32_t instr)
+    {
+        return static_cast<uint16_t>((((instr >> 21) & 0x1u) << 11) | (instr & 0x7FFu));
+    }
+
+    inline int32_t imm15(uint32_t instr)
+    {
+        return static_cast<int32_t>((instr & 0x7FFu) | ((instr >> 10) & 0x7800u));
+    }
+
+    void hLq(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        loadLanes(e, dataAddress(e, e.s.vi[VIS(i)] + IMM11(i)), FT(i), DEST(i));
+    }
+    void hSq(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        storeLanes(e, dataAddress(e, e.s.vi[VIT(i)] + IMM11(i)), ld(e.s.vf[FS(i)]), DEST(i));
+    }
+    void hIlw(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint32_t address = dataAddress(e, e.s.vi[VIS(i)] + IMM11(i));
+        if (address + 16u > e.dataSize)
+            return;
+        uint32_t v = 0;
+        std::memcpy(&v, e.data + address + destComponent(DEST(i)) * 4, 4);
+        setVi(e.s, VIT(i), static_cast<int16_t>(v & 0xFFFFu));
+    }
+    void hIsw(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint32_t address = dataAddress(e, e.s.vi[VIS(i)] + IMM11(i));
+        const int32_t value = static_cast<int32_t>(static_cast<uint16_t>(e.s.vi[VIT(i)] & 0xFFFF));
+        storeLanes(e, address, _mm_castsi128_ps(_mm_set1_epi32(value)), DEST(i));
+    }
+    void hIaddiu(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VIT(i), static_cast<int16_t>(e.s.vi[VIS(i)] + imm15(i)));
+    }
+    void hIsubiu(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VIT(i), static_cast<int16_t>(e.s.vi[VIS(i)] - imm15(i)));
+    }
+    void hFceq(VuFastEngine &e, const Pair &p)
+    {
+        e.s.vi[1] = ((e.s.clip & 0xFFFFFFu) == (p.lowerInstr & 0xFFFFFFu)) ? 1 : 0;
+    }
+    void hFcset(VuFastEngine &e, const Pair &p)
+    {
+        e.workingClip() = p.lowerInstr & 0xFFFFFFu;
+        for (uint32_t n = 0; n < e.flagCount; ++n)
+        {
+            VuFastEngine::FlagEntry &entry = e.flagRing[(e.flagHead + n) % VuFastEngine::kFlagRing];
+            if (entry.issue == e.cycle)
+                entry.kind = static_cast<uint8_t>(entry.kind & ~8u);
+        }
+        e.pushFlags(0u, 0u, 8u, e.workingClip());
+    }
+    void hFcand(VuFastEngine &e, const Pair &p)
+    {
+        e.s.vi[1] = ((e.s.clip & (p.lowerInstr & 0xFFFFFFu)) != 0u) ? 1 : 0;
+    }
+    void hFcor(VuFastEngine &e, const Pair &p)
+    {
+        e.s.vi[1] = ((e.s.clip | (p.lowerInstr & 0xFFFFFFu)) == 0xFFFFFFu) ? 1 : 0;
+    }
+    void hFseq(VuFastEngine &e, const Pair &p)
+    {
+        setVi(e.s, VIT(p.lowerInstr), ((e.s.status & 0xFFFu) == imm12(p.lowerInstr)) ? 1 : 0);
+    }
+    void hFsset(VuFastEngine &e, const Pair &p)
+    {
+        for (uint32_t n = 0; n < e.flagCount; ++n)
+        {
+            VuFastEngine::FlagEntry &entry = e.flagRing[(e.flagHead + n) % VuFastEngine::kFlagRing];
+            if (entry.issue == e.cycle)
+                entry.kind = static_cast<uint8_t>(entry.kind & ~2u);
+        }
+        e.pushFlags(0u, static_cast<uint32_t>(imm12(p.lowerInstr)) & 0xFC0u, 4u);
+    }
+    void hFsand(VuFastEngine &e, const Pair &p)
+    {
+        setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>((e.s.status & 0xFFFu) & imm12(p.lowerInstr)));
+    }
+    void hFsor(VuFastEngine &e, const Pair &p)
+    {
+        setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>((e.s.status & 0xFFFu) | imm12(p.lowerInstr)));
+    }
+    void hFmeq(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VIT(i), ((e.s.mac & 0xFFFFu) == static_cast<uint32_t>(static_cast<uint16_t>(e.s.vi[VIS(i)]))) ? 1 : 0);
+    }
+    void hFmand(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VIT(i), static_cast<int32_t>(e.s.mac & static_cast<uint32_t>(static_cast<uint16_t>(e.s.vi[VIS(i)]))));
+    }
+    void hFmor(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VIT(i), static_cast<int32_t>(e.s.mac | static_cast<uint32_t>(static_cast<uint16_t>(e.s.vi[VIS(i)]))));
+    }
+    void hFcget(VuFastEngine &e, const Pair &p)
+    {
+        setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>(e.s.clip & 0x0FFFu));
+    }
+    void hB(VuFastEngine &e, const Pair &p) { branchTo(e, relativeTarget(e, p.lowerInstr)); }
+    void hBal(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t target = relativeTarget(e, p.lowerInstr);
+        setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>((e.s.pc + 16u) / 8u));
+        branchTo(e, target);
+    }
+    void hJr(VuFastEngine &e, const Pair &p)
+    {
+        const uint8_t is = VIS(p.lowerInstr);
+        branchTo(e, (static_cast<uint32_t>(static_cast<uint16_t>(is != 0u ? e.s.vi[is] : 0)) * 8u) & e.pcMask);
+    }
+    void hJalr(VuFastEngine &e, const Pair &p)
+    {
+        const uint8_t is = VIS(p.lowerInstr);
+        const uint32_t target = (static_cast<uint32_t>(static_cast<uint16_t>(is != 0u ? e.s.vi[is] : 0)) * 8u) & e.pcMask;
+        setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>((e.s.pc + 16u) / 8u));
+        branchTo(e, target);
+    }
+    template <int Cond>
+    void hCondBranch(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const int16_t a = static_cast<int16_t>(e.branchVi(VIS(i)));
+        bool take = false;
+        if constexpr (Cond == 0)
+            take = a == static_cast<int16_t>(e.branchVi(VIT(i)));
+        else if constexpr (Cond == 1)
+            take = a != static_cast<int16_t>(e.branchVi(VIT(i)));
+        else if constexpr (Cond == 2)
+            take = a < 0;
+        else if constexpr (Cond == 3)
+            take = a > 0;
+        else if constexpr (Cond == 4)
+            take = a <= 0;
+        else
+            take = a >= 0;
+        if (take)
+            branchTo(e, relativeTarget(e, i));
+    }
+
+    void hIadd(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VID(i), static_cast<int16_t>(e.s.vi[VIS(i)] + e.s.vi[VIT(i)]));
+    }
+    void hIsub(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VID(i), static_cast<int16_t>(e.s.vi[VIS(i)] - e.s.vi[VIT(i)]));
+    }
+    void hIaddi(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const int16_t imm5 = static_cast<int16_t>(static_cast<int32_t>((i >> 6) & 0x1Fu) << 27 >> 27);
+        setVi(e.s, VIT(i), static_cast<int16_t>(e.s.vi[VIS(i)] + imm5));
+    }
+    void hIand(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VID(i), e.s.vi[VIS(i)] & e.s.vi[VIT(i)]);
+    }
+    void hIor(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        setVi(e.s, VID(i), e.s.vi[VIS(i)] | e.s.vi[VIT(i)]);
+    }
+    void hMove(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        float *target = e.s.vf[FT(i)];
+        st(target, blendDest(ld(target), ld(e.s.vf[FS(i)]), DEST(i)));
+    }
+    void hMr32(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const __m128 v = ld(e.s.vf[FS(i)]);
+        float *target = e.s.vf[FT(i)];
+        st(target, blendDest(ld(target), _mm_shuffle_ps(v, v, _MM_SHUFFLE(0, 3, 2, 1)), DEST(i)));
+    }
+    void hLqi(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint8_t is = VIS(i);
+        loadLanes(e, dataAddress(e, static_cast<uint16_t>(e.s.vi[is])), FT(i), DEST(i));
+        setVi(e.s, is, static_cast<int16_t>(e.s.vi[is] + 1));
+    }
+    void hSqi(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint8_t it = VIT(i);
+        storeLanes(e, dataAddress(e, static_cast<uint16_t>(e.s.vi[it])), ld(e.s.vf[FS(i)]), DEST(i));
+        setVi(e.s, it, static_cast<int16_t>(e.s.vi[it] + 1));
+    }
+    void hLqd(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint8_t is = VIS(i);
+        setVi(e.s, is, static_cast<int16_t>(e.s.vi[is] - 1));
+        loadLanes(e, dataAddress(e, static_cast<uint16_t>(e.s.vi[is])), FT(i), DEST(i));
+    }
+    void hSqd(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint8_t it = VIT(i);
+        setVi(e.s, it, static_cast<int16_t>(e.s.vi[it] - 1));
+        storeLanes(e, dataAddress(e, static_cast<uint16_t>(e.s.vi[it])), ld(e.s.vf[FS(i)]), DEST(i));
+    }
+    void hDiv(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float num = normOp(e.s.vf[FS(i)][(i >> 21) & 3u]);
+        const float den = normOp(e.s.vf[FT(i)][(i >> 23) & 3u]);
+        uint32_t di = 0u;
+        float result;
+        if (den == 0.0f)
+        {
+            di = num == 0.0f ? 0x10u : 0x20u;
+            result = std::signbit(num) != std::signbit(den) ? -std::numeric_limits<float>::max()
+                                                             : std::numeric_limits<float>::max();
+        }
+        else
+            result = num / den;
+        e.queueQ(normResult(result), 7u, di);
+    }
+    void hSqrt(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float value = normOp(e.s.vf[FT(i)][(i >> 23) & 3u]);
+        e.queueQ(std::sqrt(std::fabs(value)), 7u, value < 0.0f ? 0x10u : 0u);
+    }
+    void hRsqrt(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float num = normOp(e.s.vf[FS(i)][(i >> 21) & 3u]);
+        const float radicand = normOp(e.s.vf[FT(i)][(i >> 23) & 3u]);
+        const float den = std::sqrt(std::fabs(radicand));
+        uint32_t di = radicand < 0.0f ? 0x10u : 0u;
+        float result;
+        if (den != 0.0f)
+            result = num / den;
+        else
+        {
+            di = num == 0.0f ? 0x10u : 0x20u;
+            result = std::signbit(num) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+        }
+        e.queueQ(normResult(result), 13u, di);
+    }
+    void hMtir(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        uint32_t bits = 0;
+        std::memcpy(&bits, &e.s.vf[FS(i)][(i >> 21) & 3u], 4);
+        setVi(e.s, VIT(i), static_cast<int16_t>(bits & 0xFFFFu));
+    }
+    void hMfir(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const int32_t value = static_cast<int16_t>(e.s.vi[VIS(i)] & 0xFFFF);
+        float *target = e.s.vf[FT(i)];
+        st(target, blendDest(ld(target), _mm_castsi128_ps(_mm_set1_epi32(value)), DEST(i)));
+    }
+    void hIlwr(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint32_t address = dataAddress(e, static_cast<uint16_t>(e.s.vi[VIS(i)]));
+        if (address + 16u > e.dataSize)
+            return;
+        uint32_t v = 0;
+        std::memcpy(&v, e.data + address + destComponent(DEST(i)) * 4, 4);
+        setVi(e.s, VIT(i), static_cast<int16_t>(v & 0xFFFFu));
+    }
+    void hIswr(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const uint32_t address = dataAddress(e, static_cast<uint16_t>(e.s.vi[VIS(i)]));
+        const int32_t value = static_cast<int32_t>(static_cast<uint16_t>(e.s.vi[VIT(i)] & 0xFFFF));
+        storeLanes(e, address, _mm_castsi128_ps(_mm_set1_epi32(value)), DEST(i));
+    }
+    void writeBroadcast(VuFastEngine &e, uint32_t i, uint32_t bits)
+    {
+        float *target = e.s.vf[FT(i)];
+        st(target, blendDest(ld(target), _mm_castsi128_ps(_mm_set1_epi32(static_cast<int>(bits))), DEST(i)));
+    }
+    void hRnext(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t x = (e.s.r >> 4) & 1u;
+        const uint32_t y = (e.s.r >> 22) & 1u;
+        e.s.r = (((e.s.r << 1) ^ x ^ y) & 0x007FFFFFu) | 0x3F800000u;
+        writeBroadcast(e, p.lowerInstr, e.s.r);
+    }
+    void hRget(VuFastEngine &e, const Pair &p) { writeBroadcast(e, p.lowerInstr, e.s.r); }
+    void hRinit(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        uint32_t bits = 0u;
+        std::memcpy(&bits, &e.s.vf[FS(i)][(i >> 21) & 3u], sizeof(bits));
+        e.s.r = 0x3F800000u | (bits & 0x007FFFFFu);
+    }
+    void hRxor(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        uint32_t bits = 0u;
+        std::memcpy(&bits, &e.s.vf[FS(i)][(i >> 21) & 3u], sizeof(bits));
+        e.s.r = 0x3F800000u | ((e.s.r ^ bits) & 0x007FFFFFu);
+    }
+    void hMfp(VuFastEngine &e, const Pair &p)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &e.s.p, 4);
+        writeBroadcast(e, p.lowerInstr, bits);
+    }
+    void hXtop(VuFastEngine &e, const Pair &p) { setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>(e.s.top & 0x3FFu)); }
+    void hXitop(VuFastEngine &e, const Pair &p) { setVi(e.s, VIT(p.lowerInstr), static_cast<int32_t>(e.s.itop & 0x3FFu)); }
+    void hXgkick(VuFastEngine &e, const Pair &p) { e.kick(static_cast<uint16_t>(e.s.vi[VIS(p.lowerInstr)])); }
+
+    inline float vfx(VuFastEngine &e, uint32_t i, uint32_t c) { return normOp(e.s.vf[FS(i)][c]); }
+    void hEsadd(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float x = vfx(e, i, 0), y = vfx(e, i, 1), z = vfx(e, i, 2);
+        e.queueP(x * x + y * y + z * z, 11u);
+    }
+    void hErsadd(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float x = vfx(e, i, 0), y = vfx(e, i, 1), z = vfx(e, i, 2);
+        const float sum = x * x + y * y + z * z;
+        e.queueP(sum != 0.0f ? 1.0f / sum : sum, 18u);
+    }
+    void hEleng(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float x = vfx(e, i, 0), y = vfx(e, i, 1), z = vfx(e, i, 2);
+        e.queueP(std::sqrt(x * x + y * y + z * z), 18u);
+    }
+    void hErleng(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float x = vfx(e, i, 0), y = vfx(e, i, 1), z = vfx(e, i, 2);
+        const float len = std::sqrt(x * x + y * y + z * z);
+        e.queueP(len != 0.0f ? 1.0f / len : len, 24u);
+    }
+    void hEatanxy(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float x = vfx(e, i, 0), y = vfx(e, i, 1);
+        e.queueP(x != 0.0f ? vuEatan(y / x) : 0.0f, 54u);
+    }
+    void hEatanxz(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        const float x = vfx(e, i, 0), z = vfx(e, i, 2);
+        e.queueP(x != 0.0f ? vuEatan(z / x) : 0.0f, 54u);
+    }
+    void hEsum(VuFastEngine &e, const Pair &p)
+    {
+        const uint32_t i = p.lowerInstr;
+        float sum = 0.0f;
+        for (uint32_t c = 0; c < 4u; ++c)
+            sum += vfx(e, i, c);
+        e.queueP(sum, 12u);
+    }
+    inline float vfc(VuFastEngine &e, uint32_t i) { return normOp(e.s.vf[FS(i)][(i >> 21) & 3u]); }
+    void hErsqrt(VuFastEngine &e, const Pair &p)
+    {
+        float result = vfc(e, p.lowerInstr);
+        if (result >= 0.0f)
+        {
+            result = std::sqrt(result);
+            if (result != 0.0f)
+                result = 1.0f / result;
+        }
+        e.queueP(result, 18u);
+    }
+    void hEsqrt(VuFastEngine &e, const Pair &p)
+    {
+        const float value = vfc(e, p.lowerInstr);
+        e.queueP(value >= 0.0f ? std::sqrt(value) : value, 12u);
+    }
+    void hEsin(VuFastEngine &e, const Pair &p) { e.queueP(vuEsin(vfc(e, p.lowerInstr)), 29u); }
+    void hErcpr(VuFastEngine &e, const Pair &p)
+    {
+        const float value = vfc(e, p.lowerInstr);
+        e.queueP(value != 0.0f ? 1.0f / value : value, 12u);
+    }
+    void hEatan(VuFastEngine &e, const Pair &p) { e.queueP(vuEatan(vfc(e, p.lowerInstr)), 54u); }
+    void hEexp(VuFastEngine &e, const Pair &p) { e.queueP(vuEexp(vfc(e, p.lowerInstr)), 44u); }
+    void hReservedLower(VuFastEngine &e, const Pair &p) { e.reserved(false, p.lowerInstr); }
+
+    VuFastEngine::Handler selectLower(uint32_t instr, bool &readsPipelines)
+    {
+        readsPipelines = false;
+        if (instr == 0x00000000u || instr == 0x8000033Cu)
+            return &hNop;
+        const uint8_t opHi = static_cast<uint8_t>((instr >> 25) & 0x7Fu);
+        switch (opHi)
+        {
+        case 0x00: return &hLq;
+        case 0x01: return &hSq;
+        case 0x04: return &hIlw;
+        case 0x05: return &hIsw;
+        case 0x08: return &hIaddiu;
+        case 0x09: return &hIsubiu;
+        case 0x10: readsPipelines = true; return &hFceq;
+        case 0x11: return &hFcset;
+        case 0x12: readsPipelines = true; return &hFcand;
+        case 0x13: readsPipelines = true; return &hFcor;
+        case 0x14: readsPipelines = true; return &hFseq;
+        case 0x15: return &hFsset;
+        case 0x16: readsPipelines = true; return &hFsand;
+        case 0x17: readsPipelines = true; return &hFsor;
+        case 0x18: readsPipelines = true; return &hFmeq;
+        case 0x1A: readsPipelines = true; return &hFmand;
+        case 0x1B: readsPipelines = true; return &hFmor;
+        case 0x1C: readsPipelines = true; return &hFcget;
+        case 0x20: return &hB;
+        case 0x21: return &hBal;
+        case 0x24: return &hJr;
+        case 0x25: return &hJalr;
+        case 0x28: return &hCondBranch<0>;
+        case 0x29: return &hCondBranch<1>;
+        case 0x2C: return &hCondBranch<2>;
+        case 0x2D: return &hCondBranch<3>;
+        case 0x2E: return &hCondBranch<4>;
+        case 0x2F: return &hCondBranch<5>;
+        case 0x40:
+            break;
+        default:
+            return &hReservedLower;
+        }
+
+        switch (instr & 0x3Fu)
+        {
+        case 0x30: return &hIadd;
+        case 0x31: return &hIsub;
+        case 0x32: return &hIaddi;
+        case 0x34: return &hIand;
+        case 0x35: return &hIor;
+        case 0x3C: case 0x3D: case 0x3E: case 0x3F:
+            break;
+        default:
+            return &hReservedLower;
+        }
+
+        switch (static_cast<uint8_t>((instr & 0x3u) | ((instr >> 4) & 0x7Cu)))
+        {
+        case 0x30: return &hMove;
+        case 0x31: return &hMr32;
+        case 0x34: return &hLqi;
+        case 0x35: return &hSqi;
+        case 0x36: return &hLqd;
+        case 0x37: return &hSqd;
+        case 0x38: return &hDiv;
+        case 0x39: return &hSqrt;
+        case 0x3A: return &hRsqrt;
+        case 0x3B: return &hNop; // WAITQ (the wait is a stall)
+        case 0x3C: return &hMtir;
+        case 0x3D: return &hMfir;
+        case 0x3E: return &hIlwr;
+        case 0x3F: return &hIswr;
+        case 0x40: return &hRnext;
+        case 0x41: return &hRget;
+        case 0x42: return &hRinit;
+        case 0x43: return &hRxor;
+        case 0x64: readsPipelines = true; return &hMfp;
+        case 0x68: return &hXtop;
+        case 0x69: return &hXitop;
+        case 0x6C: return &hXgkick;
+        case 0x70: return &hEsadd;
+        case 0x71: return &hErsadd;
+        case 0x72: return &hEleng;
+        case 0x73: return &hErleng;
+        case 0x74: return &hEatanxy;
+        case 0x75: return &hEatanxz;
+        case 0x76: return &hEsum;
+        case 0x77: return &hErsqrt;
+        case 0x78: return &hEsqrt;
+        case 0x79: return &hEsin;
+        case 0x7A: return &hErcpr;
+        case 0x7B: return &hNop; // WAITP
+        case 0x7C: return &hEatan;
+        case 0x7D: return &hEexp;
+        default: return &hReservedLower;
+        }
+    }
+
+    bool fastEngineEnabled()
+    {
+        const char *env = std::getenv("PS2X_VU_FAST");
+        return !(env && env[0] == '0');
+    }
+}
