+struct GSCpuBackend::Sampler
+{
+    GSMem::TextureReader read = nullptr;
+    const uint8_t *vram = nullptr;
+    const uint16_t *clut = nullptr;
+    GSTexaReg texa{};
+    uint32_t tbp = 0, tbw = 0;
+    int texW = 1, texH = 1;
+    float fTexW = 1.0f, fTexH = 1.0f;
+    uint16_t minU = 0, maxU = 0, minV = 0, maxV = 0;
+    uint8_t psm = 0, cpsm = 0, csm = 0, csa = 0;
+    uint8_t wrapU = 0, wrapV = 0;
+    uint8_t kind = 0; // 0 none, 1 32/24-bit (+TEXA), 2 16-bit (+TEXA), 3 CLUT
+    bool linear = false;
+    bool fst = false;
+
+    uint32_t clutLookup(uint8_t index) const
+    {
+        const bool sixteenBit = cpsm == GS_PSM_CT16 || cpsm == GS_PSM_CT16S;
+        const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+        const uint32_t clutBase = (static_cast<uint32_t>(csa) & csaMask) << 4u;
+        const uint32_t sourceIndex = isFourBitIndexedPsm(psm) ? (static_cast<uint32_t>(index) & 0x0Fu)
+                                                              : static_cast<uint32_t>(index);
+        uint32_t clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+        if (!sixteenBit && csm == 0u && isEightBitIndexedPsm(psm))
+        {
+            const uint32_t block = std::min((sourceIndex & 0xF0u) + clutBase, 240u);
+            clutIndex = block + (sourceIndex & 0x0Fu);
+        }
+        switch (cpsm)
+        {
+        case GS_PSM_CT32:
+            return applyTexa(texa, cpsm, static_cast<uint32_t>(clut[clutIndex]) | (static_cast<uint32_t>(clut[clutIndex + 256u]) << 16u));
+        case GS_PSM_CT24:
+            return applyTexa(texa, cpsm, (static_cast<uint32_t>(clut[clutIndex]) | (static_cast<uint32_t>(clut[clutIndex + 256u]) << 16u)) & 0x00FFFFFFu);
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+            return applyTexa(texa, cpsm, Rgba5551ToRgba8888(clut[clutIndex]));
+        default:
+            return 0xFFFF00FFu;
+        }
+    }
+
+    uint32_t point(GSMem::TexturePageCache &cache, int u, int v) const
+    {
+        u = wrapTextureCoordinate(u, texW, wrapU, minU, maxU);
+        v = wrapTextureCoordinate(v, texH, wrapV, minV, maxV);
+        const uint32_t raw = read(cache, vram, tbp, tbw, static_cast<uint32_t>(u), static_cast<uint32_t>(v));
+        switch (kind)
+        {
+        case 1:
+            return applyTexa(texa, psm, raw);
+        case 2:
+            return applyTexa(texa, psm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+        case 3:
+            return clutLookup(static_cast<uint8_t>(raw));
+        default:
+            return 0xFFFF00FFu;
+        }
+    }
+
+    // SampleTexture with the state decoded in advance.
+    uint32_t sample(GSMem::TexturePageCache &cache, float s, float t, float q, uint16_t u, uint16_t v) const
+    {
+        float texUf, texVf;
+        if (fst)
+        {
+            texUf = static_cast<float>(u) / 16.0f;
+            texVf = static_cast<float>(v) / 16.0f;
+        }
+        else
+        {
+            const float invQ = 1.0f / fabsQ(q);
+            texUf = s * invQ * fTexW;
+            texVf = t * invQ * fTexH;
+        }
+        if (!linear)
+            return point(cache, static_cast<int>(texUf), static_cast<int>(texVf));
