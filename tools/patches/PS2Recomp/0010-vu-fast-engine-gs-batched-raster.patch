 void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
                          uint8_t *vuData, uint32_t dataSize,
                          GS &gs, PS2Memory *memory, uint32_t maxCycles)
+{
+    if (m_fast)
+    {
+        if (g_vuVerify)
+        {
+            runVerified(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+            return;
+        }
+        const uint64_t startCycle = m_cycle;
+        if (m_fast->run(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles))
+        {
+            recordVuRun(m_unit == Unit::VU1 ? 1 : 0, m_cycle - startCycle, m_fast->lastRunPairs());
+            return;
+        }
+    }
+    runInterpreter(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+}
+
+void VU1Interpreter::runVerified(uint8_t *vuCode, uint32_t codeSize,
+                                 uint8_t *vuData, uint32_t dataSize,
+                                 GS &gs, PS2Memory *memory, uint32_t maxCycles)
+{
+    if (!m_lastRunFinished || !m_fast->idle() || pipelinesPending())
+    {
+        runInterpreter(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+        return;
+    }
+
+    const VU1State before = m_state;
+    const uint64_t cycleBefore = m_cycle;
+    const uint32_t clipBefore = m_workingClip;
+    const bool backupValidBefore = m_viBranchBackupValid;
+    const int32_t backupValueBefore = m_viBranchBackupValue;
+    const uint8_t backupRegBefore = m_viBranchBackupReg;
+    const std::vector<uint8_t> dataBefore(vuData, vuData + dataSize);
+
+    std::vector<std::vector<uint8_t>> fastKicks;
+    m_kickCapture = &fastKicks;
+    const bool ran = m_fast->run(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+    m_kickCapture = nullptr;
+    if (!ran)
+    {
+        runInterpreter(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+        return;
+    }
+    const VU1State fastState = m_state;
+    const bool fastFinished = m_lastRunFinished;
+    const std::vector<uint8_t> fastData(vuData, vuData + dataSize);
+
+    m_state = before;
+    m_cycle = cycleBefore;
+    m_workingClip = clipBefore;
+    m_viBranchBackupValid = backupValidBefore;
+    m_viBranchBackupValue = backupValueBefore;
+    m_viBranchBackupReg = backupRegBefore;
+    std::memcpy(vuData, dataBefore.data(), dataSize);
+
+    std::vector<std::vector<uint8_t>> refKicks;
+    m_kickCapture = &refKicks;
+    runInterpreter(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+    m_kickCapture = nullptr;
+
+    std::string diff;
+    reportBits(diff, "vf", fastState.vf, m_state.vf, sizeof(m_state.vf));
+    reportBits(diff, "vi", fastState.vi, m_state.vi, sizeof(m_state.vi));
+    reportBits(diff, "acc", fastState.acc, m_state.acc, sizeof(m_state.acc));
+    reportBits(diff, "q", &fastState.q, &m_state.q, 4);
+    reportBits(diff, "p", &fastState.p, &m_state.p, 4);
+    reportBits(diff, "i", &fastState.i, &m_state.i, 4);
+    reportBits(diff, "r", &fastState.r, &m_state.r, 4);
+    reportBits(diff, "pc", &fastState.pc, &m_state.pc, 4);
+    reportBits(diff, "mac", &fastState.mac, &m_state.mac, 4);
+    reportBits(diff, "status", &fastState.status, &m_state.status, 4);
+    reportBits(diff, "clip", &fastState.clip, &m_state.clip, 4);
+    if (fastFinished != m_lastRunFinished)
+        diff += fastFinished ? " finished=fast-only;" : " finished=ref-only;";
+    if (std::memcmp(fastData.data(), vuData, dataSize) != 0)
+    {
+        uint32_t first = 0, count = 0;
+        for (uint32_t q = 0; q < dataSize; q += 16u)
+        {
+            if (std::memcmp(fastData.data() + q, vuData + q, 16u) != 0)
+            {
+                if (count++ == 0u)
+                    first = q;
+            }
+        }
+        char line[128];
+        std::snprintf(line, sizeof(line), " data: %u qwords differ, first at 0x%x;", count, first);
+        diff += line;
+    }
+    if (fastKicks != refKicks)
+    {
+        char line[128];
+        std::snprintf(line, sizeof(line), " xgkick: fast %zu packets, ref %zu;", fastKicks.size(), refKicks.size());
+        diff += line;
+    }
+
+    ++g_verifyCounters.runs;
+    if (!diff.empty())
+    {
+        ++g_verifyCounters.mismatches;
+        if (g_verifyCounters.reported < 60u)
+        {
+            ++g_verifyCounters.reported;
+            std::fprintf(stderr, "[vu-verify] VU%d start pc=0x%x:%s\n", m_unit == Unit::VU1 ? 1 : 0, before.pc,
+                         diff.substr(0, 1500).c_str());
+        }
+    }
+    if ((g_verifyCounters.runs % 5000u) == 0u)
+        std::fprintf(stderr, "[vu-verify] %llu runs, %llu with differences\n",
+                     static_cast<unsigned long long>(g_verifyCounters.runs),
+                     static_cast<unsigned long long>(g_verifyCounters.mismatches));
+
+    for (const std::vector<uint8_t> &packet : refKicks)
+        submitKick(packet.data(), static_cast<uint32_t>(packet.size()));
+    m_fast->reset();
+}
