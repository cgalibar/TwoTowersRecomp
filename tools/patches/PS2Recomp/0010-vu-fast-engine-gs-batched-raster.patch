+        const float sampleU = texUf - 0.5f;
+        const float sampleV = texVf - 0.5f;
+        const int u0 = static_cast<int>(std::floor(sampleU));
+        const int v0 = static_cast<int>(std::floor(sampleV));
+        const float fx = sampleU - static_cast<float>(u0);
+        const float fy = sampleV - static_cast<float>(v0);
+        const uint32_t wx = static_cast<uint32_t>(fx * 256.0f + 0.5f);
+        const uint32_t wy = static_cast<uint32_t>(fy * 256.0f + 0.5f);
+        // A tap with weight 0 does not change the result (lerp2(a, b, 0) == a): texel-aligned copies, the
+        // usual post-processing pass, read one texel instead of four.
+        const uint32_t c00 = point(cache, u0, v0);
+        const uint32_t c10 = wx != 0u ? point(cache, u0 + 1, v0) : 0u;
+        const uint32_t c01 = wy != 0u ? point(cache, u0, v0 + 1) : 0u;
+        const uint32_t c11 = (wx != 0u && wy != 0u) ? point(cache, u0 + 1, v0 + 1) : 0u;
+        if (wx == 0u && wy == 0u)
+            return c00;
+        constexpr uint32_t kMask = 0x00FF00FFu;
+        const auto lerp2 = [](uint32_t a, uint32_t b, uint32_t w) -> uint32_t
+        {
+            return (((a * (256u - w)) + (b * w) + 0x00800080u) >> 8) & kMask;
+        };
+        const uint32_t topRb = lerp2(c00 & kMask, c10 & kMask, wx);
+        const uint32_t topGa = lerp2((c00 >> 8) & kMask, (c10 >> 8) & kMask, wx);
+        const uint32_t bottomRb = lerp2(c01 & kMask, c11 & kMask, wx);
+        const uint32_t bottomGa = lerp2((c01 >> 8) & kMask, (c11 >> 8) & kMask, wx);
+        return lerp2(topRb, bottomRb, wy) | (lerp2(topGa, bottomGa, wy) << 8);
+    }
+};
