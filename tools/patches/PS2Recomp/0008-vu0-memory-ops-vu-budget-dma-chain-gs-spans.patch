+            return fmt::format("ctx->vi[{}] = static_cast<uint16_t>(ctx->vi[{}] {} 1); ", vi, vi, step > 0 ? '+' : '-');
+        }
+
+        // Byte offset of the single field a VILWR/VISWR dest mask selects (bit 3 = x ... bit 0 = w).
+        uint32_t vu0FieldOffset(uint8_t destMask)
+        {
+            for (uint32_t field = 0; field < 4u; ++field)
+            {
+                if (destMask & (0x8u >> field))
+                    return field * 4u;
+            }
+            return 0u;
+        }
+    }
