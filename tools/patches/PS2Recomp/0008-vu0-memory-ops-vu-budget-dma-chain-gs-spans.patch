+        // In macro mode the EE reaches VU0 data memory, 4 KiB at 0x11004000 addressed in quadwords.
+        std::string vu0DataAddress(uint8_t vi)
+        {
+            return fmt::format("0x11004000u + (((uint32_t)ctx->vi[{}] & 0xFFu) << 4)", vi);
+        }
+
+        // vi0 is hard-wired to zero: its post-increments and pre-decrements are dropped.
+        std::string vu0StepIndex(uint8_t vi, int step)
+        {
+            if (vi == 0)
