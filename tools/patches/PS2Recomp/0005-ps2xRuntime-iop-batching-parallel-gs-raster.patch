+template <typename RowsFn>
+void GSCpuBackend::ForEachRowBand(int firstRow, int lastRow, uint64_t area, RowsFn &&rows)
+{
+    constexpr uint64_t kMinParallelPixels = 4096u;
+    constexpr int kMinBandRows = 4;
+    const int rowCount = lastRow - firstRow + 1;
+    if (!m_rasterWorkers || area < kMinParallelPixels || rowCount < 2 * kMinBandRows)
+    {
+        rows(firstRow, lastRow, m_texturePageCache);
+        return;
+    }
+
+    // About four bands per thread, so the threads that finish early pick up the rest.
+    const int threads = static_cast<int>(m_rasterWorkers->workerCount()) + 1;
+    const int bandRows = std::max(kMinBandRows, (rowCount + threads * 4 - 1) / (threads * 4));
+    const unsigned bands = static_cast<unsigned>((rowCount + bandRows - 1) / bandRows);
+    auto band = [&](unsigned index, unsigned slot)
+    {
+        const int first = firstRow + static_cast<int>(index) * bandRows;
+        const int last = std::min(lastRow, first + bandRows - 1);
+        if (slot == 0u)
+        {
+            rows(first, last, m_texturePageCache);
+            return;
+        }
+        // A worker's page copy may predate what the previous primitives drew.
+        GSMem::TexturePageCache &cache = m_workerTextureCaches[slot - 1u];
+        cache.Invalidate();
+        rows(first, last, cache);
+    };
+    m_rasterWorkers->run(bands, band);
+}
