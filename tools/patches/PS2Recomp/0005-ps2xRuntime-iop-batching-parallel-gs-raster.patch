+// Fork-join workers for large primitives. run() hands bands out to the calling thread (slot 0) and to the
+// workers (slots 1..workerCount()) and returns once every band is drawn.
+class GSRasterWorkers
+{
+public:
+    explicit GSRasterWorkers(unsigned workerCount)
+    {
+        m_threads.reserve(workerCount);
+        for (unsigned slot = 1u; slot <= workerCount; ++slot)
+            m_threads.emplace_back([this, slot]()
+                                   { workerLoop(slot); });
+    }
+
+    ~GSRasterWorkers()
+    {
+        m_stop.store(true, std::memory_order_release);
+        m_work.fetch_add(kGenerationOne, std::memory_order_acq_rel);
+        m_work.notify_all();
+        for (std::thread &thread : m_threads)
+            thread.join();
+    }
+
+    unsigned workerCount() const
+    {
+        return static_cast<unsigned>(m_threads.size());
+    }
+
+    template <typename Job>
+    void run(unsigned bands, Job &job)
+    {
+        m_context = &job;
+        m_invoke = [](void *context, unsigned band, unsigned slot)
+        { (*static_cast<Job *>(context))(band, slot); };
+        m_remaining.store(bands, std::memory_order_relaxed);
+        const uint64_t generation = (m_work.load(std::memory_order_relaxed) & kGenerationMask) + kGenerationOne;
+        m_work.store(generation | (static_cast<uint64_t>(bands) << kCountShift), std::memory_order_release);
+        m_work.notify_all();
+
+        claimBands(0u);
+
+        uint32_t remaining = m_remaining.load(std::memory_order_acquire);
+        for (uint32_t spin = 0u; remaining != 0u && spin < kSpinIterations; ++spin)
+        {
+            cpuRelax();
+            remaining = m_remaining.load(std::memory_order_acquire);
+        }
+        while (remaining != 0u)
+        {
+            m_remaining.wait(remaining, std::memory_order_acquire);
+            remaining = m_remaining.load(std::memory_order_acquire);
+        }
+    }
+
+private:
+    // m_work packs the generation (bits 32-63), the band count (16-31) and the next unclaimed band (0-15).
+    // A band is claimed with a CAS on the whole word, so a late worker can never claim one of an older run.
+    static constexpr uint64_t kGenerationOne = 1ull << 32u;
+    static constexpr uint64_t kGenerationMask = ~(kGenerationOne - 1ull);
+    static constexpr unsigned kCountShift = 16u;
+    // Roughly 50 us of spinning before a thread sleeps: primitives come in bursts.
+    static constexpr uint32_t kSpinIterations = 4096u;
+
+    static bool hasUnclaimedBand(uint64_t work)
+    {
+        return (work & 0xFFFFu) < ((work >> kCountShift) & 0xFFFFu);
+    }
+
+    void claimBands(unsigned slot)
+    {
+        uint64_t work = m_work.load(std::memory_order_acquire);
+        while (hasUnclaimedBand(work))
+        {
+            if (!m_work.compare_exchange_weak(work, work + 1u, std::memory_order_acq_rel, std::memory_order_acquire))
+                continue;
+            m_invoke(m_context, static_cast<unsigned>(work & 0xFFFFu), slot);
+            if (m_remaining.fetch_sub(1u, std::memory_order_acq_rel) == 1u)
+                m_remaining.notify_all();
+            work = m_work.load(std::memory_order_acquire);
+        }
+    }
+
+    void workerLoop(unsigned slot)
+    {
+        for (;;)
+        {
+            claimBands(slot);
+            const uint64_t seen = m_work.load(std::memory_order_acquire);
+            if (m_stop.load(std::memory_order_acquire))
+                return;
+            if (hasUnclaimedBand(seen))
+                continue;
+            for (uint32_t spin = 0u; spin < kSpinIterations && m_work.load(std::memory_order_relaxed) == seen; ++spin)
+                cpuRelax();
+            m_work.wait(seen, std::memory_order_acquire);
+        }
+    }
+
+    std::vector<std::thread> m_threads;
+    std::atomic<uint64_t> m_work{0u};
+    std::atomic<uint32_t> m_remaining{0u};
+    std::atomic<bool> m_stop{false};
+    void (*m_invoke)(void *, unsigned, unsigned) = nullptr;
+    void *m_context = nullptr;
+};
