+// Port option: drop triangles with a vertex on the edge of the primitive coordinate space (X or Y exactly 0 or
+// 4095 and above). Games clamp vertices that project far off screen to those values, which bends the triangle
+// into a long streak across the screen. 0 = draw them (default), 1 = drop them. PS2X_GS_DROP_CLAMPED sets the
+// starting value (a game should leave it alone when the variable is set).
+inline int &GSDropClampedTriangles()
+{
+    static int mode = []
+    {
+        const char *value = std::getenv("PS2X_GS_DROP_CLAMPED");
+        return value ? std::atoi(value) : 0;
+    }();
+    return mode;
+}
+
+// Port presentation options (both off by default: the PS2 output).
+// Progressive: an interlaced field-mode display shows every line of the frame buffer on every VBlank instead of
+// the current field's lines doubled (PS2X_GS_PROGRESSIVE=0/1).
+// No deflicker: when circuit 2 shows the same buffer one line lower to be blended with circuit 1 (the PS2 flicker
+// filter for TVs), circuit 1 is shown alone (PS2X_GS_DEFLICKER=0 drops the filter, 1 keeps it).
+struct GSPresentOptions
+{
+    bool progressive = false;
+    bool noDeflicker = false;
+};
+
+inline GSPresentOptions &GSPresentation()
+{
+    static GSPresentOptions options = []
+    {
+        GSPresentOptions o;
+        if (const char *value = std::getenv("PS2X_GS_PROGRESSIVE"))
+            o.progressive = value[0] == '1';
+        if (const char *value = std::getenv("PS2X_GS_DEFLICKER"))
+            o.noDeflicker = value[0] == '0';
+        return o;
+    }();
+    return options;
+}
+
+inline bool GSIsClampedTriangle(const GSPrimitiveBatch &batch)
+{
+    if (batch.vertexCount != 3u)
+        return false;
+    for (const GSVertex &v : batch.vertices)
+        if (v.x == 0.0f || v.y == 0.0f || v.x >= 4095.0f || v.y >= 4095.0f)
+            return true;
+    return false;
+}
