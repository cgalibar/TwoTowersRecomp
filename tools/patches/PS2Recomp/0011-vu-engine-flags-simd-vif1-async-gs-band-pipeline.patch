index 0000000..7a1bf05
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vif1_worker.cpp
@@ -0,0 +1,209 @@
+#include "runtime/ps2_vif1_worker.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <exception>
+
+#if defined(_M_X64) || defined(__x86_64__)
+#include <immintrin.h>
+#endif
+
+namespace ps2x
+{
+    namespace
+    {
+        thread_local bool t_onVif1Worker = false;
+        std::atomic<Vif1Worker *> g_activeWorker{nullptr};
+
+        // PS2X_VIF1_STATS=1: once per second, how many syncs had to wait and for how long, by reason, and
+        // how busy the worker was.
+        const bool g_stats = []
+        {
+            const char *env = std::getenv("PS2X_VIF1_STATS");
+            return env && env[0] == '1';
+        }();
+        std::atomic<uint64_t> g_waits[Vif1Worker::SyncReasonCount]{};
+        std::atomic<uint64_t> g_waitNs[Vif1Worker::SyncReasonCount]{};
+        std::atomic<uint64_t> g_calls[Vif1Worker::SyncReasonCount]{};
+        std::atomic<uint64_t> g_workNs{0};
+        std::atomic<uint64_t> g_partNs[2]{};
+        std::atomic<uint64_t> g_items{0};
+        std::chrono::steady_clock::time_point g_statsLast = std::chrono::steady_clock::now();
+        std::mutex g_statsMutex;
+
+        void reportStats()
+        {
+            std::lock_guard<std::mutex> lock(g_statsMutex);
+            const auto now = std::chrono::steady_clock::now();
+            const double seconds = std::chrono::duration<double>(now - g_statsLast).count();
+            if (seconds < 1.0)
+                return;
+            g_statsLast = now;
+            static const char *names[] = {"gifvif", "vu1mem", "gspriv", "gifchan", "gsfront", "path3", "other"};
+            char line[512];
+            int len = std::snprintf(line, sizeof(line), "[vif1-stats] %.1fs worker=%.0f%% (vu1 %.0f%%, gs %.0f%%) items=%llu waits:", seconds,
+                                    100.0 * static_cast<double>(g_workNs.exchange(0)) / (seconds * 1e9),
+                                    100.0 * static_cast<double>(g_partNs[0].exchange(0)) / (seconds * 1e9),
+                                    100.0 * static_cast<double>(g_partNs[1].exchange(0)) / (seconds * 1e9),
+                                    static_cast<unsigned long long>(g_items.exchange(0)));
+            for (uint32_t r = 0; r < Vif1Worker::SyncReasonCount; ++r)
+            {
+                const uint64_t calls = g_calls[r].exchange(0);
+                const uint64_t waits = g_waits[r].exchange(0);
+                const uint64_t ns = g_waitNs[r].exchange(0);
+                if (calls != 0u)
+                    len += std::snprintf(line + len, sizeof(line) - static_cast<size_t>(len), " %s=%llu/%llu(%.0fms)", names[r],
+                                         static_cast<unsigned long long>(waits), static_cast<unsigned long long>(calls),
+                                         static_cast<double>(ns) / 1e6);
+            }
+            std::fprintf(stderr, "%s\n", line);
+        }
+
+        void relax()
+        {
+#if defined(_M_X64) || defined(__x86_64__)
+            _mm_pause();
+#else
+            std::this_thread::yield();
+#endif
+        }
+    }
+
+    Vif1Worker::Vif1Worker(Process process)
+        : m_process(std::move(process))
+    {
+        m_thread = std::thread([this]()
+                               { run(); });
+    }
+
+    Vif1Worker::~Vif1Worker()
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stop = true;
+        }
+        m_workReady.notify_all();
+        if (m_thread.joinable())
+            m_thread.join();
+    }
+
+    bool Vif1Worker::onWorkerThread()
+    {
+        return t_onVif1Worker;
+    }
+
+    void Vif1Worker::enqueue(std::vector<uint8_t> &&data)
+    {
+        if (data.empty())
+            return;
+        m_pending.fetch_add(1u, std::memory_order_acq_rel);
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_queue.push_back(std::move(data));
+        }
+        m_workReady.notify_one();
+    }
+
+    void Vif1Worker::sync(SyncReason reason)
+    {
+        if (t_onVif1Worker)
+            return;
+        if (g_stats)
+        {
+            g_calls[reason].fetch_add(1, std::memory_order_relaxed);
+            if (m_pending.load(std::memory_order_acquire) != 0u)
+            {
+                const auto start = std::chrono::steady_clock::now();
+                g_waits[reason].fetch_add(1, std::memory_order_relaxed);
+                for (uint32_t spin = 0; spin < 2048u && m_pending.load(std::memory_order_acquire) != 0u; ++spin)
+                    relax();
+                if (m_pending.load(std::memory_order_acquire) != 0u)
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_idle.wait(lock, [this]()
+                                { return m_pending.load(std::memory_order_acquire) == 0u; });
+                }
+                g_waitNs[reason].fetch_add(
+                    static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count()),
+                    std::memory_order_relaxed);
+            }
+            reportStats();
+            return;
+        }
+        // Most waits are short: spin a little before sleeping.
+        for (uint32_t spin = 0; spin < 2048u; ++spin)
+        {
+            if (m_pending.load(std::memory_order_acquire) == 0u)
+                return;
+            relax();
+        }
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_idle.wait(lock, [this]()
+                    { return m_pending.load(std::memory_order_acquire) == 0u; });
+    }
+
+    void Vif1Worker::run()
+    {
+        t_onVif1Worker = true;
+        for (;;)
+        {
+            std::vector<uint8_t> item;
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_workReady.wait(lock, [this]()
+                                 { return m_stop || !m_queue.empty(); });
+                if (m_queue.empty())
+                    return;
+                item = std::move(m_queue.front());
+                m_queue.pop_front();
+            }
+            const auto workStart = g_stats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+            try
+            {
+                m_process(item.data(), static_cast<uint32_t>(item.size()));
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, "[vif1-worker] %s\n", e.what());
+            }
+            catch (...)
+            {
+                std::fprintf(stderr, "[vif1-worker] unknown exception\n");
+            }
+            if (g_stats)
+            {
+                g_workNs.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                                             std::chrono::steady_clock::now() - workStart)
+                                                             .count()),
+                                   std::memory_order_relaxed);
+                g_items.fetch_add(1, std::memory_order_relaxed);
+            }
+            if (m_pending.fetch_sub(1u, std::memory_order_acq_rel) == 1u)
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_idle.notify_all();
+            }
+        }
+    }
+
+    bool vif1StatsEnabled() { return g_stats; }
+
+    void vif1StatsAddPart(uint32_t part, uint64_t ns)
+    {
+        if (part < 2u && t_onVif1Worker)
+            g_partNs[part].fetch_add(ns, std::memory_order_relaxed);
+    }
+
+    void setActiveVif1Worker(Vif1Worker *worker)
+    {
+        g_activeWorker.store(worker, std::memory_order_release);
+    }
+
+    void syncVif1Worker(Vif1Worker::SyncReason reason)
+    {
+        Vif1Worker *worker = g_activeWorker.load(std::memory_order_acquire);
+        if (worker && !t_onVif1Worker && (worker->busy() || g_stats))
+            worker->sync(reason);
+    }
+}
