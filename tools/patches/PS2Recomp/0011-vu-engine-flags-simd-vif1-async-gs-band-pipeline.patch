+// Persistent band workers for batches of primitives. Worker k owns the 8-row bands b with b % workers == k
+// and draws every published batch, in order, over its own bands; the GS thread publishes and goes on. There
+// is no barrier between batches: the GS thread only waits when a slot is still in use or when it needs
+// every batch drawn (VRAM reads and writes, CLUT, TEXFLUSH...).
+class GSBandPipeline
+{
+public:
+    using DrawFn = std::function<void(const std::vector<GSPrimitiveBatch> &, unsigned phase, unsigned stride)>;
+
+    GSBandPipeline(unsigned workers, DrawFn draw)
+        : m_draw(std::move(draw)), m_workers(workers), m_done(new std::atomic<uint64_t>[workers])
+    {
+        for (unsigned k = 0; k < workers; ++k)
+            m_done[k].store(0u, std::memory_order_relaxed);
+        m_threads.reserve(workers);
+        for (unsigned k = 0; k < workers; ++k)
+            m_threads.emplace_back([this, k]()
+                                   { workerLoop(k); });
+    }
+
+    ~GSBandPipeline()
+    {
+        waitAll();
+        m_stop.store(true, std::memory_order_release);
+        m_published.fetch_add(0u, std::memory_order_release);
+        m_wake.fetch_add(1u, std::memory_order_acq_rel);
+        m_wake.notify_all();
+        for (std::thread &thread : m_threads)
+            thread.join();
+    }
+
+    unsigned workerCount() const { return m_workers; }
+
+    // Takes the primitives (swapping in an empty vector with the slot's old capacity).
+    void publish(std::vector<GSPrimitiveBatch> &batch)
+    {
+        const uint64_t published = m_published.load(std::memory_order_relaxed);
+        waitUntil([&]()
+                  { return published - minDone() < kSlots; });
+        std::vector<GSPrimitiveBatch> &slot = m_slots[published % kSlots];
+        slot.swap(batch);
+        batch.clear();
+        m_published.store(published + 1u, std::memory_order_release);
+        m_wake.fetch_add(1u, std::memory_order_acq_rel);
+        m_wake.notify_all();
+    }
+
+    void waitAll()
+    {
+        const uint64_t target = m_published.load(std::memory_order_relaxed);
+        waitUntil([&]()
+                  { return minDone() >= target; });
+    }
+
+private:
+    static constexpr uint64_t kSlots = 8u;
+    static constexpr uint32_t kSpinIterations = 4096u;
+
+    uint64_t minDone() const
+    {
+        uint64_t lowest = ~0ull;
+        for (unsigned k = 0; k < m_workers; ++k)
+            lowest = std::min(lowest, m_done[k].load(std::memory_order_acquire));
+        return lowest;
+    }
+
+    template <typename Pred>
+    void waitUntil(Pred &&ready)
+    {
+        for (uint32_t spin = 0u; spin < kSpinIterations; ++spin)
+        {
+            if (ready())
+                return;
+            cpuRelax();
+        }
+        for (;;)
+        {
+            const uint32_t progress = m_progress.load(std::memory_order_acquire);
+            if (ready())
+                return;
+            m_progress.wait(progress, std::memory_order_acquire);
+        }
+    }
+
+    void workerLoop(unsigned k)
+    {
+        const unsigned stride = m_workers;
+        uint64_t next = 0u;
+        for (;;)
+        {
+            if (next < m_published.load(std::memory_order_acquire))
+            {
+                m_draw(m_slots[next % kSlots], k, stride);
+                ++next;
+                m_done[k].store(next, std::memory_order_release);
+                m_progress.fetch_add(1u, std::memory_order_acq_rel);
+                m_progress.notify_all();
+                continue;
+            }
+            if (m_stop.load(std::memory_order_acquire))
+                return;
+            const uint32_t wake = m_wake.load(std::memory_order_acquire);
+            bool more = false;
+            for (uint32_t spin = 0u; spin < kSpinIterations; ++spin)
+            {
+                if (next < m_published.load(std::memory_order_acquire) || m_stop.load(std::memory_order_acquire))
+                {
+                    more = true;
+                    break;
+                }
+                cpuRelax();
+            }
+            if (!more && next >= m_published.load(std::memory_order_acquire))
+                m_wake.wait(wake, std::memory_order_acquire);
+        }
+    }
+
+    DrawFn m_draw;
+    std::vector<GSPrimitiveBatch> m_slots[kSlots];
+    std::atomic<uint64_t> m_published{0u};
+    const unsigned m_workers;
+    std::unique_ptr<std::atomic<uint64_t>[]> m_done;
+    std::atomic<uint32_t> m_progress{0u};
+    std::atomic<uint32_t> m_wake{0u};
+    std::atomic<bool> m_stop{false};
+    std::vector<std::thread> m_threads;
+};
