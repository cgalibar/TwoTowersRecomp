+void VuFastEngine::rebaseReadiness(uint64_t now)
+{
+    if (now < m_readyBase)
+    {
+        // The unit's cycle counter went back (reset): nothing is pending any more.
+        std::memset(m_vfReady, 0, sizeof(m_vfReady));
+        std::memset(m_accReady, 0, sizeof(m_accReady));
+        std::memset(m_viReady, 0, sizeof(m_viReady));
+        m_readyBase = now;
+        return;
+    }
+    const uint64_t delta64 = now - m_readyBase;
+    if (delta64 < 0x40000000ull)
+        return;
+    const uint32_t delta = delta64 >= 0xFFFFFFFFull ? 0xFFFFFFFFu : static_cast<uint32_t>(delta64);
+    auto shift = [delta](uint32_t value) { return value > delta ? value - delta : 0u; };
+    for (auto &reg : m_vfReady)
+        for (uint32_t &lane : reg)
+            lane = shift(lane);
+    for (uint32_t &lane : m_accReady)
+        lane = shift(lane);
+    for (uint32_t &reg : m_viReady)
+        reg = shift(reg);
+    m_readyBase = now;
 }
 
