+namespace ps2x
+{
+    // Runs the VIF1 data stream (UNPACK, MPG, MSCAL into VU1, DIRECT and XGKICK into the GS) on its own
+    // thread, in submission order, as VIF1/VU1 run alongside the EE on the console. The DMA controller has
+    // already copied the transfer when it is queued, so the worker never reads EE memory.
+    //
+    // Anything else that reads or writes what the worker changes (VIF1/GIF/GS registers, VU1 memory, the GS
+    // itself, PATH3 transfers) first calls syncVif1Worker(), which waits until the queue is empty.
+    class Vif1Worker
+    {
+    public:
+        using Process = std::function<void(const uint8_t *, uint32_t)>;
+
+        explicit Vif1Worker(Process process);
+        ~Vif1Worker();
+
+        Vif1Worker(const Vif1Worker &) = delete;
+        Vif1Worker &operator=(const Vif1Worker &) = delete;
+
+        void enqueue(std::vector<uint8_t> &&data);
+        // Why a sync waited (PS2X_VIF1_STATS).
+        enum SyncReason : uint32_t
+        {
+            SyncGifVifRegs,
+            SyncVu1Memory,
+            SyncGsPrivRegs,
+            SyncGifChannel,
+            SyncGsFrontend,
+            SyncPath3,
+            SyncOther,
+            SyncReasonCount
+        };
+
+        // Waits until everything queued so far has been processed. No-op on the worker thread.
+        void sync(SyncReason reason = SyncOther);
+        bool busy() const { return m_pending.load(std::memory_order_acquire) != 0u; }
+
+        static bool onWorkerThread();
+
+    private:
+        void run();
+
+        Process m_process;
+        std::mutex m_mutex;
+        std::condition_variable m_workReady;
+        std::condition_variable m_idle;
+        std::deque<std::vector<uint8_t>> m_queue;
+        std::atomic<uint32_t> m_pending{0u};
+        bool m_stop = false;
+        std::thread m_thread;
+    };
+
+    // The worker that GS and memory accesses must wait for (null when VIF1 runs inline).
+    void setActiveVif1Worker(Vif1Worker *worker);
+    // PS2X_VIF1_STATS: time the worker spends in a part of its work (0 = VU1 microprograms, 1 = GS submission).
+    bool vif1StatsEnabled();
+    void vif1StatsAddPart(uint32_t part, uint64_t ns);
+
+    // Waits for the active worker unless called from it or it is idle.
+    void syncVif1Worker(Vif1Worker::SyncReason reason = Vif1Worker::SyncGsFrontend);
+}
