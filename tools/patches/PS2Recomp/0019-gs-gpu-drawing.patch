+PresentationFrame GSGpuBackend::Present(const GSPresentationRequest &request)
+{
+    // The CPU presentation reads a host copy of VRAM (only the displayed pages could be read back; the whole
+    // VRAM for now).
+    DrawBatch(kEndSync);
+    static const bool skip = []
+    {
+        const char *env = std::getenv("PS2X_GS_GPU_NO_PRESENT");
+        return env && env[0] == '1';
+    }();
+    if (skip)
+        return {};
+    if (m_synchronousPresent)
+    {
+        m_gpu->Barrier();
+        m_gpu->Download(m_vram, 0, GSMem::MEMORY_SIZE, m_host.data());
+        return m_cpu->Present(request);
+    }
+    // Copy the displayed pages to a readback buffer behind everything queued; the frame is made from them
+    // once the copy is done (usually by the next presentation).
+    CollectReadbacks(false);
+    Readback &slot = m_readbacks[m_readbackNext];
+    if (slot.fence)
+        CollectReadbacks(true);
+    if (!slot.buffer)
+        slot.buffer = m_gpu->CreateReadbackBuffer(GSMem::MEMORY_SIZE);
+    slot.request = request;
+    slot.pages = GSCpuBackend::PresentationPages(request);
+    for (uint32_t page = 0; page < 512u;)
+    {
+        if (!slot.pages.test(page))
+        {
+            ++page;
+            continue;
+        }
+        uint32_t end = page + 1u;
+        while (end < 512u && slot.pages.test(end))
+            ++end;
+        m_gpu->CopyBuffer(m_vram, static_cast<size_t>(page) * 8192u, slot.buffer, static_cast<size_t>(page) * 8192u,
+                          static_cast<size_t>(end - page) * 8192u);
+        page = end;
+    }
+    slot.fence = m_gpu->Fence();
+    m_readbackNext = (m_readbackNext + 1u) % static_cast<uint32_t>(m_readbacks.size());
+    return m_lastFrame;
+}
+
+void GSGpuBackend::CollectReadbacks(bool wait)
+{
+    // Oldest first: the slot after the last one used.
+    for (uint32_t i = 0; i < m_readbacks.size(); ++i)
+    {
+        Readback &slot = m_readbacks[(m_readbackNext + i) % m_readbacks.size()];
+        if (!slot.fence)
+            continue;
+        if (!m_gpu->WaitFence(slot.fence, wait ? ~0ull : 0ull))
+            return;
+        m_gpu->DeleteFence(slot.fence);
+        slot.fence = nullptr;
+        for (uint32_t page = 0; page < 512u;)
+        {
+            if (!slot.pages.test(page))
+            {
+                ++page;
+                continue;
+            }
+            uint32_t end = page + 1u;
+            while (end < 512u && slot.pages.test(end))
+                ++end;
+            m_gpu->ReadBuffer(slot.buffer, static_cast<size_t>(page) * 8192u, static_cast<size_t>(end - page) * 8192u,
+                              m_host.data() + static_cast<size_t>(page) * 8192u);
+            page = end;
+        }
+        m_lastFrame = m_cpu->Present(slot.request);
+    }
+}
