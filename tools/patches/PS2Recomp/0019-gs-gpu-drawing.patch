+uint32_t GSGpuBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    GSGpuBackend *self = const_cast<GSGpuBackend *>(this);
+    uint32_t value = 0u;
+    self->Fallback(false, [&]()
+                   { value = self->m_cpu->ReadVram(psm, base, bw, x, y); });
+    return value;
+}
+
+void GSGpuBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    Fallback(true, [&]()
+             { m_cpu->WriteVram(psm, base, bw, x, y, value); });
+}
+
+void GSGpuBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    const_cast<GSGpuBackend *>(this)->ReadVramAll(out);
+}
+
+GSTransferSnapshot GSGpuBackend::GetTransferSnapshot() const
+{
+    GSTransferSnapshot snapshot = m_cpu->GetTransferSnapshot();
+    if (m_uploadActive)
+    {
+        const uint32_t rrw = std::max<uint32_t>(m_transfer.trxreg.rrw, 1u);
+        snapshot.direction = 0u;
+        snapshot.totalPixels = m_total;
+        snapshot.copiedPixels = m_copied;
+        snapshot.x = m_transfer.trxpos.dsax + m_copied % rrw;
+        snapshot.y = m_transfer.trxpos.dsay + m_copied / rrw;
+    }
+    return snapshot;
 }
