diff --git a/ps2xRuntime/src/lib/gs/gs_gpu_shaders.inc b/ps2xRuntime/src/lib/gs/gs_gpu_shaders.inc
new file mode 100644
index 0000000..079605a
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_gpu_shaders.inc
@@ -0,0 +1,762 @@
+// GLSL sources of GSGpuBackend (included by gs_gpu_backend.cpp). Every function here is a translation of the
+// GSCpuBackend code named in its comment, with the same operations in the same order: `precise` keeps float
+// expressions unfused, divisions that the CPU does per pixel are correctly rounded (divRN), Z is interpolated
+// in double, and float-to-int conversions behave like x86's truncating ones.
+
+// ---- shared by every kernel --------------------------------------------------------------------------------
+static const char *const kGpuCommonGlsl = R"GLSL(
+layout(std430, binding = 0) buffer Vram { uint vram[]; };
+layout(std430, binding = 1) readonly buffer Swizzle { uint sw[]; };
+
+// GSSwizzle::AddressFast for the layout whose tables start at word `tables`.
+uint swAddress(uint tables, uint base, uint rowStride, uint x, uint y)
+{
+    uint pageHShift = sw[tables + 1u];
+    uint pageHMask = sw[tables + 2u];
+    uint periodMask = sw[tables + 3u];
+    uint inPage = y & pageHMask;
+    return base + (y >> pageHShift) * rowStride + sw[tables + 8u + inPage] +
+           sw[tables + 8u + 128u + (inPage & periodMask) * 2048u + (x & 2047u)];
+}
+
+// bits [shift, shift + width) of the byte at `byteAddress` = value; other threads may write the other bits
+// of the same word at the same time.
+void writeBits(uint byteAddress, uint shift, uint width, uint value)
+{
+    uint word = byteAddress >> 2u;
+    uint bitShift = (byteAddress & 3u) * 8u + shift;
+    uint mask = (width == 32u ? 0xFFFFFFFFu : ((1u << width) - 1u)) << bitShift;
+    atomicAnd(vram[word], ~mask);
+    atomicOr(vram[word], (value << bitShift) & mask);
+}
+)GLSL";
+
+// ---- host-to-local transfers (UploadImageUnlocked) ----------------------------------------------------------
+// Every chunk queued since the last dispatch at once: one workgroup per 256 pixels of a chunk. Chunks of one
+// dispatch never write the same pages, unless they are consecutive chunks of one transfer (other pixels).
+static const char *const kGpuUploadGlsl = R"GLSL(
+layout(local_size_x = 256) in;
+layout(std430, binding = 2) readonly buffer Data { uint data[]; };
+layout(std430, binding = 3) readonly buffer Chunks { uint chunk[]; }; // UPLOAD_CHUNK_WORDS per chunk
+layout(std430, binding = 4) readonly buffer Groups { uint group[]; };  // per workgroup: chunk, first pixel
+const uint UPLOAD_CHUNK_WORDS = 10u;
+
+uint dataOffset;
+uint dataByte(uint i) { i += dataOffset; return (data[i >> 2u] >> ((i & 3u) * 8u)) & 0xFFu; }
+
+void main()
+{
+    uint at = group[2u * gl_WorkGroupID.x] * UPLOAD_CHUNK_WORDS;
+    uint k = group[2u * gl_WorkGroupID.x + 1u] + gl_LocalInvocationID.x;
+    uint tables = chunk[at], base = chunk[at + 1u], rowStride = chunk[at + 2u], kind = chunk[at + 3u];
+    uint dsax = chunk[at + 4u], dsay = chunk[at + 5u], rrw = chunk[at + 6u], first = chunk[at + 7u], count = chunk[at + 8u];
+    dataOffset = chunk[at + 9u];
+    if (k >= count)
+        return;
+    uint g = first + k;
+    uint x = dsax + g % rrw;
+    uint y = dsay + g / rrw;
+    uint pixel = swAddress(tables, base, rowStride, x, y);
+    if (kind == 1u)
+    {
+        vram[pixel & 0xFFFFFu] = dataByte(4u * k) | (dataByte(4u * k + 1u) << 8u) | (dataByte(4u * k + 2u) << 16u) |
+                                 (dataByte(4u * k + 3u) << 24u);
+    }
+    else if (kind == 2u)
+    {
+        uint value = dataByte(3u * k) | (dataByte(3u * k + 1u) << 8u) | (dataByte(3u * k + 2u) << 16u);
+        uint word = pixel & 0xFFFFFu;
+        vram[word] = (vram[word] & 0xFF000000u) | value;
+    }
+    else if (kind == 3u)
+        writeBits((pixel * 2u) & 0x3FFFFEu, 0u, 16u, dataByte(2u * k) | (dataByte(2u * k + 1u) << 8u));
+    else if (kind == 4u)
+        writeBits(pixel & 0x3FFFFFu, 0u, 8u, dataByte(k));
+    else if (kind == 6u)
+        writeBits((pixel * 4u + 3u) & 0x3FFFFFu, 0u, 8u, dataByte(k));
+    else
+    {
+        uint nibble = (dataByte(k >> 1u) >> ((k & 1u) * 4u)) & 0xFu;
+        if (kind == 5u)
+            writeBits((pixel >> 1u) & 0x3FFFFFu, (pixel & 1u) * 4u, 4u, nibble);
+        else
+            writeBits((pixel * 4u + 3u) & 0x3FFFFFu, kind == 8u ? 4u : 0u, 4u, nibble);
+    }
+}
+)GLSL";
+
+// ---- texture page snapshots: pages[i] of VRAM copied to the snapshot area -----------------------------------
+static const char *const kGpuCopyGlsl = R"GLSL(
+layout(local_size_x = 256) in;
+layout(std430, binding = 2) readonly buffer Pages { uint pages[]; }; // pairs: source page, destination word
+uniform uint count;
+void main()
+{
+    uint i = gl_WorkGroupID.x;
+    if (i >= count)
+        return;
+    uint source = pages[2u * i] * 2048u;
+    uint target = pages[2u * i + 1u];
+    for (uint w = gl_LocalInvocationID.x; w < 2048u; w += 256u)
+        vram[target + w] = vram[source + w];
+}
+)GLSL";
+
+// ---- CLUT loads (LoadClutUnlocked): instance `target` = instance `source` with the loaded entries -----------
+static const char *const kGpuClutGlsl = R"GLSL(
+layout(local_size_x = 256) in;
+layout(std430, binding = 2) buffer Cluts { uint clut[]; };
+uniform uint source;
+uniform uint target;
+uniform uint tables;      // layout of CPSM
+uniform uint base;        // GSSwizzle::Base(CBP)
+uniform uint rowStride;   // GSSwizzle::RowStride(width)
+uniform uint cpsmKind;    // 1 32-bit, 2 24-bit, 3 16-bit
+uniform uint firstEntry;
+uniform uint entryCount;
+uniform uint csm2;
+uniform uint cou;
+uniform uint cov;
+uniform uint destinationBase;
+uniform uint suffix;      // loadCsm1Suffix
+shared uint entries[512];
+
+uint swizzleCsm1(uint index) { return (index & ~0x18u) | ((index & 0x08u) << 1u) | ((index & 0x10u) >> 1u); }
+
+void main()
+{
+    uint t = gl_LocalInvocationID.x;
+    uint word = clut[source * 256u + t];
+    entries[2u * t] = word & 0xFFFFu;
+    entries[2u * t + 1u] = word >> 16u;
+    barrier();
+    uint entry = firstEntry + t;
+    if (entry < entryCount)
+    {
+        uint sx, sy;
+        if (csm2 == 0u)
+        {
+            uint sourceIndex = swizzleCsm1(entry);
+            sx = sourceIndex & 0x0Fu;
+            sy = sourceIndex >> 4u;
+        }
+        else
+        {
+            sx = (cou << 4u) + entry;
+            sy = cov;
+        }
+        uint pixel = swAddress(tables, base, rowStride, sx, sy);
+        uint raw;
+        if (cpsmKind == 3u)
+        {
+            uint byteAddress = (pixel * 2u) & 0x3FFFFEu;
+            raw = (vram[byteAddress >> 2u] >> ((byteAddress & 2u) * 8u)) & 0xFFFFu;
+        }
+        else
+        {
+            raw = vram[pixel & 0xFFFFFu];
+            if (cpsmKind == 2u)
+                raw &= 0x00FFFFFFu;
+        }
+        uint destination = (suffix != 0u ? entry : destinationBase + entry) & (cpsmKind == 3u ? 0x1FFu : 0x0FFu);
+        if (cpsmKind == 3u)
+            entries[destination] = raw;
+        else
+        {
+            entries[destination] = raw & 0xFFFFu;
+            entries[destination + 256u] = raw >> 16u;
+        }
+    }
+    barrier();
+    clut[target * 256u + t] = entries[2u * t] | (entries[2u * t + 1u] << 16u);
+}
+)GLSL";
+
+// ---- triangles and sprites ---------------------------------------------------------------------------------
+static const char *const kGpuRasterGlsl = R"GLSL(
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(std430, binding = 2) readonly buffer Prims { uint prim[]; };
+layout(std430, binding = 3) readonly buffer Tiles { uint tileInfo[]; }; // origin, first, count
+layout(std430, binding = 4) readonly buffer Lists { uint list[]; };
+layout(std430, binding = 5) readonly buffer PageMap { uint pageMap[]; }; // word offset of each texture page
+layout(std430, binding = 6) readonly buffer Cluts { uint clut[]; };
+
+const uint PRIM_WORDS = 64u;
+
+// x86 cvttss2si: out of range or NaN gives 0x80000000.
+int toInt(precise float f)
+{
+    if (isnan(f) || f < -2147483648.0 || f >= 2147483648.0)
+        return int(0x80000000u);
+    return int(f);
+}
+int clampU8(int v) { return clamp(v, 0, 255); }
+
+// a / b rounded to nearest (GLSL's division is approximate).
+float divRN(float a, float b)
+{
+    if (b == 0.0 || isinf(b) || isnan(b) || isinf(a) || isnan(a) || a == 0.0)
+        return a / b;
+    precise float r = 1.0 / b;
+    precise float q = a * r;
+    precise float e = fma(-q, b, a);
+    precise float q1 = fma(e, r, q);
+    precise float e1 = fma(-q1, b, a);
+    precise float q2 = fma(e1, r, q1);
+    // q2 is within an ulp: pick whichever neighbour leaves the smallest residual.
+    precise float up = uintBitsToFloat(floatBitsToUint(q2) + 1u);
+    precise float down = uintBitsToFloat(floatBitsToUint(q2) - 1u);
+    precise float rq = abs(fma(-q2, b, a));
+    precise float ru = abs(fma(-up, b, a));
+    precise float rd = abs(fma(-down, b, a));
+    if (ru < rq)
+        return up;
+    if (rd < rq)
+        return down;
+    return q2;
+}
+
+float fl(uint p, uint i) { return uintBitsToFloat(prim[p + i]); }
+uint field(uint v, uint shift, uint bits) { return (v >> shift) & ((1u << bits) - 1u); }
+
+// ---- pixel pipeline (writePixelFast) ----
+uint fbAddress(uint p, int x, int y) { return swAddress(prim[p + 5u], prim[p + 6u], prim[p + 7u], uint(x), uint(y)); }
+uint zAddress(uint p, int x, int y) { return swAddress(prim[p + 10u], prim[p + 11u], prim[p + 12u], uint(x), uint(y)); }
+
+uint readFb(uint p, int x, int y)
+{
+    uint kind = prim[p + 9u] & 0xFFu;
+    uint pixel = fbAddress(p, x, y);
+    if (kind == 3u)
+    {
+        uint byteAddress = (pixel * 2u) & 0x3FFFFEu;
+        return (vram[byteAddress >> 2u] >> ((byteAddress & 2u) * 8u)) & 0xFFFFu;
+    }
+    uint value = vram[pixel & 0xFFFFFu];
+    return kind == 2u ? (value & 0x00FFFFFFu) : value;
+}
+void writeFb(uint p, int x, int y, uint value)
+{
+    uint kind = prim[p + 9u] & 0xFFu;
+    uint pixel = fbAddress(p, x, y);
+    if (kind == 1u)
+        vram[pixel & 0xFFFFFu] = value;
+    else if (kind == 2u)
+    {
+        uint word = pixel & 0xFFFFFu;
+        vram[word] = (vram[word] & 0xFF000000u) | (value & 0x00FFFFFFu);
+    }
+    else
+        writeBits((pixel * 2u) & 0x3FFFFEu, 0u, 16u, value & 0xFFFFu);
+}
+uint readZ(uint p, int x, int y)
+{
+    uint kind = prim[p + 13u] & 0xFFu;
+    uint pixel = zAddress(p, x, y);
+    if (kind == 3u)
+    {
+        uint byteAddress = (pixel * 2u) & 0x3FFFFEu;
+        return (vram[byteAddress >> 2u] >> ((byteAddress & 2u) * 8u)) & 0xFFFFu;
+    }
+    uint value = vram[pixel & 0xFFFFFu];
+    return kind == 2u ? (value & 0x00FFFFFFu) : value;
+}
+void writeZ(uint p, int x, int y, uint value)
+{
+    uint kind = prim[p + 13u] & 0xFFu;
+    uint pixel = zAddress(p, x, y);
+    if (kind == 1u)
+        vram[pixel & 0xFFFFFu] = value;
+    else if (kind == 2u)
+    {
+        uint word = pixel & 0xFFFFFu;
+        vram[word] = (vram[word] & 0xFF000000u) | (value & 0x00FFFFFFu);
+    }
+    else
+        writeBits((pixel * 2u) & 0x3FFFFEu, 0u, 16u, value & 0xFFFFu);
+}
+bool zTest(uint p, int x, int y, uint z)
+{
+    uint method = (prim[p + 13u] >> 8u) & 3u;
+    if (method == 0u)
+        return false;
+    if (method == 1u)
+        return true;
+    uint current = readZ(p, x, y);
+    return method == 2u ? z >= current : z > current;
+}
+uint rgba5551To8888(uint c)
+{
+    return (((c >> 0u) & 0x1Fu) << 3u) | ((((c >> 5u) & 0x1Fu) << 3u) << 8u) | ((((c >> 10u) & 0x1Fu) << 3u) << 16u) |
+           ((((c >> 15u) & 0x01u) << 7u) << 24u);
+}
+uint rgba8888To5551(uint c)
+{
+    return (((c >> 0u) & 0xFFu) >> 3u) | ((((c >> 8u) & 0xFFu) >> 3u) << 5u) | ((((c >> 16u) & 0xFFu) >> 3u) << 10u) |
+           ((((c >> 24u) & 0xFFu) >> 7u) << 15u);
+}
+bool alphaPasses(uint test, uint a)
+{
+    if ((test & 1u) == 0u)
+        return true;
+    uint atst = (test >> 1u) & 7u;
+    uint aref = (test >> 4u) & 0xFFu;
+    switch (atst)
+    {
+    case 0u: return false;
+    case 1u: return true;
+    case 2u: return a < aref;
+    case 3u: return a <= aref;
+    case 4u: return a == aref;
+    case 5u: return a >= aref;
+    case 6u: return a > aref;
+    default: return a != aref;
+    }
+}
+
+const uint FLAG_IIP = 1u << 2u, FLAG_TME = 1u << 3u, FLAG_FST = 1u << 4u, FLAG_FGE = 1u << 5u, FLAG_ABE = 1u << 6u,
+           FLAG_PABE = 1u << 7u, FLAG_FBA = 1u << 8u, FLAG_LINEAR = 1u << 9u, FLAG_ZMASK = 1u << 10u,
+           FLAG_DATE = 1u << 11u, FLAG_ALPHATEST = 1u << 13u, FLAG_FB16 = 1u << 14u, FLAG_FB24 = 1u << 15u;
+
+// writePixelFast after zTest (the depth test only discards, so it runs first).
+void writePixel(uint p, int x, int y, uint z, uint r, uint g, uint b, uint a, uint fog)
+{
+    uint flags = prim[p];
+    uint fpsm = (prim[p + 9u] >> 8u) & 0x3Fu;
+    if ((flags & FLAG_FGE) != 0u)
+    {
+        uint fogColor = prim[p + 16u];
+        uint inverseFog = 255u - fog;
+        r = (((fog * r) >> 8u) + ((inverseFog * (fogColor & 0xFFu)) >> 8u)) & 0xFFu;
+        g = (((fog * g) >> 8u) + ((inverseFog * ((fogColor >> 8u) & 0xFFu)) >> 8u)) & 0xFFu;
+        b = (((fog * b) >> 8u) + ((inverseFog * ((fogColor >> 16u) & 0xFFu)) >> 8u)) & 0xFFu;
+    }
+    uint test = prim[p + 14u];
+    bool writeRgb = true, writeAlpha = true, writeDepth = true;
+    if ((flags & FLAG_ALPHATEST) != 0u && !alphaPasses(test, a))
+    {
+        uint afail = (test >> 12u) & 3u;
+        if (afail == 1u) { writeRgb = true; writeAlpha = true; writeDepth = false; }
+        else if (afail == 2u) { writeRgb = false; writeAlpha = false; writeDepth = true; }
+        else if (afail == 3u) { writeRgb = true; writeAlpha = fpsm != 0u; writeDepth = false; }
+        else { writeRgb = false; writeAlpha = false; writeDepth = false; }
+    }
+    bool writesFb = writeRgb || writeAlpha;
+    if (!writesFb && !writeDepth)
+        return;
+    uint fbmsk = prim[p + 8u];
+    bool abe = (flags & FLAG_ABE) != 0u;
+    bool preserveDestinationAlpha = writeRgb && !writeAlpha && fpsm == 0u;
+    bool dateRead = (flags & FLAG_DATE) != 0u;
+    bool frmw = dateRead || (writesFb && (fbmsk != 0u || abe || preserveDestinationAlpha));
+    uint raw = 0u, fbrgba = 0u;
+    if (frmw)
+    {
+        raw = readFb(p, x, y);
+        fbrgba = raw;
+        if ((flags & FLAG_FB16) != 0u)
+            fbrgba = rgba5551To8888(raw & 0xFFFFu);
+        else if ((flags & FLAG_FB24) != 0u)
+            fbrgba |= 0x80000000u;
+    }
+    if (dateRead)
+    {
+        bool datm = ((test >> 15u) & 1u) != 0u;
+        bool pass = true;
+        if (fpsm == 0u)
+            pass = (((raw >> 31u) & 1u) != 0u) == datm;
+        else if (fpsm == 2u || fpsm == 10u)
+            pass = (((raw >> 15u) & 1u) != 0u) == datm;
+        if (!pass)
+            return;
+    }
+    if (writesFb)
+    {
+        if (abe && !((flags & FLAG_PABE) != 0u && (a & 0x80u) == 0u))
+        {
+            uint alphaReg = prim[p + 15u];
+            uint asel = alphaReg & 3u, bsel = (alphaReg >> 2u) & 3u, csel = (alphaReg >> 4u) & 3u, dsel = (alphaReg >> 6u) & 3u;
+            int fix = int((alphaReg >> 8u) & 0xFFu);
+            int cs[3] = int[3](int(r), int(g), int(b));
+            int cd[3] = int[3](int(fbrgba & 0xFFu), int((fbrgba >> 8u) & 0xFFu), int((fbrgba >> 16u) & 0xFFu));
+            int da = int((fbrgba >> 24u) & 0xFFu);
+            int cAlpha = csel == 0u ? int(a) : (csel == 1u ? da : fix);
+            uint outc[3];
+            for (int c = 0; c < 3; ++c)
+            {
+                int A = asel == 0u ? cs[c] : (asel == 1u ? cd[c] : 0);
+                int B = bsel == 0u ? cs[c] : (bsel == 1u ? cd[c] : 0);
+                int D = dsel == 0u ? cs[c] : (dsel == 1u ? cd[c] : 0);
+                outc[c] = uint(clampU8(((A - B) * cAlpha >> 7) + D));
+            }
+            r = outc[0];
+            g = outc[1];
+            b = outc[2];
+        }
+        if (writeAlpha && (flags & FLAG_FBA) != 0u)
+            a = a | 0x80u;
+        uint pixel = r | (g << 8u) | (b << 16u) | (a << 24u);
+        if (fbmsk != 0u)
+            pixel = (pixel & ~fbmsk) | (fbrgba & fbmsk);
+        if (preserveDestinationAlpha)
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        if ((flags & FLAG_FB16) != 0u)
+            pixel = rgba8888To5551(pixel);
+        writeFb(p, x, y, pixel);
+    }
+    if (writeDepth && (flags & FLAG_ZMASK) == 0u)
+        writeZ(p, x, y, z);
+}
+
+// ---- texture sampling (Sampler) ----
+uint texWord(uint byteAddress) { uint word = byteAddress >> 2u; return vram[pageMap[word >> 11u] + (word & 2047u)]; }
+
+// Sampler::readTexelK
+uint readTexel(uint p, uint u, uint v)
+{
+    uint texKind = prim[p + 20u];
+    uint kind = texKind & 0xFFu;
+    uint pixel = swAddress(prim[p + 17u], prim[p + 18u], prim[p + 19u], u, v);
+    if (kind == 1u || kind == 2u)
+    {
+        uint value = texWord((pixel << 2u) & 0x3FFFFCu);
+        return kind == 2u ? (value & 0x00FFFFFFu) : value;
+    }
+    if (kind == 3u)
+    {
+        uint byteAddress = (pixel << 1u) & 0x3FFFFEu;
+        return (texWord(byteAddress) >> ((byteAddress & 2u) * 8u)) & 0xFFFFu;
+    }
+    if (kind == 4u)
+    {
+        uint byteAddress = pixel & 0x3FFFFFu;
+        return (texWord(byteAddress) >> ((byteAddress & 3u) * 8u)) & 0xFFu;
+    }
+    if (kind == 5u)
+    {
+        uint byteAddress = (pixel >> 1u) & 0x3FFFFFu;
+        return (texWord(byteAddress) >> ((byteAddress & 3u) * 8u + (pixel & 1u) * 4u)) & 0x0Fu;
+    }
+    uint byteAddress = ((pixel << 2u) + 3u) & 0x3FFFFFu;
+    uint byteValue = (texWord(byteAddress) >> ((byteAddress & 3u) * 8u)) & 0xFFu;
+    if (kind == 6u)
+        return byteValue;
+    return kind == 7u ? (byteValue & 0x0Fu) : ((byteValue >> 4u) & 0x0Fu);
+}
+
+// applyTexa
+uint applyTexa(uint texa, uint psm, uint texel)
+{
+    if (psm == 0u)
+        return texel;
+    uint r = texel & 0xFFu, g = (texel >> 8u) & 0xFFu, b = (texel >> 16u) & 0xFFu;
+    bool rgbZero = r == 0u && g == 0u && b == 0u;
+    uint a = (texel >> 24u) & 0xFFu;
+    uint ta0 = texa & 0xFFu, ta1 = (texa >> 8u) & 0xFFu;
+    bool aem = ((texa >> 16u) & 1u) != 0u;
+    if (psm == 1u)
+        a = (aem && rgbZero) ? 0u : ta0;
+    else if (psm == 2u || psm == 10u)
+    {
+        if ((a & 0x80u) != 0u)
+            a = ta1;
+        else
+            a = (aem && rgbZero) ? 0u : ta0;
+    }
+    return (texel & 0x00FFFFFFu) | (a << 24u);
+}
+
+uint clutEntry(uint p, uint index) { uint at = (prim[p + 25u] & 0xFFFu) * 512u + index; return (clut[at >> 1u] >> ((at & 1u) * 16u)) & 0xFFFFu; }
+
+// Sampler::clutLookup
+uint clutLookup(uint p, uint index)
+{
+    uint mode = prim[p + 26u];
+    uint cpsm = mode & 0xFFu, csm = (mode >> 8u) & 0xFFu, csa = (mode >> 16u) & 0xFFu;
+    uint psm = (prim[p + 20u] >> 24u) & 0xFFu;
+    bool fourBit = psm == 20u || psm == 36u || psm == 44u;
+    bool eightBit = psm == 19u || psm == 27u;
+    bool sixteenBit = cpsm == 2u || cpsm == 10u;
+    uint csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    uint clutBase = (csa & csaMask) << 4u;
+    uint sourceIndex = fourBit ? (index & 0x0Fu) : index;
+    uint clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+    if (!sixteenBit && csm == 0u && eightBit)
+    {
+        uint block = min((sourceIndex & 0xF0u) + clutBase, 240u);
+        clutIndex = block + (sourceIndex & 0x0Fu);
+    }
+    uint texa = prim[p + 24u];
+    if (cpsm == 0u)
+        return applyTexa(texa, cpsm, clutEntry(p, clutIndex) | (clutEntry(p, clutIndex + 256u) << 16u));
+    if (cpsm == 1u)
+        return applyTexa(texa, cpsm, (clutEntry(p, clutIndex) | (clutEntry(p, clutIndex + 256u) << 16u)) & 0x00FFFFFFu);
+    if (sixteenBit)
+        return applyTexa(texa, cpsm, rgba5551To8888(clutEntry(p, clutIndex)));
+    return 0xFFFF00FFu;
+}
+
+// wrapTextureCoordinate
+int wrapCoordinate(int coordinate, int size, uint mode, int regionMin, int regionMax)
+{
+    switch (mode & 3u)
+    {
+    case 0u: return int(uint(coordinate) & uint(size - 1));
+    case 1u: return clamp(coordinate, 0, size - 1);
+    case 2u: return min(max(coordinate, regionMin), regionMax);
+    default: return int((uint(coordinate) & uint(regionMin)) | uint(regionMax));
+    }
+}
+
+// Sampler::pointK
+uint pointSample(uint p, int u, int v)
+{
+    uint wh = prim[p + 21u];
+    uint texKind = prim[p + 20u];
+    uint ru = prim[p + 22u], rv = prim[p + 23u];
+    u = wrapCoordinate(u, int(wh & 0xFFFFu), (texKind >> 16u) & 3u, int(ru & 0xFFFFu), int(ru >> 16u));
+    v = wrapCoordinate(v, int(wh >> 16u), (texKind >> 18u) & 3u, int(rv & 0xFFFFu), int(rv >> 16u));
+    uint raw = readTexel(p, uint(u), uint(v));
+    uint sampleKind = (texKind >> 8u) & 0xFu;
+    uint psm = (texKind >> 24u) & 0xFFu;
+    if (sampleKind == 3u)
+        return clutLookup(p, raw & 0xFFu);
+    if (sampleKind == 1u)
+        return applyTexa(prim[p + 24u], psm, raw);
+    if (sampleKind == 2u)
+        return applyTexa(prim[p + 24u], psm, rgba5551To8888(raw & 0xFFFFu));
+    return 0xFFFF00FFu;
+}
+
+uint lerp2(uint a, uint b, uint w) { return (((a * (256u - w)) + (b * w) + 0x00800080u) >> 8u) & 0x00FF00FFu; }
+
+// Sampler::sampleK
+uint sampleTexture(uint p, float s, float t, float q, uint u16, uint v16)
+{
+    precise float texUf, texVf;
+    if ((prim[p] & FLAG_FST) != 0u)
+    {
+        texUf = float(u16) / 16.0;
+        texVf = float(v16) / 16.0;
+    }
+    else
+    {
+        float fabsQ = abs(q) > 1.0e-8 ? q : 1.0;
+        precise float invQ = divRN(1.0, fabsQ);
+        texUf = s * invQ * fl(p, 27u);
+        texVf = t * invQ * fl(p, 28u);
+    }
+    if ((prim[p] & FLAG_LINEAR) == 0u)
+        return pointSample(p, toInt(texUf), toInt(texVf));
+    precise float sampleU = texUf - 0.5;
+    precise float sampleV = texVf - 0.5;
+    int u0 = toInt(floor(sampleU));
+    int v0 = toInt(floor(sampleV));
+    precise float fx = sampleU - float(u0);
+    precise float fy = sampleV - float(v0);
+    uint wx = uint(fx * 256.0 + 0.5);
+    uint wy = uint(fy * 256.0 + 0.5);
+    uint c00 = pointSample(p, u0, v0);
+    uint c10 = wx != 0u ? pointSample(p, u0 + 1, v0) : 0u;
+    uint c01 = wy != 0u ? pointSample(p, u0, v0 + 1) : 0u;
+    uint c11 = (wx != 0u && wy != 0u) ? pointSample(p, u0 + 1, v0 + 1) : 0u;
+    if (wx == 0u && wy == 0u)
+        return c00;
+    const uint mask = 0x00FF00FFu;
+    uint topRb = lerp2(c00 & mask, c10 & mask, wx);
+    uint topGa = lerp2((c00 >> 8u) & mask, (c10 >> 8u) & mask, wx);
+    uint bottomRb = lerp2(c01 & mask, c11 & mask, wx);
+    uint bottomGa = lerp2((c01 >> 8u) & mask, (c11 >> 8u) & mask, wx);
+    return lerp2(topRb, bottomRb, wy) | (lerp2(topGa, bottomGa, wy) << 8u);
+}
+
+// combineTexture: returns RGBA
+uint combineTexture(uint p, uint vr, uint vg, uint vb, uint va, uint texel)
+{
+    uint texKind = prim[p + 20u];
+    uint tfx = (texKind >> 12u) & 3u;
+    bool tcc = ((texKind >> 14u) & 1u) != 0u;
+    uint tr = texel & 0xFFu, tg = (texel >> 8u) & 0xFFu, tb = (texel >> 16u) & 0xFFu, ta = (texel >> 24u) & 0xFFu;
+    uint r = tr, g = tg, b = tb, a = tcc ? ta : va;
+    if (tfx == 0u)
+    {
+        r = uint(clampU8(int((tr * vr) >> 7u)));
+        g = uint(clampU8(int((tg * vg) >> 7u)));
+        b = uint(clampU8(int((tb * vb) >> 7u)));
+        a = tcc ? uint(clampU8(int((ta * va) >> 7u))) : va;
+    }
+    else if (tfx == 2u || tfx == 3u)
+    {
+        r = uint(clampU8(int(((tr * vr) >> 7u) + va)));
+        g = uint(clampU8(int(((tg * vg) >> 7u) + va)));
+        b = uint(clampU8(int(((tb * vb) >> 7u) + va)));
+        a = tcc ? (tfx == 2u ? uint(clampU8(int(ta + va))) : ta) : va;
+    }
+    return r | (g << 8u) | (b << 16u) | (a << 24u);
+}
+
+// ---- DrawSprite (one pixel) ----
+void shadeSprite(uint p, int x, int y)
+{
+    uint z1 = prim[p + 40u];
+    if (!zTest(p, x, y, z1))
+        return;
+    uint color = prim[p + 41u];
+    uint r = color & 0xFFu, g = (color >> 8u) & 0xFFu, b = (color >> 16u) & 0xFFu, a = color >> 24u;
+    uint fog = prim[p + 42u];
+    if ((prim[p] & FLAG_TME) != 0u)
+    {
+        int unclippedX0 = int(prim[p + 32u]);
+        int unclippedY0 = int(prim[p + 33u]);
+        precise float tx = divRN(float(x - unclippedX0) + 0.5, fl(p, 34u));
+        precise float texUf = fl(p, 36u) + (fl(p, 38u) - fl(p, 36u)) * tx;
+        precise float ty = divRN(float(y - unclippedY0) + 0.5, fl(p, 35u));
+        precise float texVf = fl(p, 37u) + (fl(p, 39u) - fl(p, 37u)) * ty;
+        uint texel;
+        if ((prim[p] & FLAG_FST) != 0u)
+        {
+            int fixedU = toInt((texUf * 16.0) + 0.5);
+            int fixedV = toInt((texVf * 16.0) + 0.5);
+            texel = sampleTexture(p, 0.0, 0.0, 1.0, uint(clamp(fixedU, 0, 0xFFFF)), uint(clamp(fixedV, 0, 0xFFFF)));
+        }
+        else
+        {
+            uint wh = prim[p + 21u];
+            texel = sampleTexture(p, divRN(texUf, float(int(wh & 0xFFFFu))), divRN(texVf, float(int(wh >> 16u))), 1.0, 0u, 0u);
+        }
+        uint c = combineTexture(p, r, g, b, a, texel);
+        r = c & 0xFFu;
+        g = (c >> 8u) & 0xFFu;
+        b = (c >> 16u) & 0xFFu;
+        a = c >> 24u;
+    }
+    writePixel(p, x, y, z1, r, g, b, a, fog);
+}
+
+// ---- DrawTriangle (one pixel) ----
+void shadeTriangle(uint p, int x, int y)
+{
+    precise float fx0 = fl(p, 32u), fy0 = fl(p, 33u), fx1 = fl(p, 34u), fy1 = fl(p, 35u), fx2 = fl(p, 36u), fy2 = fl(p, 37u);
+    precise float winding = fl(p, 38u), invAbsDenom = fl(p, 39u);
+    precise float px = float(x) + 0.5;
+    precise float py = float(y) + 0.5;
+    const float kEdgeEpsilon = 1.0e-4;
+    precise float w0 = (((fy1 - fy2) * (px - fx2) + (fx2 - fx1) * (py - fy2)) * winding) * invAbsDenom;
+    precise float w1 = (((fy2 - fy0) * (px - fx2) + (fx0 - fx2) * (py - fy2)) * winding) * invAbsDenom;
+    precise float w2 = 1.0 - w0 - w1;
+    if (w0 < -kEdgeEpsilon || w1 < -kEdgeEpsilon || w2 < -kEdgeEpsilon)
+        return;
+    // DrawTriangleK's rowSpan: the pixels of the row it visits at all (after the weight test: a pixel is drawn
+    // when it passes both, and this one is dearer).
+#ifndef NO_ROWSPAN
+    {
+        int minX = int(prim[p + 1u] & 0xFFFFu), maxX = int(prim[p + 2u] & 0xFFFFu);
+        precise float w0Slope = ((fy1 - fy2) * winding) * invAbsDenom;
+        precise float w1Slope = ((fy2 - fy0) * winding) * invAbsDenom;
+        precise float w2Slope = -w0Slope - w1Slope;
+        precise float w0Offset = (((fy1 - fy2) * -fx2 + (fx2 - fx1) * (py - fy2)) * winding) * invAbsDenom;
+        precise float w1Offset = (((fy2 - fy0) * -fx2 + (fx0 - fx2) * (py - fy2)) * winding) * invAbsDenom;
+        precise float w2Offset = 1.0 - w0Offset - w1Offset;
+        precise float lo = float(minX) - 1.0;
+        precise float hi = float(maxX) + 2.0;
+        float slopes[3] = float[3](w0Slope, w1Slope, w2Slope);
+        float offsets[3] = float[3](w0Offset, w1Offset, w2Offset);
+        for (int i = 0; i < 3; ++i)
+        {
+            if (abs(slopes[i]) < 1.0e-5)
+                continue;
+            precise float crossing = divRN(-kEdgeEpsilon - offsets[i], slopes[i]);
+            if (slopes[i] > 0.0)
+                lo = (lo < crossing) ? crossing : lo;
+            else
+                hi = (crossing < hi) ? crossing : hi;
+        }
+        lo = (float(maxX) + 2.0 < lo) ? float(maxX) + 2.0 : lo;
+        hi = (hi < float(minX) - 1.0) ? float(minX) - 1.0 : hi;
+        int firstX = max(minX, toInt(floor(lo - 0.5)) - 2);
+        int lastX = min(maxX, toInt(ceil(hi - 0.5)) + 2);
+        if (x < firstX || x > lastX)
+            return;
+    }
+#endif
+    precise double z0 = packDouble2x32(uvec2(prim[p + 40u], prim[p + 41u]));
+    precise double z1 = packDouble2x32(uvec2(prim[p + 42u], prim[p + 43u]));
+    precise double z2 = packDouble2x32(uvec2(prim[p + 44u], prim[p + 45u]));
+    precise double zd = z0 * double(w0) + z1 * double(w1) + z2 * double(w2);
+    precise double zr = zd + 0.5;
+    // (u32)(double): truncation through a 64-bit integer, keeping the low 32 bits.
+    precise double zt = trunc(zr);
+    precise double zm = zt - floor(zt * (1.0 / 4294967296.0)) * 4294967296.0;
+    uint zValue = uint(zm);
+    if (!zTest(p, x, y, zValue))
+        return;
+    uint flags = prim[p];
+    uint c0 = prim[p + 46u], c1 = prim[p + 47u], c2 = prim[p + 48u];
+    uint r, g, b, a;
+    if ((flags & FLAG_IIP) != 0u)
+    {
+        precise float rs = float(c0 & 0xFFu) * w0 + float(c1 & 0xFFu) * w1 + float(c2 & 0xFFu) * w2;
+        precise float gs = float((c0 >> 8u) & 0xFFu) * w0 + float((c1 >> 8u) & 0xFFu) * w1 + float((c2 >> 8u) & 0xFFu) * w2;
+        precise float bs = float((c0 >> 16u) & 0xFFu) * w0 + float((c1 >> 16u) & 0xFFu) * w1 + float((c2 >> 16u) & 0xFFu) * w2;
+        precise float as = float(c0 >> 24u) * w0 + float(c1 >> 24u) * w1 + float(c2 >> 24u) * w2;
+        r = uint(clampU8(toInt(rs)));
+        g = uint(clampU8(toInt(gs)));
+        b = uint(clampU8(toInt(bs)));
+        a = uint(clampU8(toInt(as)));
+    }
+    else
+    {
+        r = c2 & 0xFFu;
+        g = (c2 >> 8u) & 0xFFu;
+        b = (c2 >> 16u) & 0xFFu;
+        a = c2 >> 24u;
+    }
+    if ((flags & FLAG_TME) != 0u)
+    {
+        uint texel;
+        if ((flags & FLAG_FST) != 0u)
+        {
+            uint uv0 = prim[p + 59u], uv1 = prim[p + 60u], uv2 = prim[p + 61u];
+            precise float us = float(uv0 & 0xFFFFu) * w0 + float(uv1 & 0xFFFFu) * w1 + float(uv2 & 0xFFFFu) * w2;
+            precise float vs = float(uv0 >> 16u) * w0 + float(uv1 >> 16u) * w1 + float(uv2 >> 16u) * w2;
+            texel = sampleTexture(p, 0.0, 0.0, 1.0, uint(toInt(us)) & 0xFFFFu, uint(toInt(vs)) & 0xFFFFu);
+        }
+        else
+        {
+            precise float is = fl(p, 50u) * w0 + fl(p, 53u) * w1 + fl(p, 56u) * w2;
+            precise float it = fl(p, 51u) * w0 + fl(p, 54u) * w1 + fl(p, 57u) * w2;
+            precise float iq = fl(p, 52u) * w0 + fl(p, 55u) * w1 + fl(p, 58u) * w2;
+            texel = sampleTexture(p, is, it, iq, 0u, 0u);
+        }
+        uint c = combineTexture(p, r, g, b, a, texel);
+        r = c & 0xFFu;
+        g = (c >> 8u) & 0xFFu;
+        b = (c >> 16u) & 0xFFu;
+        a = c >> 24u;
+    }
+    uint fogs = prim[p + 49u];
+    precise float fogSum = float(fogs & 0xFFu) * w0 + float((fogs >> 8u) & 0xFFu) * w1 + float((fogs >> 16u) & 0xFFu) * w2;
+    writePixel(p, x, y, zValue, r, g, b, a, uint(clampU8(toInt(fogSum))));
+}
+
+void main()
+{
+    uint t = gl_WorkGroupID.x;
+    uint origin = tileInfo[3u * t];
+    uint first = tileInfo[3u * t + 1u];
+    uint count = tileInfo[3u * t + 2u];
+    int x = int((origin & 0xFFFFu) * 16u + gl_LocalInvocationID.x);
+    int y = int((origin >> 16u) * 16u + gl_LocalInvocationID.y);
+    for (uint i = 0u; i < count; ++i)
+    {
+        uint p = list[first + i] * PRIM_WORDS;
+        uint b0 = prim[p + 1u], b1 = prim[p + 2u];
+        if (x < int(b0 & 0xFFFFu) || y < int(b0 >> 16u) || x > int(b1 & 0xFFFFu) || y > int(b1 >> 16u))
+            continue;
+        if ((prim[p] & 3u) == 1u)
+            shadeSprite(p, x, y);
+        else
+            shadeTriangle(p, x, y);
+    }
+}
+)GLSL";
