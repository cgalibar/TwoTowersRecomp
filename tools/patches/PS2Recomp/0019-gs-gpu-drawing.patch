 {
+    if (command.direction == 1u)
+    {
+        // Local to host: GSCpuBackend reads it from a host copy; ConsumeLocalToHostBytes hands it out.
+        m_uploadActive = false;
+        Fallback(false, [&]()
+                 { m_cpu->BeginTransfer(command); });
+        return;
+    }
+    if (command.direction == 2u)
+    {
+        m_uploadActive = false;
+        Fallback(true, [&]()
+                 { m_cpu->BeginTransfer(command); });
+        return;
+    }
     m_transfer = command;
     m_copied = 0u;
     m_total = static_cast<uint32_t>(command.trxreg.rrw) * static_cast<uint32_t>(command.trxreg.rrh);
-    m_active = command.direction == 0u && m_total != 0u;
+    m_uploadActive = command.direction == 0u && m_total != 0u;
+    m_transferPages.reset();
+    if (m_uploadActive)
+    {
+        const uint32_t dx = command.trxpos.dsax, dy = command.trxpos.dsay;
+        markRect(m_transferPages, command.bitbltbuf.dbp, command.bitbltbuf.dbw, command.bitbltbuf.dpsm, dx, dy,
+                 dx + std::max<uint32_t>(command.trxreg.rrw, 1u) - 1u, dy + std::max<uint32_t>(command.trxreg.rrh, 1u) - 1u);
+        // Queued chunks of earlier transfers that write the same pages go first.
+        if ((m_transferPages & m_uploadPages).any())
+            FlushUploads();
+    }
 }
 
