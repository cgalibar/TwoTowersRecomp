+void GSGpuBackend::FlushUploads()
+{
+    if (m_uploadChunks.empty())
+        return;
+    ScopedMs timer(m_timing ? &m_stats.uploadMs : nullptr);
+    auto ensure = [&](uint32_t &buffer, size_t &capacity, size_t bytes)
+    {
+        if (bytes <= capacity)
+            return;
+        if (buffer)
+            m_gpu->DeleteBuffer(buffer);
+        capacity = std::max<size_t>(bytes * 2u, 1u << 20u);
+        buffer = m_gpu->CreateBuffer(capacity);
+    };
+    ensure(m_uploadDataBuffer, m_uploadDataCapacity, m_uploadData.size());
+    ensure(m_uploadChunkBuffer, m_uploadChunkCapacity, m_uploadChunks.size() * 4u);
+    ensure(m_uploadGroupBuffer, m_uploadGroupCapacity, m_uploadGroups.size() * 4u);
+    m_gpu->Upload(m_uploadDataBuffer, 0, m_uploadData.size(), m_uploadData.data());
+    m_gpu->Upload(m_uploadChunkBuffer, 0, m_uploadChunks.size() * 4u, m_uploadChunks.data());
+    m_gpu->Upload(m_uploadGroupBuffer, 0, m_uploadGroups.size() * 4u, m_uploadGroups.data());
+    m_gpu->UseProgram(m_uploadProgram);
+    m_gpu->BindStorage(0, m_vram);
+    m_gpu->BindStorage(1, m_swizzle);
+    m_gpu->BindStorage(2, m_uploadDataBuffer);
+    m_gpu->BindStorage(3, m_uploadChunkBuffer);
+    m_gpu->BindStorage(4, m_uploadGroupBuffer);
+    if (m_timing)
+        m_gpu->BeginTimer();
+    m_gpu->Dispatch(static_cast<uint32_t>(m_uploadGroups.size() / 2u));
+    m_gpu->Barrier();
+    if (m_timing)
+        m_stats.uploadGpuMs += m_gpu->EndTimer();
+    ++m_stats.uploadDispatches;
+    m_uploadData.clear();
+    m_uploadChunks.clear();
+    m_uploadGroups.clear();
+    m_uploadPages.reset();
+}
