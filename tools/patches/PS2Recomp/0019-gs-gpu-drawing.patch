+        DrawBatch(reason);
+    for (const PageUse &use : uses)
+        m_pageLayout[use.page] = use.layout;
+    m_batchWrites |= writes;
+    // The pixels it draws (blocks are computed when a later primitive samples one of these pages).
+    auto addWriteRect = [&](uint32_t bp, uint32_t psm)
+    {
+        const WriteRect rect{bp, fbw, psm, static_cast<uint32_t>(boxX0), static_cast<uint32_t>(boxY0),
+                             static_cast<uint32_t>(boxX1), static_cast<uint32_t>(boxY1)};
+        for (size_t i = m_writeRects.size(), seen = 0; i > m_writeRectsDone && seen < 2u; --i, ++seen)
+        {
+            const WriteRect &last = m_writeRects[i - 1u];
+            if (last.bp == rect.bp && last.bw == rect.bw && last.psm == rect.psm && last.x0 <= rect.x0 && last.y0 <= rect.y0 &&
+                last.x1 >= rect.x1 && last.y1 >= rect.y1)
+                return;
+        }
+        m_writeRects.push_back(rect);
+    };
+    // A fully masked frame buffer gets its own value back, a Z buffer under ZMSK is only read.
+    if (ctx.frame.fbmsk != 0xFFFFFFFFu)
+        addWriteRect(framePageBaseToBlock(ctx.frame.fbp), fpsm);
+    if (!ctx.zbuf.zmask)
+        addWriteRect(framePageBaseToBlock(ctx.zbuf.zbp), ctx.zbuf.psm);
+    m_batchReads |= reads;
+
+    // Record and tiles.
+    const uint32_t index = m_primCount++;
+    m_prims.insert(m_prims.end(), r, r + kPrimWords);
+    for (uint32_t ty = static_cast<uint32_t>(boxY0) >> kTileShift; ty <= static_cast<uint32_t>(boxY1) >> kTileShift; ++ty)
+        for (uint32_t tx = static_cast<uint32_t>(boxX0) >> kTileShift; tx <= static_cast<uint32_t>(boxX1) >> kTileShift; ++tx)
+        {
+            std::vector<uint32_t> &tileList = m_tileLists[ty * kTilesPerRow + tx];
+            if (tileList.empty())
+                m_usedTiles.push_back(ty * kTilesPerRow + tx);
+            tileList.push_back(index);
+        }
+    ++m_stats.primitives;
+}
+
+void GSGpuBackend::UpdateWriteBlocks()
+{
+    for (; m_writeRectsDone < m_writeRects.size(); ++m_writeRectsDone)
+    {
+        const WriteRect &rect = m_writeRects[m_writeRectsDone];
+        forEachColumn(rect.bp, rect.bw, rect.psm, rect.x0, rect.y0, rect.x1, rect.y1, [&](uint32_t block)
+                     {
+                         m_batchWriteBlocks.set(block);
+                         return false;
+                     });
+    }
+}
+
+void GSGpuBackend::DrawBatch(int reason)
+{
+    // Uploads queued before the batch's primitives were submitted go first (they touch nothing it uses).
+    FlushUploads();
+    if (m_primCount == 0u)
+        return;
+    ScopedMs timer(m_timing ? &m_stats.drawMs : nullptr);
+    ++m_stats.batches;
+    ++m_stats.ended[reason & 7];
+    // Texture pages the batch samples and draws into: copied first, so every primitive samples them as they
+    // were before the batch (a primitive that samples a page drawn earlier in the batch started a new one).
+    std::array<uint32_t, 512> pageMap;
+    std::vector<uint32_t> copies;
+    const std::bitset<512> snapshot = m_batchReads & m_batchWrites;
+    for (uint32_t page = 0; page < 512u; ++page)
+    {
+        pageMap[page] = page * kPageWords;
+        if (snapshot.test(page))
+        {
+            pageMap[page] = kVramWords + page * kPageWords;
+            copies.push_back(page);
+            copies.push_back(pageMap[page]);
+        }
+    }
+    m_gpu->Upload(m_pageMapBuffer, 0, sizeof(pageMap), pageMap.data());
+    if (!copies.empty())
+    {
+        m_stats.snapshotPages += copies.size() / 2u;
+        const size_t bytes = copies.size() * 4u;
+        if (bytes > m_stagingSize)
+        {
+            if (m_staging)
+                m_gpu->DeleteBuffer(m_staging);
+            m_stagingSize = std::max<size_t>(bytes, 64u * 1024u);
+            m_staging = m_gpu->CreateBuffer(m_stagingSize);
+        }
+        m_gpu->Upload(m_staging, 0, bytes, copies.data());
+        m_gpu->UseProgram(m_copyProgram);
+        m_gpu->SetUniformAt(m_copyCountLocation, static_cast<uint32_t>(copies.size() / 2u));
+        m_gpu->BindStorage(0, m_vram);
+        m_gpu->BindStorage(2, m_staging);
+        m_gpu->Dispatch(static_cast<uint32_t>(copies.size() / 2u));
+        m_gpu->Barrier();
+    }
+
+    // Tiles: origin, first list entry, count.
+    std::vector<uint32_t> tiles;
+    std::vector<uint32_t> lists;
+    tiles.reserve(m_usedTiles.size() * 3u);
+    for (uint32_t tile : m_usedTiles)
+    {
+        std::vector<uint32_t> &tileList = m_tileLists[tile];
+        tiles.push_back((tile % kTilesPerRow) | ((tile / kTilesPerRow) << 16u));
+        tiles.push_back(static_cast<uint32_t>(lists.size()));
+        tiles.push_back(static_cast<uint32_t>(tileList.size()));
+        lists.insert(lists.end(), tileList.begin(), tileList.end());
+        tileList.clear();
+    }
+    auto ensure = [&](uint32_t &buffer, size_t &capacity, size_t bytes)
+    {
+        if (bytes <= capacity)
+            return;
+        if (buffer)
+            m_gpu->DeleteBuffer(buffer);
+        capacity = std::max<size_t>(bytes * 2u, 1u << 20u);
+        buffer = m_gpu->CreateBuffer(capacity);
+    };
+    ensure(m_primBuffer, m_primCapacity, m_prims.size() * 4u);
+    ensure(m_tileBuffer, m_tileCapacity, tiles.size() * 4u);
+    ensure(m_listBuffer, m_listCapacity, lists.size() * 4u);
+    m_gpu->Upload(m_primBuffer, 0, m_prims.size() * 4u, m_prims.data());
+    m_gpu->Upload(m_tileBuffer, 0, tiles.size() * 4u, tiles.data());
+    m_gpu->Upload(m_listBuffer, 0, lists.size() * 4u, lists.data());
+    m_gpu->UseProgram(m_rasterProgram);
+    m_gpu->BindStorage(0, m_vram);
+    m_gpu->BindStorage(1, m_swizzle);
+    m_gpu->BindStorage(2, m_primBuffer);
+    m_gpu->BindStorage(3, m_tileBuffer);
+    m_gpu->BindStorage(4, m_listBuffer);
+    m_gpu->BindStorage(5, m_pageMapBuffer);
+    m_gpu->BindStorage(6, m_clutBuffer);
+    if (m_timing)
+        m_gpu->BeginTimer();
+    for (size_t first = 0; first < m_usedTiles.size(); first += 65535u)
+    {
+        // Dispatch at most 65535 tiles at a time: the tile index is the workgroup index, offset through the
+        // tile buffer binding.
+        const uint32_t groups = static_cast<uint32_t>(std::min<size_t>(65535u, m_usedTiles.size() - first));
+        if (first != 0u)
+        {
+            std::vector<uint32_t> rest(tiles.begin() + static_cast<std::ptrdiff_t>(first * 3u), tiles.end());
+            m_gpu->Upload(m_tileBuffer, 0, rest.size() * 4u, rest.data());
+        }
+        m_gpu->Dispatch(groups);
+    }
+    m_gpu->Barrier();
+    if (m_timing)
+        m_stats.gpuWaitMs += m_gpu->EndTimer();
+    m_stats.tiles += m_usedTiles.size();
+
+    m_prims.clear();
+    m_primCount = 0u;
+    m_usedTiles.clear();
+    m_batchWrites.reset();
+    m_batchReads.reset();
+    m_writeRects.clear();
+    m_writeRectsDone = 0u;
+    m_batchWriteBlocks.reset();
+    m_pageLayout.fill(0u);
+    m_clutInstancesInBatch = 0u;
+}
+
+void GSGpuBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    const bool fourBit = tex0.psm == GS_PSM_T4 || tex0.psm == GS_PSM_T4HL || tex0.psm == GS_PSM_T4HH;
+    const bool eightBit = tex0.psm == GS_PSM_T8 || tex0.psm == GS_PSM_T8H;
+    if (!fourBit && !eightBit)
+        return;
+    switch (tex0.cld)
+    {
+    case 1u: break;
+    case 2u: m_clutCbp[0] = tex0.cbp; break;
+    case 3u: m_clutCbp[1] = tex0.cbp; break;
+    case 4u:
+        if (m_clutCbp[0] == tex0.cbp)
+            return;
+        m_clutCbp[0] = tex0.cbp;
+        break;
+    case 5u:
+        if (m_clutCbp[1] == tex0.cbp)
+            return;
+        m_clutCbp[1] = tex0.cbp;
+        break;
+    default:
+        return;
+    }
+    const bool sixteenBit = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+    const bool thirtyTwoBit = tex0.cpsm == GS_PSM_CT32 || tex0.cpsm == GS_PSM_CT24;
+    if (!sixteenBit && !thirtyTwoBit)
+        return;
+
+    // Source pages: a batch that draws into them goes first (read after write).
+    const uint32_t firstPage = tex0.cbp >> 5u;
+    const uint32_t lastPage = tex0.csm != 0u ? firstPage + 1u + (static_cast<uint32_t>(texclut.cov) / 32u + 1u) * std::max<uint32_t>(texclut.cbw, 1u)
+                                             : (tex0.cbp + 3u) >> 5u;
+    std::bitset<512> pages;
+    for (uint32_t page = firstPage; page <= lastPage; ++page)
+        pages.set(page & 511u);
+    if ((pages & m_batchWrites).any() || m_clutInstancesInBatch + 1u >= kClutInstances)
+        DrawBatch(kEndClut);
+    else if ((pages & m_uploadPages).any())
+        FlushUploads();
+
+    const uint32_t source = m_clutInstance;
+    m_clutInstance = (m_clutInstance + 1u) % kClutInstances;
+    ++m_clutInstancesInBatch;
+    ++m_stats.clutLoads;
+    const uint32_t entryCount = fourBit ? 16u : 256u;
+    const uint32_t csaMask = sixteenBit ? 0x1Fu : 0x0Fu;
+    const uint32_t destinationBase = (static_cast<uint32_t>(tex0.csa) & csaMask) << 4u;
+    const bool suffix = tex0.csm == 0u && thirtyTwoBit && !fourBit;
+    const uint32_t width = tex0.csm != 0u ? std::max<uint32_t>(texclut.cbw, 1u) : 1u;
+    const GSSwizzle::Format &format = *GSSwizzle::Get(tex0.cpsm);
+    const uint32_t values[13] = {source,
+                                 m_clutInstance,
+                                 m_layoutOffset[static_cast<size_t>(layoutIndex(tex0.cpsm))],
+                                 GSSwizzle::Base(format, tex0.cbp),
+                                 GSSwizzle::RowStride(format, width),
+                                 sixteenBit ? 3u : (tex0.cpsm == GS_PSM_CT24 ? 2u : 1u),
+                                 suffix ? destinationBase : 0u,
+                                 entryCount,
+                                 tex0.csm != 0u ? 1u : 0u,
+                                 static_cast<uint32_t>(texclut.cou),
+                                 static_cast<uint32_t>(texclut.cov),
+                                 destinationBase,
+                                 suffix ? 1u : 0u};
+    m_gpu->UseProgram(m_clutProgram);
+    for (size_t i = 0; i < 13u; ++i)
+        m_gpu->SetUniformAt(m_clutLocations[i], values[i]);
+    m_gpu->BindStorage(0, m_vram);
+    m_gpu->BindStorage(1, m_swizzle);
+    m_gpu->BindStorage(2, m_clutBuffer);
+    m_gpu->Dispatch(1u);
+    m_gpu->Barrier();
+}
+
