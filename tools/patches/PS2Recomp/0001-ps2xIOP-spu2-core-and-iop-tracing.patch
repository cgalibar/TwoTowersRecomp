+    void IopMemory::transferSpu2Dma(bool secondCore, uint32_t chcr)
+    {
+        // Channel layout: MADR, BCR, CHCR at base, base + 4, base + 8.
+        const uint32_t chcrAddress = secondCore ? kDmaSpu1Chcr : kDmaSpu0Chcr;
+        uint32_t madr = 0u;
+        uint32_t bcr = 0u;
+        if (const auto it = m_hardware.find(chcrAddress - 8u); it != m_hardware.end())
+            madr = it->second;
+        if (const auto it = m_hardware.find(chcrAddress - 4u); it != m_hardware.end())
+            bcr = it->second;
+
+        const uint32_t wordsPerBlock = std::max<uint32_t>(bcr & 0xFFFFu, 1u);
+        const uint32_t blockCount = std::max<uint32_t>(bcr >> 16u, 1u);
+        const uint64_t bytes = static_cast<uint64_t>(wordsPerBlock) * blockCount * 4u;
+        const uint32_t ramAddress = physicalAddress(madr) & ~1u;
+        if (ramAddress >= RamSize || bytes == 0u)
+            return;
+        const size_t copyBytes = static_cast<size_t>(std::min<uint64_t>(bytes, RamSize - ramAddress)) & ~size_t{1u};
+        const int core = secondCore ? 1 : 0;
+
+        std::vector<uint16_t> words(copyBytes / 2u);
+        if ((chcr & 1u) != 0u)
+        {
+            std::memcpy(words.data(), m_ram.data() + ramAddress, copyBytes);
+            m_spu2->dmaWrite(core, words.data(), words.size());
+        }
+        else
+        {
+            m_spu2->dmaRead(core, words.data(), words.size());
+            std::memcpy(m_ram.data() + ramAddress, words.data(), copyBytes);
+            markOwned(ramAddress, copyBytes);
+        }
+        // MADR advances past the transferred data, as on hardware.
+        m_hardware[chcrAddress - 8u] = madr + static_cast<uint32_t>(copyBytes);
+    }
