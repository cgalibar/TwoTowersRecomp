@@ -0,0 +1,570 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // Per-core register offsets (bytes, relative to the core base 0x000 / 0x400).
+        constexpr uint32_t kVoiceParamsEnd = 0x180u;  // 24 voices x 0x10
+        constexpr uint32_t kVoiceVolL = 0x0u;
+        constexpr uint32_t kVoiceVolR = 0x2u;
+        constexpr uint32_t kVoicePitch = 0x4u;
+        constexpr uint32_t kVoiceAdsr1 = 0x6u;
+        constexpr uint32_t kVoiceAdsr2 = 0x8u;
+        constexpr uint32_t kVoiceEnvx = 0xAu;
+        constexpr uint32_t kRegVmixL = 0x188u;
+        constexpr uint32_t kRegVmixEL = 0x18Cu;
+        constexpr uint32_t kRegVmixR = 0x190u;
+        constexpr uint32_t kRegVmixER = 0x194u;
+        constexpr uint32_t kRegAttr = 0x19Au;
+        constexpr uint32_t kRegIrqa = 0x19Cu;
+        constexpr uint32_t kRegKon = 0x1A0u;
+        constexpr uint32_t kRegKoff = 0x1A4u;
+        constexpr uint32_t kRegTsa = 0x1A8u;
+        constexpr uint32_t kRegData = 0x1ACu;
+        constexpr uint32_t kVoiceAddrBase = 0x1C0u;  // 24 voices x 0xC: SSA, LSAX, NAX (H, L)
+        constexpr uint32_t kVoiceAddrStride = 0xCu;
+        constexpr uint32_t kVoiceAddrEnd = kVoiceAddrBase + 24u * kVoiceAddrStride;
+        constexpr uint32_t kRegEndx = 0x340u;
+        constexpr uint32_t kRegStatx = 0x344u;
+        constexpr uint32_t kCoreStride = 0x400u;
+        constexpr uint32_t kGlobalBase = 0x760u;
+        constexpr uint32_t kMasterVolume[2] = {0x760u, 0x788u};
+        constexpr uint32_t kIrqInfo = 0x7C2u;
+
+        constexpr uint16_t kAttrIrqEnable = 0x40u;
+        constexpr uint16_t kStatxDmaReady = 0x80u;
+        constexpr uint32_t kAddressMask = IopSpu2::RamWords - 1u;
+        constexpr size_t kMaxQueuedFrames = IopSpu2::SampleRate;  // one second
+
+        constexpr int32_t kFilterPos[5] = {0, 60, 115, 98, 122};
+        constexpr int32_t kFilterNeg[5] = {0, 0, -52, -55, -60};
+
+        int16_t clamp16(int32_t value)
+        {
+            return static_cast<int16_t>(std::clamp(value, -0x8000, 0x7FFF));
+        }
+
+        // Fixed-mode volume registers hold a 15-bit signed value; sweep mode is approximated as full.
+        int32_t volumeOf(uint16_t value)
+        {
+            if (value & 0x8000u)
+                return 0x7FFF;
+            return static_cast<int16_t>(static_cast<uint16_t>(value << 1u));
+        }
+    }
+
+    IopSpu2::IopSpu2()
+        : m_ram(RamWords)
+    {
+        reset();
+    }
+
+    void IopSpu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        m_regs.fill(0);
+        m_cores = {};
+        m_cycle = 0;
+        m_cycleCarry = 0;
+        m_irqInfo = 0;
+        m_irqPending = false;
+        m_output.clear();
+    }
+
+    uint32_t IopSpu2::coreRegister32(int core, uint32_t relative) const
+    {
+        const uint32_t base = static_cast<uint32_t>(core) * kCoreStride + relative;
+        return ((static_cast<uint32_t>(regValue(base)) & 0xFu) << 16u) | regValue(base + 2u);
+    }
+
+    void IopSpu2::setCoreRegister32(int core, uint32_t relative, uint32_t value)
+    {
+        const uint32_t base = static_cast<uint32_t>(core) * kCoreStride + relative;
+        reg(base) = static_cast<uint16_t>((value >> 16u) & 0xFu);
+        reg(base + 2u) = static_cast<uint16_t>(value);
+    }
+
+    uint32_t IopSpu2::transferAddress(int core) const
+    {
+        return coreRegister32(core, kRegTsa) & kAddressMask;
+    }
+
+    void IopSpu2::setTransferAddress(int core, uint32_t address)
+    {
+        setCoreRegister32(core, kRegTsa, address & kAddressMask);
+    }
+
+    uint32_t IopSpu2::irqAddress(int core) const
+    {
+        return coreRegister32(core, kRegIrqa) & kAddressMask;
+    }
+
+    bool IopSpu2::irqEnabled(int core) const
+    {
+        return (regValue(static_cast<uint32_t>(core) * kCoreStride + kRegAttr) & kAttrIrqEnable) != 0u;
+    }
+
+    void IopSpu2::checkIrq(uint32_t address)
+    {
+        for (int core = 0; core < 2; ++core)
+        {
+            if (irqEnabled(core) && irqAddress(core) == (address & kAddressMask))
+                raiseIrq(core);
+        }
+    }
+
+    void IopSpu2::raiseIrq(int core)
+    {
+        m_irqInfo |= static_cast<uint16_t>(4u << core);
+        m_irqPending = true;
+    }
+
+    bool IopSpu2::takeInterrupt() noexcept
+    {
+        const bool pending = m_irqPending;
+        m_irqPending = false;
+        return pending;
+    }
+
+    bool IopSpu2::hasActiveVoices() const noexcept
+    {
+        for (const Core &core : m_cores)
+            for (const Voice &voice : core.voices)
+                if (voice.active)
+                    return true;
+        return false;
+    }
+
+    uint32_t IopSpu2::nextAddress(const Voice &voice) const
+    {
+        return (voice.block + 1u + std::min<uint32_t>(voice.sampleIndex / 4u, 6u)) & kAddressMask;
+    }
+
+    uint16_t IopSpu2::read16(uint32_t phys)
+    {
+        const uint32_t offset = (phys - RegisterBase) & 0x7FEu;
+        if (offset == kIrqInfo)
+            return m_irqInfo;
+        if (offset < kGlobalBase)
+        {
+            const int core = offset >= kCoreStride ? 1 : 0;
+            const uint32_t relative = offset - static_cast<uint32_t>(core) * kCoreStride;
+            Core &state = m_cores[static_cast<size_t>(core)];
+            if (relative < kVoiceParamsEnd && (relative & 0xFu) == kVoiceEnvx)
+                return static_cast<uint16_t>(state.voices[relative >> 4u].level);
+            if (relative >= kVoiceAddrBase && relative < kVoiceAddrEnd)
+            {
+                const uint32_t voiceIndex = (relative - kVoiceAddrBase) / kVoiceAddrStride;
+                const uint32_t field = (relative - kVoiceAddrBase) % kVoiceAddrStride;
+                const Voice &voice = state.voices[voiceIndex];
+                if (field == 4u || field == 6u)
+                {
+                    const uint32_t lsa = voice.lsa;
+                    return static_cast<uint16_t>(field == 4u ? (lsa >> 16u) : lsa);
+                }
+                if (field == 8u || field == 10u)
+                {
+                    const uint32_t nax = nextAddress(voice);
+                    return static_cast<uint16_t>(field == 8u ? (nax >> 16u) : nax);
+                }
+            }
+            if (relative == kRegEndx)
+                return static_cast<uint16_t>(state.endx);
+            if (relative == kRegEndx + 2u)
+                return static_cast<uint16_t>(state.endx >> 16u);
+        }
+        return regValue(offset);
+    }
+
+    void IopSpu2::write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t offset = (phys - RegisterBase) & 0x7FEu;
+        if (offset == kIrqInfo)
+        {
+            m_irqInfo = 0;
+            return;
+        }
+        if (offset >= kGlobalBase)
+        {
+            reg(offset) = value;
+            return;
+        }
+
+        const int core = offset >= kCoreStride ? 1 : 0;
+        const uint32_t relative = offset - static_cast<uint32_t>(core) * kCoreStride;
+        Core &state = m_cores[static_cast<size_t>(core)];
+
+        switch (relative)
+        {
+        case kRegKon:
+            reg(offset) = value;
+            keyOn(core, value);
+            return;
+        case kRegKon + 2u:
+            reg(offset) = value;
+            keyOn(core, static_cast<uint32_t>(value & 0xFFu) << 16u);
+            return;
+        case kRegKoff:
+            reg(offset) = value;
+            keyOff(core, value);
+            return;
+        case kRegKoff + 2u:
+            reg(offset) = value;
+            keyOff(core, static_cast<uint32_t>(value & 0xFFu) << 16u);
+            return;
+        case kRegEndx:
+            state.endx &= 0xFF0000u;
+            return;
+        case kRegEndx + 2u:
+            state.endx &= 0xFFFFu;
+            return;
+        case kRegData:
+        {
+            const uint32_t address = transferAddress(core);
+            m_ram[address] = value;
+            checkIrq(address);
+            setTransferAddress(core, address + 1u);
+            return;
+        }
+        default:
+            break;
+        }
+
+        reg(offset) = value;
+        if (relative >= kVoiceAddrBase && relative < kVoiceAddrEnd)
+        {
+            const uint32_t voiceIndex = (relative - kVoiceAddrBase) / kVoiceAddrStride;
+            const uint32_t field = (relative - kVoiceAddrBase) % kVoiceAddrStride;
+            Voice &voice = state.voices[voiceIndex];
+            const uint32_t fieldBase = kVoiceAddrBase + voiceIndex * kVoiceAddrStride + (field & ~3u);
+            const uint32_t address = coreRegister32(core, fieldBase) & kAddressMask;
+            if (field < 4u)
+            {
+                voice.ssa = address;
+            }
+            else if (field < 8u)
+            {
+                voice.lsa = address;
+                voice.lsaFromFlag = false;
+            }
+            else
+            {
+                voice.block = address & ~7u;
+                voice.sampleIndex = 0;
+                voice.blockDecoded = false;
+            }
+        }
+    }
+
+    void IopSpu2::dmaWrite(int core, const uint16_t *data, size_t words)
+    {
+        uint32_t address = transferAddress(core);
+        for (size_t i = 0; i < words; ++i)
+        {
+            m_ram[address] = data[i];
+            checkIrq(address);
+            address = (address + 1u) & kAddressMask;
+        }
+        setTransferAddress(core, address);
+        reg(static_cast<uint32_t>(core) * kCoreStride + kRegStatx) |= kStatxDmaReady;
+    }
+
+    void IopSpu2::dmaRead(int core, uint16_t *data, size_t words)
+    {
+        uint32_t address = transferAddress(core);
+        for (size_t i = 0; i < words; ++i)
+        {
+            data[i] = m_ram[address];
+            checkIrq(address);
+            address = (address + 1u) & kAddressMask;
+        }
+        setTransferAddress(core, address);
+        reg(static_cast<uint32_t>(core) * kCoreStride + kRegStatx) |= kStatxDmaReady;
+    }
+
+    void IopSpu2::keyOn(int core, uint32_t mask)
+    {
+        Core &state = m_cores[static_cast<size_t>(core)];
+        for (int i = 0; i < VoicesPerCore; ++i)
+        {
+            if ((mask & (1u << i)) == 0u)
+                continue;
+            Voice &voice = state.voices[static_cast<size_t>(i)];
+            voice.ssa = coreRegister32(core, kVoiceAddrBase + static_cast<uint32_t>(i) * kVoiceAddrStride) & kAddressMask;
+            voice.block = voice.ssa & ~7u;
+            voice.sampleIndex = 0;
+            voice.counter = 0;
+            voice.prev1 = 0;
+            voice.prev2 = 0;
+            voice.blockDecoded = false;
+            voice.active = true;
+            voice.phase = EnvelopePhase::Attack;
+            voice.level = 0;
+            voice.envelopeWait = 0;
+            state.endx &= ~(1u << i);
+            startBlock(voice);
+        }
+    }
+
+    void IopSpu2::keyOff(int core, uint32_t mask)
+    {
+        Core &state = m_cores[static_cast<size_t>(core)];
+        for (int i = 0; i < VoicesPerCore; ++i)
+        {
+            if ((mask & (1u << i)) == 0u)
+                continue;
+            Voice &voice = state.voices[static_cast<size_t>(i)];
+            if (voice.phase != EnvelopePhase::Off)
+            {
+                voice.phase = EnvelopePhase::Release;
+                voice.envelopeWait = 0;
+            }
+        }
+    }
+
+    void IopSpu2::startBlock(Voice &voice)
+    {
+        checkIrq(voice.block);
+        const uint8_t flags = static_cast<uint8_t>(m_ram[voice.block & kAddressMask] >> 8u);
+        if (flags & 4u)
+        {
+            voice.lsa = voice.block;
+            voice.lsaFromFlag = true;
+        }
+    }
+
+    void IopSpu2::decodeBlock(Voice &voice)
+    {
+        const uint16_t header = m_ram[voice.block & kAddressMask];
+        uint32_t shift = header & 0xFu;
+        if (shift > 12u)
+            shift = 9u;
+        const uint32_t filter = std::min<uint32_t>((header >> 4u) & 7u, 4u);
+        for (uint32_t i = 0; i < 28u; ++i)
+        {
+            const uint16_t word = m_ram[(voice.block + 1u + i / 4u) & kAddressMask];
+            const int32_t nibble = static_cast<int16_t>(static_cast<uint16_t>(((word >> ((i & 3u) * 4u)) & 0xFu) << 12u));
+            int32_t sample = nibble >> shift;
+            sample += (voice.prev1 * kFilterPos[filter] + voice.prev2 * kFilterNeg[filter] + 32) >> 6;
+            const int16_t clamped = clamp16(sample);
+            voice.decoded[i] = clamped;
+            voice.prev2 = voice.prev1;
+            voice.prev1 = clamped;
+        }
+        voice.blockDecoded = true;
+    }
+
+    void IopSpu2::stepVoice(int core, int index, Voice &voice)
+    {
+        const uint32_t pitch = std::min<uint32_t>(
+            regValue(static_cast<uint32_t>(core) * kCoreStride + static_cast<uint32_t>(index) * 0x10u + kVoicePitch), 0x3FFFu);
+        voice.counter += pitch;
+        while (voice.counter >= 0x1000u && voice.active)
+        {
+            voice.counter -= 0x1000u;
+            ++voice.sampleIndex;
+            if (voice.sampleIndex < 28u)
+            {
+                if ((voice.sampleIndex & 3u) == 0u)
+                    checkIrq(nextAddress(voice));
+                continue;
+            }
+
+            Core &state = m_cores[static_cast<size_t>(core)];
+            const uint8_t flags = static_cast<uint8_t>(m_ram[voice.block & kAddressMask] >> 8u);
+            if (flags & 1u)
+            {
+                state.endx |= 1u << index;
+                voice.block = voice.lsa & ~7u;
+                if ((flags & 2u) == 0u)
+                {
+                    // Loop end without repeat: the voice stops and is muted.
+                    voice.active = false;
+                    voice.phase = EnvelopePhase::Off;
+                    voice.level = 0;
+                }
+            }
+            else
+            {
+                voice.block = (voice.block + 8u) & kAddressMask;
+            }
+            voice.sampleIndex = 0;
+            voice.blockDecoded = false;
+            if (voice.active)
+                startBlock(voice);
+        }
+    }
+
+    void IopSpu2::stepEnvelope(int core, int index, Voice &voice)
+    {
+        if (voice.phase == EnvelopePhase::Off)
+            return;
+        if (voice.envelopeWait > 0u)
+        {
+            --voice.envelopeWait;
+            return;
+        }
+
+        const uint32_t base = static_cast<uint32_t>(core) * kCoreStride + static_cast<uint32_t>(index) * 0x10u;
+        const uint16_t adsr1 = regValue(base + kVoiceAdsr1);
+        const uint16_t adsr2 = regValue(base + kVoiceAdsr2);
+
+        bool exponential = false;
+        bool decreasing = false;
+        int32_t shift = 0;
+        int32_t step = 0;
+        switch (voice.phase)
+        {
+        case EnvelopePhase::Attack:
+            exponential = (adsr1 & 0x8000u) != 0u;
+            shift = (adsr1 >> 10u) & 0x1Fu;
+            step = 7 - ((adsr1 >> 8u) & 3u);
+            break;
+        case EnvelopePhase::Decay:
+            exponential = true;
+            decreasing = true;
+            shift = (adsr1 >> 4u) & 0xFu;
+            step = -8;
+            break;
+        case EnvelopePhase::Sustain:
+            exponential = (adsr2 & 0x8000u) != 0u;
+            decreasing = (adsr2 & 0x4000u) != 0u;
+            shift = (adsr2 >> 8u) & 0x1Fu;
+            step = decreasing ? -8 + ((adsr2 >> 6u) & 3u) : 7 - ((adsr2 >> 6u) & 3u);
+            break;
+        case EnvelopePhase::Release:
+            exponential = (adsr2 & 0x20u) != 0u;
+            decreasing = true;
+            shift = adsr2 & 0x1Fu;
+            step = -8;
+            break;
+        case EnvelopePhase::Off:
+            return;
+        }
+
+        uint32_t cycles = 1u << std::max(0, shift - 11);
+        int32_t delta = step << std::max(0, 11 - shift);
+        if (exponential && !decreasing && voice.level > 0x6000)
+            cycles *= 4u;
+        if (exponential && decreasing)
+            delta = (delta * voice.level) >> 15;
+        voice.level = std::clamp(voice.level + delta, 0, 0x7FFF);
+        voice.envelopeWait = cycles - 1u;
+
+        const int32_t sustainLevel = std::min<int32_t>(((adsr1 & 0xFu) + 1) * 0x800, 0x7FFF);
+        switch (voice.phase)
+        {
+        case EnvelopePhase::Attack:
+            if (voice.level >= 0x7FFF)
+            {
+                voice.phase = EnvelopePhase::Decay;
+                voice.envelopeWait = 0;
+            }
+            break;
+        case EnvelopePhase::Decay:
+            if (voice.level <= sustainLevel)
+            {
+                voice.phase = EnvelopePhase::Sustain;
+                voice.envelopeWait = 0;
+            }
+            break;
+        case EnvelopePhase::Release:
+            if (voice.level == 0)
+            {
+                voice.phase = EnvelopePhase::Off;
+                voice.active = false;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    void IopSpu2::mixSample()
+    {
+        int32_t outL = 0;
+        int32_t outR = 0;
+        for (int core = 0; core < 2; ++core)
+        {
+            Core &state = m_cores[static_cast<size_t>(core)];
+            const uint32_t coreBase = static_cast<uint32_t>(core) * kCoreStride;
+            const uint32_t mixL = (static_cast<uint32_t>(regValue(coreBase + kRegVmixL)) |
+                                   (static_cast<uint32_t>(regValue(coreBase + kRegVmixL + 2u)) << 16u)) |
+                                  (static_cast<uint32_t>(regValue(coreBase + kRegVmixEL)) |
+                                   (static_cast<uint32_t>(regValue(coreBase + kRegVmixEL + 2u)) << 16u));
+            const uint32_t mixR = (static_cast<uint32_t>(regValue(coreBase + kRegVmixR)) |
+                                   (static_cast<uint32_t>(regValue(coreBase + kRegVmixR + 2u)) << 16u)) |
+                                  (static_cast<uint32_t>(regValue(coreBase + kRegVmixER)) |
+                                   (static_cast<uint32_t>(regValue(coreBase + kRegVmixER + 2u)) << 16u));
+            int32_t coreL = 0;
+            int32_t coreR = 0;
+            for (int i = 0; i < VoicesPerCore; ++i)
+            {
+                Voice &voice = state.voices[static_cast<size_t>(i)];
+                if (!voice.active || voice.level == 0)
+                    continue;
+                if (!voice.blockDecoded)
+                    decodeBlock(voice);
+                const int32_t sample = (voice.decoded[std::min<uint32_t>(voice.sampleIndex, 27u)] * voice.level) >> 15;
+                const uint32_t voiceBase = coreBase + static_cast<uint32_t>(i) * 0x10u;
+                if (mixL & (1u << i))
+                    coreL += (sample * volumeOf(regValue(voiceBase + kVoiceVolL))) >> 15;
+                if (mixR & (1u << i))
+                    coreR += (sample * volumeOf(regValue(voiceBase + kVoiceVolR))) >> 15;
+            }
+            outL += (coreL * volumeOf(regValue(kMasterVolume[core]))) >> 15;
+            outR += (coreR * volumeOf(regValue(kMasterVolume[core] + 2u))) >> 15;
+        }
+
+        if (m_output.size() >= kMaxQueuedFrames * 2u)
+            m_output.erase(m_output.begin(), m_output.begin() + static_cast<std::ptrdiff_t>(kMaxQueuedFrames));
+        m_output.push_back(clamp16(outL));
+        m_output.push_back(clamp16(outR));
+    }
+
+    void IopSpu2::advanceTo(uint64_t cycle)
+    {
+        if (cycle <= m_cycle)
+            return;
+        const uint64_t elapsed = cycle - m_cycle + m_cycleCarry;
+        m_cycle = cycle;
+        uint64_t samples = elapsed / CyclesPerSample;
+        m_cycleCarry = elapsed % CyclesPerSample;
+        // Never synthesize more than the queue can hold after a long idle jump.
+        samples = std::min<uint64_t>(samples, kMaxQueuedFrames);
+        for (uint64_t s = 0; s < samples; ++s)
+        {
+            for (int core = 0; core < 2; ++core)
+            {
+                Core &state = m_cores[static_cast<size_t>(core)];
+                for (int i = 0; i < VoicesPerCore; ++i)
+                {
+                    Voice &voice = state.voices[static_cast<size_t>(i)];
+                    if (!voice.active)
+                        continue;
+                    stepEnvelope(core, i, voice);
+                }
+            }
+            mixSample();
+            for (int core = 0; core < 2; ++core)
+            {
+                Core &state = m_cores[static_cast<size_t>(core)];
+                for (int i = 0; i < VoicesPerCore; ++i)
+                {
+                    Voice &voice = state.voices[static_cast<size_t>(i)];
+                    if (voice.active)
+                        stepVoice(core, i, voice);
+                }
+            }
+        }
+    }
+
+    void IopSpu2::drainOutput(std::vector<int16_t> &destination)
+    {
+        destination.insert(destination.end(), m_output.begin(), m_output.end());
+        m_output.clear();
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000..43d57d2
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // SPU2 emulation for the IOP: 2 MiB sound RAM, manual/DMA transfers through TSA, 2x24 ADPCM
+    // voices with loop flags, NAX/ENDX/ENVX, ADSR envelopes, address IRQs and a stereo mix.
+    // Registers are 16-bit; addresses held in them are in 16-bit word units.
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t RegisterBase = 0x1F900000u;
+        static constexpr uint32_t RegisterEnd = 0x1F900800u;
+        static constexpr uint32_t RamWords = 0x100000u;     // 2 MiB
+        static constexpr uint32_t CyclesPerSample = 768u;   // 36.864 MHz IOP clock / 48 kHz
+        static constexpr uint32_t SampleRate = 48000u;
+        static constexpr int VoicesPerCore = 24;
+
+        IopSpu2();
+        void reset();
+
+        [[nodiscard]] uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) / 7 (core 1). `words` are 16-bit units.
+        void dmaWrite(int core, const uint16_t *data, size_t words);
+        void dmaRead(int core, uint16_t *data, size_t words);
+
+        // Runs the voices up to `cycle` (IOP cycles) and appends the mix to the output queue.
+        void advanceTo(uint64_t cycle);
+        [[nodiscard]] bool takeInterrupt() noexcept;
+        [[nodiscard]] bool hasActiveVoices() const noexcept;
+
+        // Interleaved stereo 16-bit frames produced since the last call.
+        void drainOutput(std::vector<int16_t> &destination);
+
+    private:
+        enum class EnvelopePhase : uint8_t
+        {
+            Off,
+            Attack,
+            Decay,
+            Sustain,
+            Release,
+        };
+
+        struct Voice
+        {
+            uint32_t ssa = 0;
+            uint32_t lsa = 0;
+            uint32_t block = 0;        // address of the ADPCM block being played
+            uint32_t sampleIndex = 0;  // 0..27 within the block
+            uint32_t counter = 0;      // 12-bit fractional pitch accumulator
+            bool active = false;
+            bool lsaFromFlag = false;
+            EnvelopePhase phase = EnvelopePhase::Off;
+            int32_t level = 0;          // ENVX, 0..0x7FFF
+            uint32_t envelopeWait = 0;  // samples left before the next envelope step
+            std::array<int16_t, 28> decoded{};
+            int32_t prev1 = 0;
+            int32_t prev2 = 0;
+            bool blockDecoded = false;
+        };
+
+        struct Core
+        {
+            std::array<Voice, VoicesPerCore> voices{};
+            uint32_t endx = 0;
+            uint16_t statx = 0;
+        };
+
+        [[nodiscard]] uint16_t &reg(uint32_t offset) { return m_regs[(offset >> 1) & (kRegisterWords - 1u)]; }
+        [[nodiscard]] uint16_t regValue(uint32_t offset) const { return m_regs[(offset >> 1) & (kRegisterWords - 1u)]; }
+        [[nodiscard]] uint32_t coreRegister32(int core, uint32_t relative) const;  // H at relative, L at +2
+        void setCoreRegister32(int core, uint32_t relative, uint32_t value);
+        [[nodiscard]] uint32_t transferAddress(int core) const;
+        void setTransferAddress(int core, uint32_t address);
+        [[nodiscard]] uint32_t irqAddress(int core) const;
+        [[nodiscard]] bool irqEnabled(int core) const;
+        void checkIrq(uint32_t address);
+        void raiseIrq(int core);
+
+        void keyOn(int core, uint32_t mask);
+        void keyOff(int core, uint32_t mask);
+        void startBlock(Voice &voice);
+        void decodeBlock(Voice &voice);
+        void stepVoice(int core, int index, Voice &voice);
+        void stepEnvelope(int core, int index, Voice &voice);
+        [[nodiscard]] uint32_t nextAddress(const Voice &voice) const;
+        void mixSample();
+
+        static constexpr uint32_t kRegisterWords = 0x400u;  // 0x800 bytes of register space
+
+        std::vector<uint16_t> m_ram;
+        std::array<uint16_t, kRegisterWords> m_regs{};
+        std::array<Core, 2> m_cores{};
+        uint64_t m_cycle = 0;
+        uint64_t m_cycleCarry = 0;
+        uint16_t m_irqInfo = 0;
+        bool m_irqPending = false;
+        std::vector<int16_t> m_output;
+    };
+}
