+void PS2Runtime::setRuntimeGuestRegion(uint32_t base, uint32_t size)
+{
+    if (base >= PS2_RAM_SIZE || size > PS2_RAM_SIZE - base)
+    {
+        std::cerr << "[runtime] ignoring guest region 0x" << std::hex << base << "+0x" << size << std::dec << std::endl;
+        return;
+    }
+    const uint32_t poolBytes = ps2_syscalls::setRuntimePoolBase(base);
+    std::lock_guard<std::mutex> lock(m_asyncCallbackStackMutex);
+    m_asyncCallbackStackFloor = alignGuestHeapValue(base + poolBytes, kGuestHeapDefaultAlignment);
+    m_asyncCallbackStackTop = base + size;
+}
