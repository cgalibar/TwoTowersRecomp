diff --git a/ps2xRuntime/include/runtime/gs/gs_swizzle.h b/ps2xRuntime/include/runtime/gs/gs_swizzle.h
new file mode 100644
index 0000000..8b44ae9
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_swizzle.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// Swizzled VRAM addresses as the sum of a row part and a column part.
+//
+// GSMem::PixelAddress(psm, bp, bw, x, y), the address every read and write of the software GS uses, is
+//   Base(bp) + PageRow(y, bw) + rowIn[y % pageH] + col[(y % pageH) % period][x]
+// where col folds the page column (x / pageW) and the column offset inside the page. For most formats the
+// offset inside the page splits exactly into a row and a column part (period 1); for PSMT8/PSMT4 the column
+// order changes with the row inside a 16-row block, so col has one row of offsets per row of that period.
+// The tables are built from GSMem::PixelAddress itself and checked against it (SelfTest).
+namespace GSSwizzle
+{
+    struct Format
+    {
+        uint32_t pageW = 64, pageH = 32;
+        uint32_t pixelsPerPage = 2048, pixelsPerBlock = 64;
+        uint32_t period = 1;
+        // log2(pageW), log2(pageH), pageH - 1 and period - 1 (all powers of two).
+        uint32_t pageWShift = 6, pageHShift = 5, pageHMask = 31, periodMask = 0;
+        uint32_t rowIn[128] = {};
+        // [period][2048]: (x / pageW) * pixelsPerPage + offset of column x inside the page.
+        const uint32_t *col = nullptr;
+    };
+
+    // The layout of a format (CT24 and the 8H/4H formats use the CT32 one, Z24 the Z32 one); null if unknown.
+    const Format *Get(uint32_t psm);
+
+    // Part of the address that depends on the row: base block, page row and row inside the page.
+    inline uint32_t RowBase(const Format &f, uint32_t bp, uint32_t bw, uint32_t y)
+    {
+        const uint32_t rowPages = (bw * 64u) / f.pageW;
+        return (bp / 32u) * f.pixelsPerPage + (bp % 32u) * f.pixelsPerBlock + (y / f.pageH) * rowPages * f.pixelsPerPage +
+               f.rowIn[y % f.pageH];
+    }
+
+    // Column offsets for row y (indexed by x & 2047).
+    inline const uint32_t *Columns(const Format &f, uint32_t y)
+    {
+        return f.col + ((y % f.pageH) % f.period) * 2048u;
+    }
+
+    // RowBase split for many rows of one buffer: Base(bp) + (y >> pageHShift) * RowStride(bw) + rowIn[...].
+    inline uint32_t Base(const Format &f, uint32_t bp)
+    {
+        return (bp / 32u) * f.pixelsPerPage + (bp % 32u) * f.pixelsPerBlock;
+    }
+    inline uint32_t RowStride(const Format &f, uint32_t bw)
+    {
+        return ((bw * 64u) >> f.pageWShift) * f.pixelsPerPage;
+    }
+    inline uint32_t AddressFast(const Format &f, uint32_t base, uint32_t rowStride, uint32_t x, uint32_t y)
+    {
+        const uint32_t inPage = y & f.pageHMask;
+        return base + (y >> f.pageHShift) * rowStride + f.rowIn[inPage] + f.col[(inPage & f.periodMask) * 2048u + (x & 2047u)];
+    }
+
+    inline uint32_t Address(const Format &f, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        return RowBase(f, bp, bw, y) + Columns(f, y)[x & 2047u];
+    }
+
+    // Compares Address with GSMem::PixelAddress over many buffers and coordinates; false (and a description
+    // of the first mismatch) if they ever differ.
+    bool SelfTest(std::string &report);
+}
