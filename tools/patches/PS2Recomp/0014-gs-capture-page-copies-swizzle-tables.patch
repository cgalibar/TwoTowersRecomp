+// GS command capture and replay.
+//
+// PS2X_GS_CAPTURE=<file>[,<first vblank>[,<presents>]] records everything the raster backend receives, in
+// the order it runs, starting right after the first presentation at or past <first vblank> (default 4000)
+// and ending after <presents> more presentations (default 100). The file starts with VRAM and the CLUT
+// state at that point, so ttr_gs_bench can replay it offline on any backend configuration and compare VRAM.
+//
+// File: Header, VRAM (vramSize bytes), CLUT (GSCpuBackend::ClutState), then records: one Op byte and its
+// payload (structures are written as they are in memory: only the same build reads them back).
+//   Submit             u8 vertexCount, u8 hasState, GSVertex[vertexCount], GSDrawState if hasState
+//                      (otherwise the state of the previous Submit)
+//   LoadClut           GSTex0Reg, GSTexClutReg
+//   BeginTransfer      GSTransferCommand
+//   UploadImage        u32 size, bytes
+//   Flush, TextureFlush, Readback (a VRAM read: flushes like one), Reset, End: nothing
+//   Sync               u8 GSSyncReason
+//   Present            GSPresentationRequest
+//   ClearFramebuffer   GSContext, u32 rgba
+//   WriteVram          u32 psm, base, bw, x, y, value
+//   ConsumeLocalToHost u32 maxBytes
+namespace GSCapture
+{
+    enum class Op : uint8_t
+    {
+        Submit = 1,
+        LoadClut,
+        BeginTransfer,
+        UploadImage,
+        Flush,
+        TextureFlush,
+        Sync,
+        Present,
+        ClearFramebuffer,
+        WriteVram,
+        ConsumeLocalToHost,
+        Readback,
+        Reset,
+        End = 0xFF,
+    };
+
+    struct Header
+    {
+        char magic[8] = {'T', 'T', 'R', 'G', 'S', '0', '0', '1'};
+        uint32_t vramSize = 0;
+        // Sizes of the structures written raw: a capture from another build is refused.
+        uint32_t vertexSize = sizeof(GSVertex);
+        uint32_t drawStateSize = sizeof(GSDrawState);
+        uint32_t transferSize = sizeof(GSTransferCommand);
+        uint32_t presentSize = sizeof(GSPresentationRequest);
+        uint32_t contextSize = sizeof(GSContext);
+        uint32_t clutStateSize = sizeof(GSCpuBackend::ClutState);
+        uint32_t firstVblank = 0;
+    };
+
+    struct Capture
+    {
+        Header header{};
+        std::vector<uint8_t> vram;
+        GSCpuBackend::ClutState clut{};
+        std::vector<uint8_t> stream; // the records
+    };
+
+    bool Load(const std::string &path, Capture &capture, std::string &error);
+
+    struct ReplayHooks
+    {
+        // Before each primitive is submitted (also when no backend is given).
+        std::function<void(const GSPrimitiveBatch &)> onSubmit;
+        // After each Present, with the request and the frame the backend returned (null without a backend).
+        std::function<void(const GSPresentationRequest &, const PresentationFrame *)> onPresent;
+        // Stop after this many presentations (0: replay everything).
+        uint64_t maxPresents = 0;
+    };
+
+    struct ReplayCounts
+    {
+        uint64_t commands = 0;
+        uint64_t submits = 0;
+        uint64_t uploads = 0;
+        uint64_t uploadBytes = 0;
+        uint64_t presents = 0;
+        bool truncated = false; // the stream ended without an End record (the game was closed mid-capture)
+    };
+
+    // Sends the records to backend (which may be null: hooks only). The backend must already hold the
+    // capture's VRAM and CLUT state.
+    ReplayCounts Replay(const Capture &capture, GSRasterBackend *backend, const ReplayHooks &hooks = {});
+}
+
+class GSCaptureBackend final : public GSRasterBackend
+{
+public:
+    GSCaptureBackend(std::unique_ptr<GSRasterBackend> inner, GSCpuBackend *cpu, std::string path,
+                     uint64_t firstVblank, uint64_t presents);
+    ~GSCaptureBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void Kick() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    void begin(uint64_t vblank);
+    void finish();
+    void op(GSCapture::Op op) const;
+    void put(const void *data, size_t size) const;
+    template <typename T>
+    void putValue(const T &value) const { put(&value, sizeof(value)); }
+
+    std::unique_ptr<GSRasterBackend> m_inner;
+    GSCpuBackend *m_cpu = nullptr;
+    std::string m_path;
+    uint64_t m_firstVblank = 0;
+    uint64_t m_presents = 0;
+    // Calls come from the GS thread and, for the synchronous ones, from the caller once the queue is idle.
+    mutable std::recursive_mutex m_mutex;
+    mutable FILE *m_file = nullptr;
+    bool m_done = false;
+    uint64_t m_presentsWritten = 0;
+    uint64_t m_submits = 0;
+    uint64_t m_uploadBytes = 0;
+    GSDrawState m_lastState{};
+    bool m_haveState = false;
+    // The host-to-local transfer in progress: a capture that starts in its middle repeats it from the start
+    // (the bytes already in VRAM are written again with the same values).
+    GSTransferCommand m_transfer{};
+    bool m_transferOpen = false;
+    std::vector<uint8_t> m_transferBytes;
+};
+
+// The backend itself, or a GSCaptureBackend around it when PS2X_GS_CAPTURE is set.
+std::unique_ptr<GSRasterBackend> WrapGsCaptureIfRequested(std::unique_ptr<GSCpuBackend> backend);
