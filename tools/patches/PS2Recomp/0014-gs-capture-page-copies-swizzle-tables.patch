+            for (uint32_t page = 0; page < 512u; ++page)
+                if (pages.test(page))
+                    std::memcpy(snapshot.data() + page * 8192u, m_vram + page * 8192u, 8192u);
+        }
+    }
+
+    thread_local GSCpuBackend snapshotBackend(false);
     snapshotBackend.Initialize(snapshot.data(), static_cast<uint32_t>(snapshot.size()));
     return snapshotBackend.PresentFromLocalMemory(request);
 }
diff --git a/ps2xRuntime/src/lib/gs/gs_swizzle.cpp b/ps2xRuntime/src/lib/gs/gs_swizzle.cpp
new file mode 100644
index 0000000..acd8e41
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_swizzle.cpp
@@ -0,0 +1,143 @@
+#include "runtime/gs/gs_swizzle.h"
+#include "runtime/gs/gs_types.h"
+#include "runtime/gs/ps2_gs_memory.h"
+
+#include <array>
+#include <cstdio>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace GSSwizzle
+{
+    namespace
+    {
+        constexpr uint32_t kColumns = 2048u;
+
+        struct Tables
+        {
+            Format formats[64];
+            bool known[64] = {};
+            std::vector<std::unique_ptr<uint32_t[]>> storage;
+        };
+
+        Tables &tables()
+        {
+            static Tables instance;
+            static std::once_flag once;
+            std::call_once(once, []()
+                           {
+                               GSMem::InitLookupTables();
+                               struct Spec
+                               {
+                                   uint32_t psm, pageW, pageH, pixelsPerBlock;
+                               };
+                               const Spec specs[] = {
+                                   {GS_PSM_CT32, 64u, 32u, 64u}, {GS_PSM_Z32, 64u, 32u, 64u}, {GS_PSM_CT16, 64u, 64u, 128u},
+                                   {GS_PSM_CT16S, 64u, 64u, 128u}, {GS_PSM_Z16, 64u, 64u, 128u}, {GS_PSM_Z16S, 64u, 64u, 128u},
+                                   {GS_PSM_T8, 128u, 64u, 256u}, {GS_PSM_T4, 128u, 128u, 512u},
+                               };
+                               for (const Spec &spec : specs)
+                               {
+                                   Format f;
+                                   f.pageW = spec.pageW;
+                                   f.pageH = spec.pageH;
+                                   f.pixelsPerBlock = spec.pixelsPerBlock;
+                                   f.pixelsPerPage = spec.pixelsPerBlock * 32u;
+                                   // Inside the first page (bp 0): the row part is the address of column 0.
+                                   const uint32_t bw = spec.pageW / 64u;
+                                   auto at = [&](uint32_t x, uint32_t y)
+                                   { return GSMem::PixelAddress(spec.psm, 0u, bw, x, y); };
+                                   for (uint32_t y = 0; y < f.pageH; ++y)
+                                       f.rowIn[y] = at(0u, y);
+                                   // Smallest period of rows after which the column offsets repeat.
+                                   uint32_t period = f.pageH;
+                                   for (uint32_t candidate : {1u, 2u, 4u, 8u, 16u, 32u})
+                                   {
+                                       bool same = f.pageH % candidate == 0u;
+                                       for (uint32_t y = 0; y < f.pageH && same; ++y)
+                                           for (uint32_t x = 0; x < f.pageW && same; ++x)
+                                               same = at(x, y) - at(0u, y) == at(x, y % candidate) - at(0u, y % candidate);
+                                       if (same)
+                                       {
+                                           period = candidate;
+                                           break;
+                                       }
+                                   }
+                                   f.period = period;
+                                   f.periodMask = period - 1u;
+                                   f.pageHMask = f.pageH - 1u;
+                                   f.pageWShift = f.pageW == 128u ? 7u : 6u;
+                                   f.pageHShift = f.pageH == 128u ? 7u : (f.pageH == 64u ? 6u : 5u);
+                                   auto col = std::make_unique<uint32_t[]>(static_cast<size_t>(period) * kColumns);
+                                   for (uint32_t r = 0; r < period; ++r)
+                                       for (uint32_t x = 0; x < kColumns; ++x)
+                                           col[r * kColumns + x] = (x / f.pageW) * f.pixelsPerPage + at(x % f.pageW, r) - at(0u, r);
+                                   f.col = col.get();
+                                   instance.storage.push_back(std::move(col));
+                                   instance.formats[spec.psm] = f;
+                                   instance.known[spec.psm] = true;
+                               }
+                               // Formats that share a layout.
+                               auto alias = [&](uint32_t psm, uint32_t base)
+                               {
+                                   instance.formats[psm] = instance.formats[base];
+                                   instance.known[psm] = true;
+                               };
+                               alias(GS_PSM_CT24, GS_PSM_CT32);
+                               alias(GS_PSM_T8H, GS_PSM_CT32);
+                               alias(GS_PSM_T4HL, GS_PSM_CT32);
+                               alias(GS_PSM_T4HH, GS_PSM_CT32);
+                               alias(GS_PSM_Z24, GS_PSM_Z32); });
+            return instance;
+        }
+    }
+
+    const Format *Get(uint32_t psm)
+    {
+        Tables &t = tables();
+        psm &= 63u;
+        return t.known[psm] ? &t.formats[psm] : nullptr;
+    }
+
+    bool SelfTest(std::string &report)
+    {
+        const uint32_t formats[] = {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S, GS_PSM_T8, GS_PSM_T4, GS_PSM_T8H,
+                                    GS_PSM_T4HL, GS_PSM_T4HH, GS_PSM_Z32, GS_PSM_Z24, GS_PSM_Z16, GS_PSM_Z16S};
+        const uint32_t bases[] = {0u, 1u, 5u, 31u, 32u, 33u, 0x1234u, 0x3FE0u, 0x3FFFu};
+        uint64_t checks = 0;
+        for (uint32_t psm : formats)
+        {
+            const Format *f = Get(psm);
+            if (!f)
+            {
+                report = "no layout for psm " + std::to_string(psm);
+                return false;
+            }
+            for (uint32_t bw = 0; bw <= 32u; ++bw)
+                for (uint32_t bp : bases)
+                    for (uint32_t y = 0; y < 1024u; y += (y < 256u ? 1u : 7u))
+                        for (uint32_t x = 0; x < 2048u; x += (x < 256u ? 1u : 13u))
+                        {
+                            const uint32_t expected = GSMem::PixelAddress(psm, bp, bw, x, y);
+                            const uint32_t got = Address(*f, bp, bw, x, y);
+                            const uint32_t fast = AddressFast(*f, Base(*f, bp), RowStride(*f, bw), x, y);
+                            ++checks;
+                            if (expected != got || expected != fast)
+                            {
+                                char text[200];
+                                std::snprintf(text, sizeof(text), "psm %u bp %u bw %u (%u,%u): expected %u, got %u", psm, bp, bw,
+                                              x, y, expected, got);
+                                report = text;
+                                return false;
+                            }
+                        }
+        }
+        char text[160];
+        std::snprintf(text, sizeof(text), "%llu addresses match; periods CT32 %u CT16 %u T8 %u T4 %u Z32 %u Z16 %u",
+                      static_cast<unsigned long long>(checks), Get(GS_PSM_CT32)->period, Get(GS_PSM_CT16)->period,
+                      Get(GS_PSM_T8)->period, Get(GS_PSM_T4)->period, Get(GS_PSM_Z32)->period, Get(GS_PSM_Z16)->period);
+        report = text;
+        return true;
+    }
+}
