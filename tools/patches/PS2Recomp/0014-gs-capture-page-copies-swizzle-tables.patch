+#include "runtime/gs/gs_capture.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+
+namespace
+{
+    // Bytes a host-to-local transfer carries (rows of pixels; 4-bit formats pack two pixels per byte).
+    uint64_t transferBytes(const GSTransferCommand &command)
+    {
+        const uint64_t pixels = static_cast<uint64_t>(command.trxreg.rrw) * command.trxreg.rrh;
+        switch (command.bitbltbuf.dpsm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_Z32:
+            return pixels * 4u;
+        case GS_PSM_CT24:
+        case GS_PSM_Z24:
+            return pixels * 3u;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            return pixels * 2u;
+        case GS_PSM_T8:
+        case GS_PSM_T8H:
+            return pixels;
+        case GS_PSM_T4:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            return (pixels + 1u) / 2u;
+        default:
+            return 0u;
+        }
+    }
+}
+
+GSCaptureBackend::GSCaptureBackend(std::unique_ptr<GSRasterBackend> inner, GSCpuBackend *cpu, std::string path,
+                                   uint64_t firstVblank, uint64_t presents)
+    : m_inner(std::move(inner)), m_cpu(cpu), m_path(std::move(path)), m_firstVblank(firstVblank),
+      m_presents(presents == 0u ? 1u : presents)
+{
+    std::cout << "[gs-capture] will record " << m_presents << " presentations from VBlank " << m_firstVblank
+              << " to " << m_path << std::endl;
+}
+
+GSCaptureBackend::~GSCaptureBackend()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+        finish();
+}
+
+void GSCaptureBackend::put(const void *data, size_t size) const
+{
+    if (m_file && size != 0u)
+        std::fwrite(data, 1u, size, m_file);
+}
+
+void GSCaptureBackend::op(GSCapture::Op value) const
+{
+    putValue(static_cast<uint8_t>(value));
+}
+
+void GSCaptureBackend::begin(uint64_t vblank)
+{
+    std::vector<uint8_t> vram;
+    m_inner->SnapshotVram(vram);
+    const GSCpuBackend::ClutState clut = m_cpu ? m_cpu->GetClutState() : GSCpuBackend::ClutState{};
+    m_file = std::fopen(m_path.c_str(), "wb");
+    if (!m_file)
+    {
+        std::cout << "[gs-capture] cannot write " << m_path << std::endl;
+        m_done = true;
+        return;
+    }
+    std::setvbuf(m_file, nullptr, _IOFBF, 8u << 20u);
+    GSCapture::Header header;
+    header.vramSize = static_cast<uint32_t>(vram.size());
+    header.firstVblank = static_cast<uint32_t>(vblank);
+    putValue(header);
+    put(vram.data(), vram.size());
+    putValue(clut);
+    // A transfer still waiting for data: repeat what it has received so far.
+    if (m_transferOpen && m_transfer.direction == 0u && m_transferBytes.size() < transferBytes(m_transfer))
+    {
+        op(GSCapture::Op::BeginTransfer);
+        putValue(m_transfer);
+        if (!m_transferBytes.empty())
+        {
+            op(GSCapture::Op::UploadImage);
+            putValue(static_cast<uint32_t>(m_transferBytes.size()));
+            put(m_transferBytes.data(), m_transferBytes.size());
+        }
+    }
+    m_haveState = false;
+    std::cout << "[gs-capture] started at VBlank " << vblank << std::endl;
+}
+
+void GSCaptureBackend::finish()
+{
+    op(GSCapture::Op::End);
+    std::fclose(m_file);
+    m_file = nullptr;
+    m_done = true;
+    std::cout << "[gs-capture] wrote " << m_presentsWritten << " presentations, " << m_submits << " primitives, "
+              << m_uploadBytes << " upload bytes to " << m_path << std::endl;
+}
+
+void GSCaptureBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    m_inner->Initialize(vram, vramSize);
+}
+
+void GSCaptureBackend::Reset()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    op(GSCapture::Op::Reset);
+    m_transferOpen = false;
+    m_inner->Reset();
+}
+
+void GSCaptureBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        const uint8_t count = std::min<uint8_t>(batch.vertexCount, 3u);
+        const bool newState = !m_haveState || std::memcmp(&m_lastState, &batch.state, sizeof(GSDrawState)) != 0;
+        op(GSCapture::Op::Submit);
+        putValue(count);
+        putValue(static_cast<uint8_t>(newState ? 1u : 0u));
+        put(batch.vertices.data(), sizeof(GSVertex) * count);
+        if (newState)
+        {
+            putValue(batch.state);
+            m_lastState = batch.state;
+            m_haveState = true;
+        }
+        ++m_submits;
+    }
+    m_inner->Submit(batch);
+}
+
+void GSCaptureBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::LoadClut);
+        putValue(tex0);
+        putValue(texclut);
+    }
+    m_inner->LoadClut(tex0, texclut);
+}
+
+void GSCaptureBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::BeginTransfer);
+        putValue(command);
+    }
+    m_transfer = command;
+    m_transferOpen = true;
+    m_transferBytes.clear();
+    m_inner->BeginTransfer(command);
+}
+
+void GSCaptureBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::UploadImage);
+        putValue(sizeBytes);
+        put(data, sizeBytes);
+        m_uploadBytes += sizeBytes;
+    }
+    else if (!m_done && m_transferOpen && data && m_transferBytes.size() < transferBytes(m_transfer))
+        m_transferBytes.insert(m_transferBytes.end(), data, data + sizeBytes);
+    m_inner->UploadImage(data, sizeBytes);
+}
+
+void GSCaptureBackend::Flush()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    op(GSCapture::Op::Flush);
+    m_inner->Flush();
+}
+
+void GSCaptureBackend::Kick()
+{
+    m_inner->Kick();
+}
+
+void GSCaptureBackend::TextureFlush()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    op(GSCapture::Op::TextureFlush);
+    m_inner->TextureFlush();
+}
+
+void GSCaptureBackend::Sync(GSSyncReason reason)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::Sync);
+        putValue(static_cast<uint8_t>(reason));
+    }
+    m_inner->Sync(reason);
+}
+
+PresentationFrame GSCaptureBackend::Present(const GSPresentationRequest &request)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::Present);
+        putValue(request);
+    }
+    PresentationFrame frame = m_inner->Present(request);
+    if (m_file)
+    {
+        if (++m_presentsWritten >= m_presents)
+            finish();
+    }
+    else if (!m_done && request.vsyncTick >= m_firstVblank)
+        begin(request.vsyncTick);
+    return frame;
+}
+
+bool GSCaptureBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::ClearFramebuffer);
+        putValue(context);
+        putValue(rgba);
+    }
+    return m_inner->ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSCaptureBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::ConsumeLocalToHost);
+        putValue(maxBytes);
+    }
+    return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSCaptureBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    op(GSCapture::Op::Readback);
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSCaptureBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (m_file)
+    {
+        op(GSCapture::Op::WriteVram);
+        const uint32_t args[6] = {psm, base, bw, x, y, value};
+        put(args, sizeof(args));
+    }
+    m_inner->WriteVram(psm, base, bw, x, y, value);
+}
+
+void GSCaptureBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    op(GSCapture::Op::Readback);
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSCaptureBackend::GetTransferSnapshot() const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    op(GSCapture::Op::Readback);
+    return m_inner->GetTransferSnapshot();
+}
+
+std::unique_ptr<GSRasterBackend> WrapGsCaptureIfRequested(std::unique_ptr<GSCpuBackend> backend)
+{
+    const char *env = std::getenv("PS2X_GS_CAPTURE");
+    if (!env || !env[0])
+        return backend;
+    std::string spec(env);
+    std::string path = spec;
+    uint64_t firstVblank = 4000u;
+    uint64_t presents = 100u;
+    const size_t comma = spec.find(',');
+    if (comma != std::string::npos)
+    {
+        path = spec.substr(0, comma);
+        const std::string rest = spec.substr(comma + 1u);
+        firstVblank = std::strtoull(rest.c_str(), nullptr, 10);
+        const size_t comma2 = rest.find(',');
+        if (comma2 != std::string::npos)
+            presents = std::strtoull(rest.c_str() + comma2 + 1u, nullptr, 10);
+    }
+    GSCpuBackend *cpu = backend.get();
+    return std::make_unique<GSCaptureBackend>(std::move(backend), cpu, path, firstVblank, presents);
+}
+
+namespace GSCapture
+{
+    bool Load(const std::string &path, Capture &capture, std::string &error)
+    {
+        FILE *file = std::fopen(path.c_str(), "rb");
+        if (!file)
+        {
+            error = "cannot open " + path;
+            return false;
+        }
+        bool ok = std::fread(&capture.header, sizeof(Header), 1u, file) == 1u;
+        const Header expected;
+        if (!ok || std::memcmp(capture.header.magic, expected.magic, sizeof(expected.magic)) != 0)
+        {
+            std::fclose(file);
+            error = "not a GS capture";
+            return false;
+        }
+        if (capture.header.vertexSize != expected.vertexSize || capture.header.drawStateSize != expected.drawStateSize ||
+            capture.header.transferSize != expected.transferSize || capture.header.presentSize != expected.presentSize ||
+            capture.header.contextSize != expected.contextSize || capture.header.clutStateSize != expected.clutStateSize)
+        {
+            std::fclose(file);
+            error = "capture from a build with other GS structures";
+            return false;
+        }
+        capture.vram.resize(capture.header.vramSize);
+        ok = std::fread(capture.vram.data(), 1u, capture.vram.size(), file) == capture.vram.size() &&
+             std::fread(&capture.clut, sizeof(capture.clut), 1u, file) == 1u;
+        if (!ok)
+        {
+            std::fclose(file);
+            error = "truncated header";
+            return false;
+        }
+        const long start = std::ftell(file);
+        std::fseek(file, 0, SEEK_END);
+        const long end = std::ftell(file);
+        std::fseek(file, start, SEEK_SET);
+        capture.stream.resize(static_cast<size_t>(end - start));
+        ok = std::fread(capture.stream.data(), 1u, capture.stream.size(), file) == capture.stream.size();
+        std::fclose(file);
+        if (!ok)
+            error = "read error";
+        return ok;
+    }
+
+    ReplayCounts Replay(const Capture &capture, GSRasterBackend *backend, const ReplayHooks &hooks)
+    {
+        ReplayCounts counts;
+        const uint8_t *p = capture.stream.data();
+        const uint8_t *end = p + capture.stream.size();
+        auto take = [&](void *out, size_t size) -> bool
+        {
+            if (static_cast<size_t>(end - p) < size)
+            {
+                p = end;
+                return false;
+            }
+            std::memcpy(out, p, size);
+            p += size;
+            return true;
+        };
+        GSPrimitiveBatch batch{};
+        std::vector<uint8_t> scratch;
+        for (;;)
+        {
+            uint8_t opByte = 0;
+            if (!take(&opByte, 1u))
+            {
+                counts.truncated = true;
+                return counts;
+            }
+            ++counts.commands;
+            switch (static_cast<Op>(opByte))
+            {
+            case Op::Submit:
+            {
+                uint8_t count = 0, hasState = 0;
+                if (!take(&count, 1u) || !take(&hasState, 1u) || count > 3u ||
+                    !take(batch.vertices.data(), sizeof(GSVertex) * count) ||
+                    (hasState && !take(&batch.state, sizeof(GSDrawState))))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                batch.vertexCount = count;
+                ++counts.submits;
+                if (hooks.onSubmit)
+                    hooks.onSubmit(batch);
+                if (backend)
+                    backend->Submit(batch);
+                break;
+            }
+            case Op::LoadClut:
+            {
+                GSTex0Reg tex0{};
+                GSTexClutReg texclut{};
+                if (!take(&tex0, sizeof(tex0)) || !take(&texclut, sizeof(texclut)))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                if (backend)
+                    backend->LoadClut(tex0, texclut);
+                break;
+            }
+            case Op::BeginTransfer:
+            {
+                GSTransferCommand command{};
+                if (!take(&command, sizeof(command)))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                if (backend)
+                    backend->BeginTransfer(command);
+                break;
+            }
+            case Op::UploadImage:
+            {
+                uint32_t size = 0;
+                if (!take(&size, sizeof(size)) || static_cast<size_t>(end - p) < size)
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                ++counts.uploads;
+                counts.uploadBytes += size;
+                if (backend)
+                    backend->UploadImage(p, size);
+                p += size;
+                break;
+            }
+            case Op::Flush:
+                if (backend)
+                    backend->Flush();
+                break;
+            case Op::TextureFlush:
+                if (backend)
+                    backend->TextureFlush();
+                break;
+            case Op::Sync:
+            {
+                uint8_t reason = 0;
+                if (!take(&reason, 1u))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                if (backend)
+                    backend->Sync(static_cast<GSSyncReason>(reason));
+                break;
+            }
+            case Op::Present:
+            {
+                GSPresentationRequest request{};
+                if (!take(&request, sizeof(request)))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                ++counts.presents;
+                PresentationFrame frame;
+                if (backend)
+                    frame = backend->Present(request);
+                if (hooks.onPresent)
+                    hooks.onPresent(request, backend ? &frame : nullptr);
+                if (hooks.maxPresents != 0u && counts.presents >= hooks.maxPresents)
+                    return counts;
+                break;
+            }
+            case Op::ClearFramebuffer:
+            {
+                GSContext context{};
+                uint32_t rgba = 0;
+                if (!take(&context, sizeof(context)) || !take(&rgba, sizeof(rgba)))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                if (backend)
+                    backend->ClearFramebuffer(context, rgba);
+                break;
+            }
+            case Op::WriteVram:
+            {
+                uint32_t args[6] = {};
+                if (!take(args, sizeof(args)))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                if (backend)
+                    backend->WriteVram(args[0], args[1], args[2], args[3], args[4], args[5]);
+                break;
+            }
+            case Op::ConsumeLocalToHost:
+            {
+                uint32_t maxBytes = 0;
+                if (!take(&maxBytes, sizeof(maxBytes)))
+                {
+                    counts.truncated = true;
+                    return counts;
+                }
+                scratch.resize(maxBytes);
+                if (backend)
+                    backend->ConsumeLocalToHostBytes(scratch.data(), maxBytes);
+                break;
+            }
+            case Op::Readback:
+                if (backend)
+                    backend->Sync(GSSyncReason::DebugReadback);
+                break;
+            case Op::Reset:
+                if (backend)
+                    backend->Reset();
+                break;
+            case Op::End:
+                return counts;
+            default:
+                counts.truncated = true;
+                return counts;
+            }
+        }
+    }
+}
