+void EeScheduler::catchUpToHostClock() noexcept
+{
+    const auto now = std::chrono::steady_clock::now();
+    if (now <= m_hostAnchor)
+    {
+        return;
+    }
+    constexpr uint64_t kNanosecondsPerSecond = 1000000000ull;
+    const uint64_t hostNs = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(now - m_hostAnchor).count());
+    const uint64_t target = m_cycleAnchor + hostNs / kNanosecondsPerSecond * kEeClockHz +
+                            hostNs % kNanosecondsPerSecond * kEeClockHz / kNanosecondsPerSecond;
+    if (target <= m_eeCycle + kRealtimeSlackCycles)
+    {
+        return;
+    }
+
+    uint64_t jump = target - m_eeCycle;
+    if (jump > kRealtimeMaxJumpCycles)
+    {
+        // Forget the rest of the stall: the host side of the clock and of every pending deadline moves
+        // forward by it, so the VBlanks after it are paced from now instead of all being overdue.
+        const auto forgotten = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+            eeCyclesToHostDuration(jump - kRealtimeMaxJumpCycles));
+        m_hostAnchor += forgotten;
+        {
+            std::lock_guard lock(m_eventMutex);
+            for (ScheduledEvent &item : m_deadlines)
+            {
+                item.hostDeadline += forgotten;
+            }
+        }
+        jump = kRealtimeMaxJumpCycles;
+    }
+    {
+        // Deferred invocations (no-wait RPC end functions) stand for EE code that must run first, not for
+        // hardware time: EA's ClSound::tick reads the reply sequence after FlushIOPCommand returns, and an
+        // end function that ran inside tick because of a jump stalled the stream handshake (the bard
+        // preload then waited forever on "CARGANDO..."). They keep their distance in executed cycles.
+        std::lock_guard lock(m_eventMutex);
+        for (ScheduledEvent &item : m_deadlines)
+        {
+            if (item.event.type == EeEventType::DeferredInvocation)
+            {
+                item.deadlineCycle += jump;
+            }
+        }
+        updateNextDeadline();
+    }
+    m_eeCycle += jump;
+    m_deviceCyclesPending += jump;
+    m_realtimeSkipped.fetch_add(jump, std::memory_order_relaxed);
+}
+
+std::chrono::steady_clock::time_point EeScheduler::hostDeadlineFor(uint64_t deadlineCycle, std::chrono::nanoseconds delay) const
+{
+    const auto fromNow = std::chrono::steady_clock::now() + delay;
+    if (!m_realtime || deadlineCycle < m_cycleAnchor)
+    {
+        return fromNow;
+    }
+    const auto anchored = m_hostAnchor + std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                                             eeCyclesToHostDuration(deadlineCycle - m_cycleAnchor));
+    return std::min(fromNow, anchored);
+}
