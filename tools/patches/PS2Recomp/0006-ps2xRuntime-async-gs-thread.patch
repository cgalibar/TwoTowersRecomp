+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// Runs another raster backend on its own thread, so drawing overlaps with the EE. Drawing commands
+// (primitives, CLUT loads, transfers, image uploads, texture flushes) are queued in order and return at
+// once. Calls that return data or need the drawn VRAM (Present, VRAM reads and writes, local-to-host
+// transfers, every Sync except FINISH) first wait until the thread has executed everything queued before.
+class GSAsyncBackend final : public GSRasterBackend
+{
+public:
+    explicit GSAsyncBackend(std::unique_ptr<GSRasterBackend> inner);
+    ~GSAsyncBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    enum class CommandType : uint8_t
+    {
+        Submit,
+        LoadClut,
+        BeginTransfer,
+        UploadImage,
+        Flush,
+        TextureFlush,
+        Stop,
+    };
+
+    struct Command
+    {
+        CommandType type = CommandType::Submit;
+        GSPrimitiveBatch batch{};
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        GSTransferCommand transfer{};
+        std::vector<uint8_t> data;
+    };
+
+    static constexpr uint64_t kCapacity = 1024u;
+
+    template <typename Fill>
+    void push(Fill &&fill);
+    void waitForExecuted(uint64_t count) const;
+    void waitIdle() const;
+    void run();
+    void execute(Command &command);
+
+    std::unique_ptr<GSRasterBackend> m_inner;
+    std::vector<Command> m_ring;
+    std::mutex m_producerMutex;
+    std::atomic<uint64_t> m_queued{0};
+    std::atomic<uint64_t> m_executed{0};
+    mutable std::atomic<uint32_t> m_executedWaiters{0};
+    std::atomic<bool> m_threadSleeping{false};
+    std::thread m_thread;
+};
+
+// GSCpuBackend, on its own GS thread unless PS2X_GS_ASYNC=0.
+std::unique_ptr<GSRasterBackend> CreateDefaultGsBackend();
diff --git a/ps2xRuntime/src/lib/gs/gs_async_backend.cpp b/ps2xRuntime/src/lib/gs/gs_async_backend.cpp
new file mode 100644
index 0000000..a26fe0f
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_async_backend.cpp
@@ -0,0 +1,254 @@
+#include "runtime/gs/gs_async_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <cstdlib>
+#include <cstring>
+#if defined(_M_X64) || defined(__x86_64__)
+#include <immintrin.h>
+#endif
+
+namespace
+{
+    // Roughly 50 us of spinning before a thread sleeps: commands come in bursts.
+    constexpr uint32_t kSpinIterations = 4096u;
+
+    void cpuRelax()
+    {
+#if defined(_M_X64) || defined(__x86_64__)
+        _mm_pause();
+#else
+        std::this_thread::yield();
+#endif
+    }
+}
+
+template <typename Fill>
+void GSAsyncBackend::push(Fill &&fill)
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    const uint64_t queued = m_queued.load(std::memory_order_relaxed);
+    if (queued >= kCapacity)
+        waitForExecuted(queued - kCapacity + 1u);
+    fill(m_ring[queued % kCapacity]);
+    // seq_cst pairs with the GS thread's m_threadSleeping store and m_queued check before it sleeps.
+    m_queued.store(queued + 1u, std::memory_order_seq_cst);
+    if (m_threadSleeping.load(std::memory_order_seq_cst))
+        m_queued.notify_one();
+}
+
+GSAsyncBackend::GSAsyncBackend(std::unique_ptr<GSRasterBackend> inner)
+    : m_inner(std::move(inner)), m_ring(kCapacity)
+{
+    m_thread = std::thread([this]()
+                           { run(); });
+}
+
+GSAsyncBackend::~GSAsyncBackend()
+{
+    push([](Command &command)
+         { command.type = CommandType::Stop; });
+    m_thread.join();
+}
+
+void GSAsyncBackend::waitForExecuted(uint64_t count) const
+{
+    uint64_t executed = m_executed.load(std::memory_order_acquire);
+    for (uint32_t spin = 0u; executed < count && spin < kSpinIterations; ++spin)
+    {
+        cpuRelax();
+        executed = m_executed.load(std::memory_order_acquire);
+    }
+    if (executed >= count)
+        return;
+
+    // seq_cst pairs with the GS thread's m_executed store and m_executedWaiters check.
+    m_executedWaiters.fetch_add(1u, std::memory_order_seq_cst);
+    while ((executed = m_executed.load(std::memory_order_seq_cst)) < count)
+        m_executed.wait(executed, std::memory_order_acquire);
+    m_executedWaiters.fetch_sub(1u, std::memory_order_seq_cst);
+}
+
+void GSAsyncBackend::waitIdle() const
+{
+    waitForExecuted(m_queued.load(std::memory_order_acquire));
+}
+
+void GSAsyncBackend::run()
+{
+    uint64_t executed = m_executed.load(std::memory_order_relaxed);
+    for (;;)
+    {
+        uint64_t queued = m_queued.load(std::memory_order_acquire);
+        for (uint32_t spin = 0u; queued == executed && spin < kSpinIterations; ++spin)
+        {
+            cpuRelax();
+            queued = m_queued.load(std::memory_order_acquire);
+        }
+        if (queued == executed)
+        {
+            m_threadSleeping.store(true, std::memory_order_seq_cst);
+            if (m_queued.load(std::memory_order_seq_cst) == executed)
+                m_queued.wait(executed, std::memory_order_acquire);
+            m_threadSleeping.store(false, std::memory_order_relaxed);
+            continue;
+        }
+
+        while (executed != queued)
+        {
+            Command &command = m_ring[executed % kCapacity];
+            const bool stop = command.type == CommandType::Stop;
+            if (!stop)
+                execute(command);
+            m_executed.store(++executed, std::memory_order_seq_cst);
+            if (m_executedWaiters.load(std::memory_order_seq_cst) != 0u)
+                m_executed.notify_all();
+            if (stop)
+                return;
+        }
+    }
+}
+
+void GSAsyncBackend::execute(Command &command)
+{
+    switch (command.type)
+    {
+    case CommandType::Submit:
+        m_inner->Submit(command.batch);
+        break;
+    case CommandType::LoadClut:
+        m_inner->LoadClut(command.tex0, command.texclut);
+        break;
+    case CommandType::BeginTransfer:
+        m_inner->BeginTransfer(command.transfer);
+        break;
+    case CommandType::UploadImage:
+        m_inner->UploadImage(command.data.data(), static_cast<uint32_t>(command.data.size()));
+        break;
+    case CommandType::Flush:
+        m_inner->Flush();
+        break;
+    case CommandType::TextureFlush:
+        m_inner->TextureFlush();
+        break;
+    case CommandType::Stop:
+        break;
+    }
+}
+
+void GSAsyncBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    waitIdle();
+    m_inner->Initialize(vram, vramSize);
+}
+
+void GSAsyncBackend::Reset()
+{
+    waitIdle();
+    m_inner->Reset();
+}
+
+void GSAsyncBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    push([&](Command &command)
+         {
+             command.type = CommandType::Submit;
+             command.batch = batch; });
+}
+
+void GSAsyncBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    push([&](Command &command)
+         {
+             command.type = CommandType::LoadClut;
+             command.tex0 = tex0;
+             command.texclut = texclut; });
+}
+
+void GSAsyncBackend::BeginTransfer(const GSTransferCommand &transfer)
+{
+    push([&](Command &command)
+         {
+             command.type = CommandType::BeginTransfer;
+             command.transfer = transfer; });
+}
+
+void GSAsyncBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    push([&](Command &command)
+         {
+             command.type = CommandType::UploadImage;
+             command.data.assign(data, data + sizeBytes); });
+}
+
+void GSAsyncBackend::Flush()
+{
+    push([](Command &command)
+         { command.type = CommandType::Flush; });
+}
+
+void GSAsyncBackend::TextureFlush()
+{
+    push([](Command &command)
+         { command.type = CommandType::TextureFlush; });
+}
+
+void GSAsyncBackend::Sync(GSSyncReason reason)
+{
+    // FINISH only orders the GS against later commands, which the queue already does; the frontend raises
+    // the FINISH event itself.
+    if (reason == GSSyncReason::Finish)
+        return;
+    waitIdle();
+    m_inner->Sync(reason);
+}
+
+PresentationFrame GSAsyncBackend::Present(const GSPresentationRequest &request)
+{
+    waitIdle();
+    return m_inner->Present(request);
+}
+
+bool GSAsyncBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    waitIdle();
+    return m_inner->ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSAsyncBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    waitIdle();
+    return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSAsyncBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    waitIdle();
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSAsyncBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    waitIdle();
+    m_inner->WriteVram(psm, base, bw, x, y, value);
+}
+
+void GSAsyncBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    waitIdle();
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSAsyncBackend::GetTransferSnapshot() const
+{
+    waitIdle();
+    return m_inner->GetTransferSnapshot();
+}
+
+std::unique_ptr<GSRasterBackend> CreateDefaultGsBackend()
+{
+    auto backend = std::make_unique<GSCpuBackend>();
+    const char *async = std::getenv("PS2X_GS_ASYNC");
+    if (async && std::strcmp(async, "0") == 0)
+        return backend;
+    return std::make_unique<GSAsyncBackend>(std::move(backend));
+}
